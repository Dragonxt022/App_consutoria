NODE_ENV=production
PORT=3000
APP_URL=https://app.seudominio.com

# Reverse proxy / session
TRUST_PROXY=1
SESSION_SECRET=troque-por-um-segredo-forte
SESSION_COOKIE_NAME=consultoria.sid
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_MS=604800000

# JWT
JWT_SECRET=troque-por-um-jwt-seguro
JWT_EXPIRE=7d

# Database
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_consultoria
DB_USER=app_consultoria
DB_PASSWORD=troque-por-uma-senha-forte
DB_LOGGING=0
DB_SYNC_ALTER=0
DB_SYNC_FORCE=0

# SQLite local example
# DB_DIALECT=sqlite
# DB_STORAGE=./database.sqlite
