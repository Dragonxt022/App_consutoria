<%- include('./_hub-nav') %>

<div class="mx-auto w-full max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <section class="rounded-[2rem] border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-5 py-6 md:px-6">
            <a href="/meus-arquivos" class="inline-flex items-center text-sm font-bold text-indigo-600 transition hover:text-indigo-700">
                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Voltar para arquivos recebidos
            </a>

            <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div class="max-w-2xl">
                    <p class="text-[10px] font-black uppercase tracking-[0.24em] text-slate-400">Detalhes do anexo</p>
                    <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl"><%= attachment.title %></h2>
                    <p class="mt-3 text-sm leading-6 text-slate-500"><%= attachment.description || 'Arquivo disponibilizado para consulta e download.' %></p>
                </div>
                <div class="inline-flex w-fit items-center rounded-full bg-slate-100 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-slate-500">
                    <%= attachment.fileCountLabel %>
                </div>
            </div>
        </div>

        <div class="grid gap-4 p-4 sm:p-5 md:grid-cols-2 md:p-6">
            <div class="rounded-2xl bg-slate-50 p-5">
                <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Pacote</p>
                <p class="mt-2 text-sm font-semibold text-slate-900"><%= attachment.fileCountLabel %></p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-5">
                <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Volume total</p>
                <p class="mt-2 text-sm font-semibold text-slate-900"><%= attachment.fileSizeLabel %></p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-5">
                <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Disponibilizado em</p>
                <p class="mt-2 text-sm font-semibold text-slate-900"><%= new Date(attachment.createdAt).toLocaleDateString('pt-BR') %></p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-5">
                <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Origem</p>
                <p class="mt-2 text-sm font-semibold text-slate-900"><%= attachment.audienceLabel %></p>
            </div>
            <% if (attachment.courseContext) { %>
                <div class="rounded-2xl bg-slate-50 p-5 md:col-span-2">
                    <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Contexto do curso</p>
                    <div class="mt-3 grid gap-3 md:grid-cols-2">
                        <div>
                            <p class="text-sm text-slate-500">Curso</p>
                            <p class="mt-1 font-semibold text-slate-900"><%= attachment.courseContext.courseTitle %></p>
                        </div>
                        <div>
                            <p class="text-sm text-slate-500">Status exigido</p>
                            <p class="mt-1 font-semibold text-slate-900"><%= attachment.requiredEnrollmentStatusLabel %></p>
                        </div>
                    </div>
                </div>
            <% } %>
            <div class="rounded-2xl bg-slate-50 p-5 md:col-span-2">
                <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Arquivos disponíveis</p>
                <div class="mt-4 space-y-3">
                    <% attachment.files.forEach((file, index) => { %>
                        <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 md:flex-row md:items-center md:justify-between">
                            <div class="min-w-0">
                                <p class="text-sm font-black text-slate-900"><%= file.originalName %></p>
                                <p class="mt-1 text-xs uppercase tracking-[0.16em] text-slate-400">Arquivo <%= index + 1 %> • <%= file.fileSizeLabel %></p>
                            </div>
                            <a href="<%= file.fileUrl %>" download class="inline-flex w-full items-center justify-center rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-black text-white transition hover:bg-indigo-700 md:w-auto">
                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                Baixar
                            </a>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>
</div>
