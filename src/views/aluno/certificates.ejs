<%- include('./_hub-nav') %>

<div class="mx-auto w-full max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-xl">
        <div class="flex flex-col gap-3 border-b border-slate-50 bg-slate-50/50 p-5 sm:flex-row sm:items-center sm:justify-between md:p-6">
            <h3 class="flex items-center text-lg font-black uppercase tracking-tighter text-slate-800 md:text-xl">
                <svg class="w-5 h-5 mr-2 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Certificados Disponíveis
            </h3>
            <span class="inline-flex w-fit rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500">
                <%= certificates.length %> certificado(s)
            </span>
        </div>

        <% if (!certificates.length) { %>
            <div class="p-8 md:p-12 text-center">
                <div class="bg-slate-50 w-16 h-16 md:w-20 md:h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 md:w-10 md:h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <h4 class="text-slate-400 font-bold">Você ainda não possui certificados liberados.</h4>
                <p class="text-slate-400 text-sm mt-1">Quando um curso for concluído, o certificado aparecerá aqui automaticamente.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 gap-4 p-4 sm:gap-5 sm:p-5 md:grid-cols-2 md:p-6 xl:grid-cols-3">
                <% certificates.forEach((enroll) => { %>
                    <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 hover:shadow-md transition-shadow">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-black uppercase tracking-widest text-emerald-600">Curso concluído</p>
                                <h4 class="mt-3 text-lg font-bold text-slate-900 leading-snug"><%= enroll.Course ? enroll.Course.title : 'Curso indisponível' %></h4>
                            </div>
                            <div class="bg-emerald-100 text-emerald-700 rounded-xl p-3">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>

                        <div class="mt-4 text-sm text-slate-500 space-y-2">
                            <p><span class="font-semibold text-slate-700">Local:</span> <%= enroll.Course ? enroll.Course.location : '--' %></p>
                            <p><span class="font-semibold text-slate-700">Carga horária:</span> <%= enroll.Course ? enroll.Course.workload : '--' %></p>
                            <p><span class="font-semibold text-slate-700">Código:</span> <%= enroll.certificateCode || 'Será gerado ao abrir' %></p>
                        </div>

                        <div class="mt-5 grid gap-2 sm:grid-cols-2">
                            <a href="/meu-certificado/<%= enroll.id %>" target="_blank" class="flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-3 text-center text-xs font-bold text-white shadow-lg shadow-emerald-100 transition-all hover:bg-emerald-700">
                                Abrir Certificado
                            </a>
                            <a href="/meu-comprovante/<%= enroll.id %>" target="_blank" class="flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-3 text-xs font-bold text-slate-700 transition-all hover:bg-slate-100">
                                Comprovante
                            </a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>
