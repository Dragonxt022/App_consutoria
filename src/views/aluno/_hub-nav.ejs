<div class="border-b border-slate-200 bg-white/90 backdrop-blur-sm">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-5 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-[10px] font-black uppercase tracking-[0.26em] text-emerald-600">Área do aluno</p>
                <h1 class="mt-2 text-[1.85rem] font-black tracking-tight text-slate-950 sm:text-3xl"><%= title || 'Minha Área' %></h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 sm:text-base">
                    Navegue entre seus cursos, certificados e perfil sem sair do ambiente principal do site.
                </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2 lg:flex lg:flex-wrap lg:items-center">
                <a href="/cursos" class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 lg:w-auto">
                    Explorar cursos
                </a>
                <a href="/contato" class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 lg:w-auto">
                    Falar com suporte
                </a>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-2">
            <a href="/aluno/dashboard" class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-2.5 text-sm font-bold transition <%= currentStudentSection === 'dashboard' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
                Painel
            </a>
            <a href="/meus-cursos" class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-2.5 text-sm font-bold transition <%= currentStudentSection === 'courses' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
                Meus cursos
            </a>
            <a href="/meus-certificados" class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-2.5 text-sm font-bold transition <%= currentStudentSection === 'certificates' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
                Certificados
            </a>
            <a href="/meus-arquivos" class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-2.5 text-sm font-bold transition <%= currentStudentSection === 'attachments' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
                Arquivos recebidos
            </a>
            <a href="/perfil" class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-2.5 text-sm font-bold transition <%= currentStudentSection === 'profile' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
                Meu perfil
            </a>
        </div>
    </div>
</div>
