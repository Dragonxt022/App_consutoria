<%- include('./_hub-nav') %>

<div class="mx-auto w-full max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100">
            <div class="p-5 md:p-6 border-b border-slate-50 bg-slate-50/50">
                <h3 class="font-black text-slate-800 uppercase tracking-tighter flex items-center text-lg md:text-xl">
                    <svg class="w-5 h-5 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    Foto de Perfil
                </h3>
            </div>

            <form action="/perfil/atualizar" method="POST" enctype="multipart/form-data" class="p-5 md:p-6 space-y-5">
                <div class="flex flex-col items-center text-center">
                    <% if (user.avatar) { %>
                        <img src="<%= user.avatar %>" alt="<%= user.name %>" class="h-24 w-24 rounded-full object-cover border-4 border-slate-100 shadow-sm">
                    <% } else { %>
                        <div class="h-24 w-24 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-3xl font-black border-4 border-slate-100 shadow-sm">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                    <p class="mt-4 text-sm font-semibold text-slate-700"><%= user.name %></p>
                    <p class="text-xs text-slate-500">JPG, PNG, WEBP ou GIF com até 8MB.</p>
                </div>

                <input type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif" required class="w-full text-xs text-slate-500 file:mr-4 file:rounded-full file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100">

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl text-sm font-bold shadow-lg shadow-indigo-100 transition-all">
                    Salvar Nova Foto
                </button>
            </form>
        </div>

        <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100">
            <div class="p-5 md:p-6 border-b border-slate-50 bg-slate-50/50">
                <h3 class="font-black text-slate-800 uppercase tracking-tighter flex items-center text-lg md:text-xl">
                    <svg class="w-5 h-5 mr-2 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8"></path>
                    </svg>
                    Alterar Senha
                </h3>
            </div>

            <form action="/perfil/alterar-senha" method="POST" class="p-5 md:p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Senha Atual</label>
                    <input type="password" name="currentPassword" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Nova Senha</label>
                    <input type="password" name="newPassword" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Confirmar Nova Senha</label>
                    <input type="password" name="confirmPassword" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>

                <div class="text-xs text-slate-500 bg-slate-50 rounded-xl p-4">
                    Use uma senha com pelo menos 6 caracteres para manter seu acesso protegido.
                </div>

                <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white px-6 py-3 rounded-xl text-sm font-bold transition-all">
                    Atualizar Senha
                </button>
            </form>
        </div>
    </div>
</div>
