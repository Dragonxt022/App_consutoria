<%- include('./_hub-nav') %>

<div class="mx-auto w-full max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100">
        <div class="p-5 md:p-6 border-b border-slate-50 flex justify-between items-center bg-slate-50/50">
            <h3 class="font-black text-slate-800 uppercase tracking-tighter flex items-center text-lg md:text-xl">
                <svg class="w-5 h-5 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                Minhas Trilhas de Conhecimento
            </h3>
            <span class="text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
                <%= enrollments.length %> curso(s)
            </span>
        </div>

        <div class="divide-y divide-slate-100">
            <% if (enrollments.length === 0) { %>
                <div class="p-8 md:p-12 text-center">
                    <div class="bg-slate-50 w-16 h-16 md:w-20 md:h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 md:w-10 md:h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                    </div>
                    <h4 class="text-slate-400 font-bold">Você ainda não se inscreveu em nenhum curso.</h4>
                    <p class="text-slate-400 text-sm mt-1">Navegue pelo site e encontre o treinamento ideal para você!</p>
                    <a href="/cursos" class="inline-block mt-6 bg-indigo-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-indigo-700 transition-colors">
                        Explorar Cursos
                    </a>
                </div>
            <% } else { %>
                <% enrollments.forEach((enroll) => { %>
                    <div class="p-5 md:p-6 hover:bg-slate-50/80 transition-all">
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 md:gap-6">
                            <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6 flex-1">
                                <div class="h-20 w-28 md:h-16 md:w-24 bg-slate-200 rounded-xl overflow-hidden flex-shrink-0 shadow-sm">
                                    <% if(enroll.Course && enroll.Course.image) { %>
                                        <img src="<%= enroll.Course.image %>" class="h-full w-full object-cover" alt="<%= enroll.Course.title %>">
                                    <% } else { %>
                                        <div class="h-full w-full bg-gradient-to-br from-slate-300 to-slate-400 flex items-center justify-center">
                                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                            </svg>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="flex-1">
                                    <h4 class="text-lg font-bold text-slate-900 mb-1"><%= enroll.Course ? enroll.Course.title : 'Curso indisponível' %></h4>
                                    <% if (enroll.Course) { %>
                                        <div class="mb-2">
                                            <% if (enroll.Course.statusCode === 'confirmado') { %>
                                                <span class="inline-flex rounded-full border border-blue-700 bg-blue-600 px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.18em] text-white shadow-sm shadow-blue-200">Curso confirmado</span>
                                            <% } else if (enroll.Course.statusCode === 'encerrado') { %>
                                                <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-amber-700 border border-amber-200">Curso encerrado</span>
                                            <% } else if (enroll.Course.statusCode === 'desativado') { %>
                                                <span class="inline-flex rounded-full bg-red-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-red-700 border border-red-200">Curso desativado</span>
                                            <% } %>
                                        </div>
                                    <% } %>
                                    <div class="flex flex-wrap items-center text-xs text-slate-500 mb-2 gap-2">
                                        <span class="flex items-center bg-slate-100 px-2 py-1 rounded">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                            </svg>
                                            <%= enroll.Course ? enroll.Course.location : 'Local indisponível' %>
                                        </span>
                                        <span class="flex items-center bg-slate-100 px-2 py-1 rounded">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            <%= enroll.Course ? enroll.Course.workload : '--' %>
                                        </span>
                                        <% if (enroll.Course && enroll.Course.startDate) { %>
                                            <span class="flex items-center bg-slate-100 px-2 py-1 rounded">
                                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                                <%= new Date(enroll.Course.startDate).toLocaleDateString('pt-BR') %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3">
                                <div class="flex-shrink-0">
                                    <% if(enroll.status === 'completo') { %>
                                        <span class="inline-block bg-emerald-100 text-emerald-700 px-3 py-2 rounded-lg text-xs font-black uppercase tracking-widest border border-emerald-200">
                                            Concluído
                                        </span>
                                    <% } else if(enroll.status === 'confirmado') { %>
                                        <span class="inline-block bg-blue-100 text-blue-700 px-3 py-2 rounded-lg text-xs font-black uppercase tracking-widest border border-blue-200">
                                            Confirmado
                                        </span>
                                    <% } else if(enroll.status === 'cancelado') { %>
                                        <span class="inline-block bg-red-100 text-red-700 px-3 py-2 rounded-lg text-xs font-black uppercase tracking-widest border border-red-200">
                                            Cancelado
                                        </span>
                                    <% } else { %>
                                        <span class="inline-block bg-slate-100 text-slate-700 px-3 py-2 rounded-lg text-xs font-black uppercase tracking-widest border border-slate-200">
                                            Pendente
                                        </span>
                                    <% } %>
                                </div>

                                <div class="flex gap-2">
                                    <a href="/meu-comprovante/<%= enroll.id %>" target="_blank" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-xs font-bold shadow-lg shadow-green-100 transition-all flex items-center whitespace-nowrap">
                                        Comprovante
                                    </a>
                                    <a href="/meus-cursos/<%= enroll.id %>/anexo" class="<%= enroll.hasEnrollmentAttachment ? 'bg-indigo-100 hover:bg-indigo-200 text-indigo-700' : 'bg-amber-100 hover:bg-amber-200 text-amber-800' %> px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center whitespace-nowrap">
                                        <%= enroll.hasEnrollmentAttachment ? 'Atualizar anexo' : 'Anexar documento' %>
                                    </a>
                                    <% if(enroll.Course && enroll.Course.proposalDoc) { %>
                                        <a href="<%= enroll.Course.proposalDoc %>" download target="_blank" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center whitespace-nowrap">
                                            Material
                                        </a>
                                    <% } %>
                                    <% if(enroll.status === 'completo') { %>
                                        <a href="/meu-certificado/<%= enroll.id %>" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-xs font-bold shadow-lg shadow-emerald-100 transition-all flex items-center whitespace-nowrap">
                                            Certificado
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-t border-slate-100">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="text-sm text-slate-600">
                                    <p class="font-medium mb-1">Informações da sua inscrição:</p>
                                    <div class="flex flex-wrap gap-4">
                                        <span class="flex items-center">
                                            <svg class="w-4 h-4 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                            Inscrito em: <%= new Date(enroll.createdAt).toLocaleDateString('pt-BR') %>
                                        </span>
                                        <span class="flex items-center">
                                            <svg class="w-4 h-4 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Investimento: <%= formatCurrency(enroll.finalPrice || enroll.coursePrice || 0) %>
                                        </span>
                                        <span class="flex items-center">
                                            <svg class="w-4 h-4 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828M8 7h8a2 2 0 012 2v8a2 2 0 01-2 2H8a2 2 0 01-2-2V9a2 2 0 012-2z" />
                                            </svg>
                                            Documento da inscrição: <%= enroll.hasEnrollmentAttachment ? 'enviado' : 'pendente' %>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="flex gap-2">
                                    <% if (enroll.Course) { %>
                                        <a href="/curso/<%= enroll.Course.id %>" class="text-xs text-slate-600 hover:text-indigo-600 flex items-center">
                                            Ver detalhes do curso
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>
