<%- include('./_hub-nav') %>

<%
    const formatFileSize = (size) => {
        const value = Number(size || 0);
        if (!value) return 'Arquivo ainda não enviado';
        if (value < 1024) return `${value} B`;
        if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)} KB`;
        return `${(value / (1024 * 1024)).toFixed(1)} MB`;
    };
%>

<div class="mx-auto w-full max-w-7xl space-y-6 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-5 py-6 md:px-8">
            <a href="/meus-cursos" class="inline-flex items-center gap-2 text-sm font-bold text-orange-600 transition hover:text-orange-700">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Voltar para meus cursos
            </a>
            <div class="mt-8 flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                <div class="max-w-3xl">
                    <p class="text-xs font-black uppercase tracking-[0.24em] text-slate-400">Documento da inscrição</p>
                    <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl"><%= enrollment.Course ? enrollment.Course.title : `Inscrição #${enrollment.id}` %></h2>
                    <p class="mt-3 text-sm leading-6 text-slate-500">
                        Envie aqui seu empenho, comprovante de pagamento ou outro documento solicitado para análise do administrativo.
                        Sempre que necessário, você pode substituir o arquivo enviado.
                    </p>
                </div>
                <div class="inline-flex w-full items-center gap-3 rounded-2xl border <%= enrollment.enrollmentAttachmentPath ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-amber-200 bg-amber-50 text-amber-800' %> px-5 py-4 text-sm shadow-sm sm:w-fit">
                    <div class="flex h-11 w-11 items-center justify-center rounded-2xl <%= enrollment.enrollmentAttachmentPath ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <% if (enrollment.enrollmentAttachmentPath) { %>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828M8 7h8a2 2 0 012 2v8a2 2 0 01-2 2H8a2 2 0 01-2-2V9a2 2 0 012-2z"></path>
                            <% } else { %>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            <% } %>
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.22em] opacity-70">Status atual</p>
                        <p class="mt-1 font-bold"><%= enrollment.enrollmentAttachmentPath ? 'Documento enviado' : 'Aguardando envio' %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid gap-6 p-4 sm:p-5 md:px-8 md:py-6 lg:grid-cols-[1.15fr_0.85fr]">
            <form action="/meus-cursos/<%= enrollment.id %>/anexo" method="POST" enctype="multipart/form-data" class="space-y-5">
                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 sm:p-5 md:p-6">
                        <div class="flex items-start gap-3 sm:gap-4">
                        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-700 shadow-sm">
                            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828M8 7h8a2 2 0 012 2v8a2 2 0 01-2 2H8a2 2 0 01-2-2V9a2 2 0 012-2z"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-500">Selecionar arquivo</p>
                            <p class="mt-2 text-sm leading-6 text-slate-500">Envie um único documento por vez. Caso já exista um arquivo salvo, o novo envio substitui automaticamente o anterior.</p>
                        </div>
                    </div>

                    <div class="mt-5 rounded-3xl border border-dashed border-slate-300 bg-white p-4 sm:p-5 md:p-6">
                        <input id="enrollmentAttachment" name="enrollmentAttachment" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp" class="sr-only">

                        <label for="enrollmentAttachment" id="enrollment-upload-idle" class="<%= enrollment.enrollmentAttachmentPath ? 'hidden ' : '' %>flex cursor-pointer flex-col items-center justify-center rounded-3xl border border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center transition hover:border-orange-300 hover:bg-orange-50/40 sm:px-6 sm:py-10">
                            <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-gradient-to-br from-orange-500 to-amber-500 text-white shadow-lg shadow-orange-200">
                                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M12 11v6m0 0l-3-3m3 3l3-3"></path>
                                </svg>
                            </div>
                            <p class="mt-5 text-base font-black text-slate-900 sm:text-lg">Clique para anexar seu documento</p>
                            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                                Envie um único documento por vez. Caso já exista um arquivo salvo, o novo envio substitui automaticamente o anterior.
                            </p>
                            <div class="mt-5 inline-flex items-center gap-2 rounded-2xl bg-white px-5 py-3 text-sm font-bold text-orange-700 shadow-sm ring-1 ring-orange-200">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                Escolher arquivo
                            </div>
                            <div class="mt-5 inline-flex items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-800">
                                <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828M8 7h8a2 2 0 012 2v8a2 2 0 01-2 2H8a2 2 0 01-2-2V9a2 2 0 012-2z"></path>
                                </svg>
                                <span>Ao escolher um arquivo, ele será enviado para análise do administrativo.</span>
                            </div>
                            <div class="mt-4 rounded-2xl bg-white px-5 py-3 text-sm text-slate-500 ring-1 ring-slate-200">
                                Aceitamos PDF, DOC e imagens com até 8MB.
                            </div>
                        </label>

                        <div id="selected-enrollment-file" class="<%= enrollment.enrollmentAttachmentPath ? '' : 'hidden ' %>rounded-3xl border border-emerald-200 bg-gradient-to-r from-emerald-50 via-white to-teal-50 p-4 shadow-sm sm:p-5">
                            <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
                                <div class="flex min-w-0 items-center gap-3 sm:gap-4">
                                    <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-3xl bg-white text-emerald-700 shadow-sm">
                                        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-600"><%= enrollment.enrollmentAttachmentPath ? 'Arquivo atual' : 'Arquivo anexado' %></p>
                                        <p id="selected-enrollment-file-name" class="mt-1 truncate text-base font-black text-emerald-950"><%= enrollment.enrollmentAttachmentOriginalName || '' %></p>
                                        <p class="mt-1 text-sm text-emerald-700">
                                            <%= enrollment.enrollmentAttachmentPath ? 'Esse é o documento salvo no momento. Você pode visualizar, remover da seleção atual e escolher outro para substituir.' : 'Pronto para envio. Você pode remover e escolher outro, se quiser.' %>
                                        </p>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center justify-center gap-3 sm:justify-end">
                                    <% if (enrollment.enrollmentAttachmentPath) { %>
                                        <a href="/meus-cursos/<%= enrollment.id %>/anexo/download" class="inline-flex items-center gap-2 rounded-2xl border border-emerald-200 bg-white px-4 py-2.5 text-sm font-bold text-emerald-700 shadow-sm transition hover:bg-emerald-50">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0A9 9 0 113 12a9 9 0 0118 0zm-9-4v8"></path>
                                            </svg>
                                            Visualizar arquivo
                                        </a>
                                    <% } %>
                                    <button type="button" id="clear-enrollment-file" class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border border-rose-200 bg-white text-rose-500 shadow-sm transition hover:bg-rose-50 hover:text-rose-600" aria-label="Remover arquivo selecionado">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
                    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-orange-600 px-8 py-4 text-sm font-black text-white shadow-[0_16px_35px_-18px_rgba(234,88,12,0.75)] ring-1 ring-orange-500/20 transition hover:-translate-y-0.5 hover:bg-orange-700 hover:shadow-[0_20px_40px_-18px_rgba(194,65,12,0.85)] sm:w-auto">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V8m0 0l-3 3m3-3l3 3m6 5a2 2 0 01-2 2H5a2 2 0 01-2-2"></path>
                        </svg>
                        <%= enrollment.enrollmentAttachmentPath ? 'Atualizar documento' : 'Enviar documento' %>
                    </button>
                </div>
            </form>

            <div class="space-y-5">
                <div class="rounded-3xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">
                    <p class="font-bold">Quando usar este envio?</p>
                    <p class="mt-2 leading-6">
                        Use este espaço para anexar empenho, comprovante de pagamento ou qualquer documento complementar solicitado pela equipe administrativa para validar sua inscrição.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const input = document.getElementById('enrollmentAttachment');
        const idleState = document.getElementById('enrollment-upload-idle');
        const selectedFile = document.getElementById('selected-enrollment-file');
        const selectedFileName = document.getElementById('selected-enrollment-file-name');
        const clearButton = document.getElementById('clear-enrollment-file');
        const persistedFileName = <%- JSON.stringify(enrollment.enrollmentAttachmentOriginalName || '') %>;

        if (!input || !idleState || !selectedFile || !selectedFileName || !clearButton) {
            return;
        }

        const syncSelectedFile = () => {
            const file = input.files && input.files[0];

            if (!file) {
                if (persistedFileName) {
                    idleState.classList.add('hidden');
                    selectedFile.classList.remove('hidden');
                    selectedFileName.textContent = persistedFileName;
                    return;
                }

                idleState.classList.remove('hidden');
                selectedFile.classList.add('hidden');
                selectedFileName.textContent = '';
                return;
            }

            idleState.classList.add('hidden');
            selectedFileName.textContent = file.name;
            selectedFile.classList.remove('hidden');
        };

        input.addEventListener('change', syncSelectedFile);

        clearButton.addEventListener('click', () => {
            input.value = '';
            syncSelectedFile();
        });

        syncSelectedFile();
    });
</script>
