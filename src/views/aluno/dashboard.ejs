<%- include('./_hub-nav') %>

<div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="space-y-6">
        <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
            <div class="px-6 py-8 text-white md:px-8 md:py-10" style="background: linear-gradient(135deg, #0f172a 0%, #16213e 45%, #0f766e 100%);">
                <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                    <div class="flex items-start gap-4">
                        <div class="relative shrink-0">
                            <img
                                class="h-20 w-20 rounded-3xl border border-white/20 bg-white/10 object-cover shadow-xl"
                                src="<%= user.avatar || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=ffffff&color=0f766e') %>"
                                alt="<%= user.name %>"
                            >
                            <span class="absolute -bottom-1 -right-1 h-5 w-5 rounded-full border-2 border-slate-900 bg-emerald-400"></span>
                        </div>

                        <div class="space-y-3">
                            <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.24em] text-emerald-100">
                                Painel do aluno
                            </span>
                            <div>
                                <h1 class="text-3xl font-black tracking-tight md:text-4xl">Olá, <%= user.name.split(' ')[0] %>.</h1>
                                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-200 md:text-base">
                                    Veja o que já está confirmado, o que ainda precisa de atenção e acesse rapidamente seus comprovantes e certificados.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="grid gap-3 sm:grid-cols-2 lg:w-auto">
                        <a href="/cursos" class="rounded-2xl border border-white/15 bg-white/10 px-4 py-4 transition hover:bg-white/15">
                            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-slate-300">Explorar</p>
                            <p class="mt-2 text-base font-bold text-white">Ver cursos</p>
                        </a>
                        <a href="/meus-certificados" class="rounded-2xl border border-white/15 bg-white/10 px-4 py-4 transition hover:bg-white/15">
                            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-slate-300">Acesso rápido</p>
                            <p class="mt-2 text-base font-bold text-white">Meus certificados</p>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Inscrições</p>
                        <p class="mt-2 text-3xl font-black text-slate-950"><%= stats ? stats.totalCourses : enrollments.length %></p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                    </div>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-500">Total de cursos e inscrições ligados à sua conta.</p>
            </article>

            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Em andamento</p>
                        <p class="mt-2 text-3xl font-black text-slate-950"><%= stats ? stats.inProgressCount : enrollments.filter((e) => e.status !== 'completo').length %></p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-500">Inscrições pendentes, confirmadas ou ainda não concluídas.</p>
            </article>

            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Turmas confirmadas</p>
                        <p class="mt-2 text-3xl font-black text-slate-950"><%= stats ? stats.confirmedCount : 0 %></p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-50 text-cyan-600">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    </div>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-500">Cursos já confirmados e prontos para acompanhamento.</p>
            </article>

            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Certificados</p>
                        <p class="mt-2 text-3xl font-black text-slate-950"><%= certificateCount %></p>
                    </div>
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-500">Documentos já liberados para visualização e download.</p>
            </article>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-100 px-6 py-5 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-[0.24em] text-indigo-500">Minha agenda</p>
                    <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950">Seus cursos e próximos passos</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Os cards abaixo mostram o status da sua inscrição, o status da turma e as ações mais importantes de cada curso.</p>
                </div>
                <div class="inline-flex items-center rounded-full bg-slate-100 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-slate-500">
                    <%= enrollments.length %> registro(s)
                </div>
            </div>

            <% if (!enrollments.length) { %>
                <div class="px-6 py-14 text-center md:px-10">
                    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-slate-100 text-slate-300">
                        <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                    </div>
                    <h3 class="mt-5 text-xl font-bold text-slate-900">Você ainda não possui cursos ativos na plataforma.</h3>
                    <p class="mt-2 text-sm text-slate-500">Quando realizar sua primeira inscrição, ela aparecerá aqui com status, materiais e comprovantes.</p>
                    <a href="/cursos" class="mt-6 inline-flex items-center rounded-2xl bg-indigo-600 px-6 py-3 text-sm font-black uppercase tracking-wider text-white transition hover:bg-indigo-700">
                        Explorar cursos
                    </a>
                </div>
            <% } else { %>
                <div class="space-y-5 p-5 md:p-6">
                    <% enrollments.forEach((enroll) => { %>
                        <% 
                            const course = enroll.Course;
                            const enrollmentStatusMap = {
                                pendente: {
                                    label: 'Inscrição pendente',
                                    className: 'border-slate-200 bg-slate-100 text-slate-700'
                                },
                                confirmado: {
                                    label: 'Inscrição confirmada',
                                    className: 'border-blue-200 bg-blue-100 text-blue-700'
                                },
                                completo: {
                                    label: 'Curso concluído',
                                    className: 'border-emerald-200 bg-emerald-100 text-emerald-700'
                                },
                                cancelado: {
                                    label: 'Inscrição cancelada',
                                    className: 'border-red-200 bg-red-100 text-red-700'
                                }
                            };
                            const enrollmentBadge = enrollmentStatusMap[enroll.status] || enrollmentStatusMap.pendente;
                        %>
                        <article class="rounded-3xl border border-slate-200 bg-slate-50/60 p-5 transition hover:border-slate-300 hover:bg-white md:p-6">
                            <div class="flex flex-col gap-5">
                                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                                    <div class="flex min-w-0 flex-1 gap-4">
                                        <div class="h-24 w-28 shrink-0 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                                            <% if (course && course.image) { %>
                                                <img src="<%= course.image %>" alt="<%= course.title %>" class="h-full w-full object-cover">
                                            <% } else { %>
                                                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-slate-200 to-slate-300 text-slate-500">
                                                    <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                                                </div>
                                            <% } %>
                                        </div>

                                        <div class="min-w-0 flex-1">
                                            <h3 class="text-xl font-black leading-tight text-slate-950"><%= course ? course.title : 'Curso indisponível' %></h3>

                                            <div class="mt-3 flex flex-wrap gap-2">
                                                <span class="inline-flex items-center rounded-full border px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] <%= enrollmentBadge.className %>">
                                                    <%= enrollmentBadge.label %>
                                                </span>

                                                <% if (course && course.statusCode && course.statusCode !== 'ativo') { %>
                                                    <% if (course.statusCode === 'confirmado') { %>
                                                        <span class="inline-flex items-center rounded-full border border-blue-700 bg-blue-600 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] text-white shadow-sm shadow-blue-200">
                                                            Turma confirmada
                                                        </span>
                                                    <% } else if (course.statusCode === 'encerrado') { %>
                                                        <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] text-amber-700">
                                                            Curso encerrado
                                                        </span>
                                                    <% } else if (course.statusCode === 'desativado') { %>
                                                        <span class="inline-flex items-center rounded-full border border-red-200 bg-red-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] text-red-700">
                                                            Curso desativado
                                                        </span>
                                                    <% } %>
                                                <% } %>
                                            </div>

                                            <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-slate-600">
                                                <span class="inline-flex items-center rounded-full bg-white px-3 py-1.5">
                                                    <svg class="mr-1.5 h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                                                    <%= course ? course.location : 'Local indisponível' %>
                                                </span>
                                                <span class="inline-flex items-center rounded-full bg-white px-3 py-1.5">
                                                    <svg class="mr-1.5 h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                    <%= course ? course.workload : 'Carga horária indisponível' %>
                                                </span>
                                                <span class="inline-flex items-center rounded-full bg-white px-3 py-1.5">
                                                    <svg class="mr-1.5 h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                                    <%= course ? new Date(course.startDate).toLocaleDateString('pt-BR') : 'Data indisponível' %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex flex-wrap items-center gap-3 lg:max-w-sm lg:justify-end">
                                        <a href="/meu-comprovante/<%= enroll.id %>" target="_blank" class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-black text-white transition hover:bg-slate-800">
                                            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                                            Comprovante
                                        </a>

                                        <a href="/meus-cursos/<%= enroll.id %>/anexo" class="inline-flex items-center justify-center rounded-xl <%= enroll.hasEnrollmentAttachment ? 'border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'border border-amber-200 bg-amber-50 text-amber-800 hover:bg-amber-100' %> px-4 py-2.5 text-xs font-black transition">
                                            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828L18 9.828M8 7h8a2 2 0 012 2v8a2 2 0 01-2 2H8a2 2 0 01-2-2V9a2 2 0 012-2z" /></svg>
                                            <%= enroll.hasEnrollmentAttachment ? 'Anexo enviado' : 'Anexar documento' %>
                                        </a>

                                        <% if (course && course.proposalDoc) { %>
                                            <a href="<%= course.proposalDoc %>" download target="_blank" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-black text-slate-700 transition hover:bg-slate-50">
                                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                                Material
                                            </a>
                                        <% } %>

                                        <% if (enroll.status === 'completo') { %>
                                            <a href="/meu-certificado/<%= enroll.id %>" target="_blank" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-black text-white transition hover:bg-emerald-700">
                                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                Certificado
                                            </a>
                                        <% } else if (course) { %>
                                            <a href="/curso/<%= course.id %>" class="inline-flex items-center justify-center rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-xs font-black text-indigo-700 transition hover:bg-indigo-100">
                                                <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                Detalhes do curso
                                            </a>
                                        <% } else { %>
                                            <span class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-xs font-black text-slate-500">
                                                Curso indisponível
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="grid gap-3 border-t border-slate-200 pt-4 md:grid-cols-3">
                                    <div class="rounded-2xl bg-white px-4 py-3">
                                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Data da inscrição</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-800"><%= new Date(enroll.createdAt).toLocaleDateString('pt-BR') %></p>
                                    </div>
                                    <div class="rounded-2xl bg-white px-4 py-3">
                                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Investimento</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-800"><%= formatCurrency(course ? course.price : 0) %></p>
                                    </div>
                                    <div class="rounded-2xl bg-white px-4 py-3">
                                        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Próxima ação</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-800">
                                            <% if (enroll.status === 'completo') { %>
                                                Baixar certificado
                                            <% } else if (!enroll.hasEnrollmentAttachment) { %>
                                                Enviar documento
                                            <% } else if (enroll.status === 'confirmado') { %>
                                                Acompanhar detalhes
                                            <% } else if (enroll.status === 'cancelado') { %>
                                                Consultar novos cursos
                                            <% } else { %>
                                                Aguardar confirmação
                                            <% } %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <% if (enrollments.length > 0 && enrollments.some((item) => item.Course && item.Course.proposalDoc)) { %>
            <section class="rounded-[2rem] border border-blue-200 bg-blue-50/80 p-6 shadow-sm">
                <div class="flex flex-col gap-4 md:flex-row md:items-start">
                    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-blue-600 shadow-sm">
                        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    </div>
                    <div class="space-y-2">
                        <h3 class="text-xl font-black text-slate-950">Materiais e comprovantes ficam dentro de cada curso</h3>
                        <p class="text-sm leading-6 text-slate-600">Sempre que um curso tiver proposta, apostila ou arquivo complementar, o botão de download aparece no card correspondente. O comprovante também permanece disponível a qualquer momento.</p>
                    </div>
                </div>
            </section>
        <% } %>
    </div>
</div>
