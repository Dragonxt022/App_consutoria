<div class="w-full max-w-5xl mr-auto space-y-6" x-data="{ emailModalOpen: false, passwordModalOpen: false }" @keydown.window.escape="emailModalOpen = false; passwordModalOpen = false">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-xl font-bold text-slate-800">Perfil do Administrador</h2>
        <p class="text-sm text-slate-500 mt-1">Atualize seus dados principais aqui e use ações protegidas para trocar e-mail ou senha.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <h3 class="text-base font-bold text-slate-800 mb-4">Dados do Perfil</h3>

                <form action="/admin/perfil/atualizar" method="POST" enctype="multipart/form-data" class="space-y-5">
                    <div class="flex items-center gap-4">
                        <img id="avatarPreview"
                             src="<%= user.avatar ? user.avatar : ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=4f46e5&color=fff') %>"
                             alt="Avatar"
                             class="h-20 w-20 rounded-full border border-slate-200 object-cover bg-slate-100">
                        <div class="flex-1">
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Foto de Perfil</label>
                            <input type="file" name="avatar" id="avatarInput" accept="image/*"
                                   class="text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                            <p class="text-xs text-slate-400 mt-1">PNG/JPG/WebP até 8MB.</p>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Nome</label>
                        <input type="text" name="name" required value="<%= user.name %>"
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>

                    <div class="pt-2">
                        <button type="submit"
                                class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl text-sm font-bold">
                            Salvar Perfil
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <h4 class="font-bold text-slate-800 mb-3">Status do E-mail</h4>
                <p class="text-xs text-slate-500">E-mail atual: <strong class="text-slate-700"><%= user.email %></strong></p>
                <% if (user.pendingEmail) { %>
                    <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">
                        Há uma troca pendente para: <strong><%= user.pendingEmail %></strong>.
                        Verifique a caixa de entrada e confirme o link recebido.
                    </div>
                <% } else { %>
                    <div class="mt-3 rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800">
                        Nenhuma troca de e-mail pendente.
                    </div>
                <% } %>
                <button
                    type="button"
                    @click="emailModalOpen = true"
                    class="mt-4 w-full rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100"
                >
                    Atualizar e-mail
                </button>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <h4 class="font-bold text-slate-800 mb-2">Senha de acesso</h4>
                <p class="text-xs text-slate-500">Use um fluxo separado e protegido para alterar sua senha com segurança.</p>
                <button
                    type="button"
                    @click="passwordModalOpen = true"
                    class="mt-4 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                >
                    Alterar senha
                </button>
            </div>

            <div class="bg-indigo-50 rounded-2xl border border-indigo-100 p-5">
                <h4 class="font-bold text-indigo-900 mb-2">Regras de Segurança</h4>
                <ul class="text-xs text-indigo-800 space-y-1">
                    <li>- A troca de e-mail exige confirmação por link.</li>
                    <li>- A troca de senha exige senha atual.</li>
                    <li>- Use senhas com no mínimo 6 caracteres.</li>
                </ul>
            </div>
        </div>
    </div>

    <div
        x-cloak
        x-show="emailModalOpen"
        x-transition.opacity
        class="fixed inset-0 z-[80] flex items-center justify-center bg-slate-950/55 p-4"
    >
        <div class="w-full max-w-lg rounded-3xl bg-white shadow-2xl" @click.outside="emailModalOpen = false">
            <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Atualizar e-mail</h3>
                    <p class="mt-1 text-sm text-slate-500">A alteração será concluída após confirmação no novo endereço.</p>
                </div>
                <button type="button" @click="emailModalOpen = false" class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="Fechar modal de e-mail">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form action="/admin/perfil/atualizar" method="POST" class="space-y-5 px-6 py-6">
                <input type="hidden" name="name" value="<%= user.name %>">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">E-mail atual</label>
                    <input type="email" value="<%= user.email %>" disabled class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-500">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Novo e-mail</label>
                    <input type="email" name="email" value="<%= user.pendingEmail || user.email %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Senha atual</label>
                    <input type="password" name="emailPassword" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <p class="mt-2 text-xs text-slate-400">Obrigatória para confirmar a solicitação de troca de e-mail.</p>
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" @click="emailModalOpen = false" class="px-5 py-3 text-sm font-bold text-slate-500">Cancelar</button>
                    <button type="submit" class="rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-indigo-700">
                        Solicitar alteração
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div
        x-cloak
        x-show="passwordModalOpen"
        x-transition.opacity
        class="fixed inset-0 z-[80] flex items-center justify-center bg-slate-950/55 p-4"
    >
        <div class="w-full max-w-xl rounded-3xl bg-white shadow-2xl" @click.outside="passwordModalOpen = false">
            <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Alterar senha</h3>
                    <p class="mt-1 text-sm text-slate-500">Confirme sua senha atual e defina uma nova combinação segura.</p>
                </div>
                <button type="button" @click="passwordModalOpen = false" class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="Fechar modal de senha">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form action="/admin/perfil/alterar-senha" method="POST" class="space-y-5 px-6 py-6">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Senha atual</label>
                    <input type="password" name="currentPassword" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Nova senha</label>
                        <input type="password" name="newPassword" required minlength="6" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Confirmar nova senha</label>
                        <input type="password" name="confirmPassword" required minlength="6" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" @click="passwordModalOpen = false" class="px-5 py-3 text-sm font-bold text-slate-500">Cancelar</button>
                    <button type="submit" class="rounded-xl bg-slate-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-slate-800">
                        Atualizar senha
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(() => {
    const input = document.getElementById('avatarInput');
    const preview = document.getElementById('avatarPreview');
    if (!input || !preview) return;

    input.addEventListener('change', (event) => {
        const file = event.target.files && event.target.files[0];
        if (!file) return;
        if (!file.type.startsWith('image/')) return;

        const reader = new FileReader();
        reader.onload = () => {
            preview.src = String(reader.result || '');
        };
        reader.readAsDataURL(file);
    });
})();
</script>
