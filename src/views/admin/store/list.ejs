<div class="bg-white shadow-md rounded-xl overflow-hidden" x-data="{ showFilters: <%= (filters && (filters.search || filters.status || filters.category)) ? 'true' : 'false' %> }">
    <div class="p-4 md:p-6 border-b border-gray-100 bg-gray-50/50">
        <div class="flex flex-col gap-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 shadow-sm shadow-indigo-100">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m1.6 8L5.4 5M7 13l-1.293 6.293A1 1 0 006.683 21h10.634a1 1 0 00.976-1.293L17 13M9 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Catálogo digital</p>
                        <p class="mt-2 text-xs md:text-sm text-gray-500">Total: <%= pagination ? pagination.totalItems : products.length %> produto(s) com monitoramento de cliques e status.</p>
                    </div>
                </div>
                <div class="flex w-full md:w-auto items-center gap-3">
                    <button type="button" @click="showFilters = !showFilters" class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900" :title="showFilters ? 'Ocultar filtros' : 'Mostrar filtros'">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 01.8 1.6L15 12v5a1 1 0 01-.553.894l-4 2A1 1 0 019 19v-7L3.2 4.6A1 1 0 013 4z"/>
                        </svg>
                    </button>
                    <a href="/admin/loja/criar" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 md:py-2 rounded-lg text-sm font-bold transition-all shadow-lg shadow-indigo-100 flex items-center justify-center w-full md:w-auto">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"></path></svg>
                        Novo Produto
                    </a>
                </div>
            </div>

            <form action="/admin/loja" method="GET" class="w-full xl:max-w-5xl" x-show="showFilters" x-cloak x-transition>
                <div class="grid gap-3 rounded-xl border border-gray-100 bg-white p-4 shadow-sm md:grid-cols-4 md:items-end">
                    <div class="min-w-0 md:col-span-2">
                        <label for="search" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Pesquisar</label>
                        <input id="search" type="text" name="search" placeholder="Buscar por produto ou descrição..." value="<%= filters?.search || '' %>" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label for="status" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Status</label>
                        <select id="status" name="status" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                            <option value="">Todos</option>
                            <option value="ativo" <%= filters?.status === 'ativo' ? 'selected' : '' %>>Ativo</option>
                            <option value="desativado" <%= filters?.status === 'desativado' ? 'selected' : '' %>>Desativado</option>
                            <option value="destaque" <%= filters?.status === 'destaque' ? 'selected' : '' %>>Destaque</option>
                        </select>
                    </div>
                    <div>
                        <label for="category" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Categoria</label>
                        <select id="category" name="category" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                            <option value="">Todas</option>
                            <% categories.forEach((category) => { %>
                                <option value="<%= category %>" <%= filters?.category === category ? 'selected' : '' %>><%= category %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="flex flex-col gap-2 md:col-span-4 md:flex-row">
                        <button type="submit" class="w-full rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white transition-colors hover:bg-indigo-700 md:w-auto">Buscar</button>
                        <% if (filters?.search || filters?.status || filters?.category) { %>
                            <a href="/admin/loja" class="w-full rounded-lg border border-slate-200 px-6 py-2.5 text-center text-sm font-semibold text-slate-500 transition-colors hover:bg-slate-50 md:w-auto">Limpar</a>
                        <% } %>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead class="bg-gray-50 text-gray-500 uppercase text-xs font-bold">
                <tr>
                    <th class="px-6 py-4">Produto</th>
                    <th class="px-6 py-4">Categoria</th>
                    <th class="px-6 py-4">Preco</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4">Cliques</th>
                    <th class="px-6 py-4 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% if (products.length === 0) { %>
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-gray-500">Nenhum produto cadastrado na loja.</td>
                    </tr>
                <% } %>

                <% products.forEach((product) => { %>
                    <tr class="hover:bg-gray-50/50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex min-w-0 items-center gap-3">
                                <div class="h-16 w-24 overflow-hidden rounded-xl border border-slate-200 bg-slate-100 flex-shrink-0">
                                    <% if (product.primaryImage) { %>
                                        <img src="<%= product.primaryImage %>" alt="<%= product.name %>" class="block h-full w-full object-cover">
                                    <% } else { %>
                                        <div class="flex h-full w-full items-center justify-center text-slate-400">
                                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-4m-8 0H4m8 0v4"></path></svg>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="min-w-0">
                                    <div class="text-sm font-bold text-gray-900"><%= product.name %></div>
                                    <div class="mt-1 text-xs text-gray-500 line-clamp-2"><%= product.shortDescription %></div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-600">
                            <div class="flex flex-col gap-1">
                                <span><%= product.category || 'Geral' %></span>
                                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400"><%= product.platform %></span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm font-bold text-gray-900"><%= product.price || 'Consulte' %></td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col gap-2">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-widest <%= product.active ? 'bg-emerald-100 text-emerald-700 border border-emerald-200' : 'bg-red-100 text-red-700 border border-red-200' %>">
                                    <%= product.active ? 'Ativo' : 'Desativado' %>
                                </span>
                                <% if (product.featured) { %>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-amber-100 text-amber-700 border border-amber-200">
                                        Destaque
                                    </span>
                                <% } %>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm font-bold text-slate-700"><%= product.clickCount || 0 %></td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <button type="button" class="js-copy-affiliate p-2 text-gray-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-all" data-link="<%= product.affiliateUrl %>" title="Copiar link afiliado">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2M10 18h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                </button>
                                <a href="/loja/<%= product.slug %>" target="_blank" class="p-2 text-gray-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-all" title="Ver produto">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12z"></path></svg>
                                </a>
                                <a href="/admin/loja/<%= product.id %>/editar" class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all" title="Editar produto">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                </a>
                                <form action="/admin/loja/<%= product.id %>/status" method="POST" class="inline">
                                    <button type="submit" class="p-2 <%= product.active ? 'text-gray-400 hover:text-amber-600 hover:bg-amber-50' : 'text-gray-400 hover:text-emerald-600 hover:bg-emerald-50' %> rounded-lg transition-all" title="<%= product.active ? 'Desativar' : 'Ativar' %> produto">
                                        <% if (product.active) { %>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                                        <% } else { %>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <% } %>
                                    </button>
                                </form>
                                <form action="/admin/loja/<%= product.id %>/deletar" method="POST" class="inline" onsubmit="return confirm('Deseja remover este produto da loja?')">
                                    <button type="submit" class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Remover produto">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <% if (pagination && pagination.totalPages > 1) { %>
        <div class="flex flex-col gap-3 border-t border-gray-100 px-4 py-4 md:flex-row md:items-center md:justify-between md:px-6">
            <span class="text-sm text-gray-500">Mostrando pagina <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
            <div class="flex flex-wrap items-center gap-2">
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <a href="?page=<%= i %>&search=<%= encodeURIComponent(filters?.search || '') %>&status=<%= encodeURIComponent(filters?.status || '') %>&category=<%= encodeURIComponent(filters?.category || '') %>" class="rounded border border-gray-200 px-3 py-1 text-sm font-bold <%= pagination.currentPage === i ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100' %>">
                        <%= i %>
                    </a>
                <% } %>
            </div>
        </div>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.js-copy-affiliate').forEach((button) => {
        button.addEventListener('click', async function () {
            try {
                await navigator.clipboard.writeText(this.dataset.link || '');
                this.classList.remove('text-gray-400');
                this.classList.add('text-emerald-600');
                this.title = 'Link copiado';
                setTimeout(() => {
                    this.title = 'Copiar link afiliado';
                    this.classList.add('text-gray-400');
                    this.classList.remove('text-emerald-600');
                }, 1500);
            } catch (error) {
                alert('Não foi possível copiar o link.');
            }
        });
    });
});
</script>
