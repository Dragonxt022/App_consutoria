<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">

<div class="w-full max-w-6xl mr-auto">
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
        <div class="bg-slate-50 p-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold text-slate-800">Editar Produto</h2>
                <p class="text-slate-500 text-sm">Atualize o cadastro e o link afiliado do produto.</p>
            </div>
            <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest <%= product.active ? 'bg-emerald-100 text-emerald-700 border border-emerald-200' : 'bg-red-100 text-red-700 border border-red-200' %>">
                <%= product.active ? 'Ativo' : 'Desativado' %>
            </span>
        </div>

        <form action="/admin/loja/<%= product.id %>/editar" method="POST" enctype="multipart/form-data" class="p-8 space-y-8">
            <div class="grid md:grid-cols-2 gap-8">
                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Nome do Produto</label>
                        <input type="text" name="name" required value="<%= product.name %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Descrição Curta</label>
                        <textarea name="shortDescription" rows="4" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"><%= product.shortDescription %></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Preço</label>
                            <input type="text" name="price" value="<%= product.price || '' %>" data-currency-input data-currency-prefix="R$ " data-currency-storage="formatted" data-currency-mode="cents" inputmode="numeric" autocomplete="off" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Plataforma</label>
                            <input type="text" name="platform" value="<%= product.platform %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Categoria</label>
                        <input type="text" name="category" value="<%= product.category || 'Geral' %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                </div>

                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Galeria de Imagens</label>
                        <p class="mb-3 text-xs text-slate-400">As imagens atuais aparecem abaixo. Se enviar novas imagens, a galeria será substituída e a primeira da nova seleção será usada como capa.</p>
                        <div class="space-y-4">
                            <% if (Array.isArray(product.galleryImages) && product.galleryImages.length) { %>
                                <div id="product-images-current" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                                    <% product.galleryImages.forEach((image, index) => { %>
                                        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                                            <input type="hidden" name="existingGalleryImages" value="<%= image %>">
                                            <div class="aspect-video bg-white">
                                                <img src="<%= image %>" alt="<%= product.name %> <%= index + 1 %>" class="h-full w-full object-cover">
                                            </div>
                                            <div class="px-3 py-2 text-xs font-semibold text-slate-500"><%= index === 0 ? 'Capa atual' : `Imagem ${index + 1}` %></div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                            <input id="product-images-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple class="w-full text-xs text-slate-500 file:mr-4 file:rounded-full file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100">
                            <div id="product-images-hidden-inputs" class="hidden"></div>
                            <p id="product-images-feedback" class="text-xs font-medium text-slate-500">Nenhuma nova imagem selecionada.</p>
                            <div id="product-images-preview" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
                            <p class="text-xs text-slate-400">Formatos aceitos: JPG, PNG, WEBP e GIF. Limite de 5 imagens. Você pode selecionar várias de uma vez ou adicionar em etapas.</p>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Link de Afiliado</label>
                        <input type="url" name="affiliateUrl" required value="<%= product.affiliateUrl %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div class="pt-4">
                        <label class="flex items-center space-x-3 text-sm font-bold text-slate-700 cursor-pointer p-4 bg-slate-50 rounded-xl border border-slate-100">
                            <input type="checkbox" name="active" <%= product.active ? 'checked' : '' %> class="w-5 h-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500">
                            <span>Produto visível na loja</span>
                        </label>
                    </div>
                    <div>
                        <label class="flex items-center space-x-3 text-sm font-bold text-slate-700 cursor-pointer p-4 bg-amber-50 rounded-xl border border-amber-100">
                            <input type="checkbox" name="featured" <%= product.featured ? 'checked' : '' %> class="w-5 h-5 text-amber-600 rounded border-slate-300 focus:ring-amber-500">
                            <span>Destacar na página inicial</span>
                        </label>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Descrição Completa</label>
                <input type="hidden" name="description" id="descriptionInput" required>
                <div id="productDescriptionEditor" class="rounded-xl border border-slate-200 bg-white min-h-[280px]"><%- product.description || '' %></div>
            </div>

            <div class="flex justify-end space-x-4 pt-4">
                <a href="/admin/loja" class="px-6 py-3 text-slate-600 font-bold text-sm">Cancelar</a>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-10 py-3 rounded-xl text-sm font-bold shadow-lg shadow-indigo-100">
                    Salvar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const descriptionEditor = new Quill('#productDescriptionEditor', {
        theme: 'snow',
        placeholder: 'Detalhes completos, benefícios e público-alvo do produto',
        modules: {
            toolbar: [
                [{ header: [1, 2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ color: [] }, { background: [] }],
                [{ list: 'ordered' }, { list: 'bullet' }],
                ['blockquote', 'link'],
                ['clean']
            ]
        }
    });
    const descriptionInput = document.getElementById('descriptionInput');
    descriptionInput.value = descriptionEditor.root.innerHTML;
    descriptionEditor.on('text-change', function () {
        descriptionInput.value = descriptionEditor.root.innerHTML;
    });

    const input = document.getElementById('product-images-input');
    const preview = document.getElementById('product-images-preview');
    const current = document.getElementById('product-images-current');
    const feedback = document.getElementById('product-images-feedback');
    const hiddenInputs = document.getElementById('product-images-hidden-inputs');

    if (!input || !preview || !hiddenInputs) return;

    let selectedFiles = [];

    function updateCurrentGalleryState() {
        if (!current) return;
        current.classList.toggle('opacity-40', selectedFiles.length > 0);
    }

    function renderSelectedFiles() {
        preview.innerHTML = '';
        feedback.textContent = selectedFiles.length
            ? `${selectedFiles.length} imagem(ns) nova(s) pronta(s) para envio. A galeria atual será substituída.`
            : 'Nenhuma nova imagem selecionada.';
        updateCurrentGalleryState();

        selectedFiles.forEach((file, index) => {
            if (!file.type.startsWith('image/')) return;

            const reader = new FileReader();
            reader.onload = function (event) {
                const card = document.createElement('div');
                card.className = 'overflow-hidden rounded-2xl border border-indigo-200 bg-indigo-50';
                card.innerHTML = `
                    <div class="aspect-video bg-white">
                        <img src="${event.target.result}" alt="Preview ${index + 1}" class="h-full w-full object-cover">
                    </div>
                    <div class="flex items-center justify-between gap-3 px-3 py-2">
                        <div class="text-xs font-semibold text-indigo-700">${index === 0 ? 'Nova capa' : `Nova imagem ${index + 1}`}</div>
                        <button type="button" data-remove-index="${index}" class="rounded-lg border border-indigo-200 bg-white px-2 py-1 text-[11px] font-semibold text-rose-600 transition hover:border-rose-200 hover:bg-rose-50">Remover</button>
                    </div>
                `;
                preview.appendChild(card);
            };
            reader.readAsDataURL(file);
        });

        preview.querySelectorAll('[data-remove-index]').forEach((button) => {
            button.addEventListener('click', function () {
                const removeIndex = Number(this.dataset.removeIndex);
                selectedFiles = selectedFiles.filter((_, index) => index !== removeIndex);
                syncInputFiles();
                renderSelectedFiles();
            });
        });
    }

    function syncHiddenInputs() {
        hiddenInputs.innerHTML = '';
        selectedFiles.forEach((file) => {
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);

            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'file';
            hiddenInput.name = 'product_images';
            hiddenInput.className = 'hidden';
            hiddenInput.files = dataTransfer.files;
            hiddenInputs.appendChild(hiddenInput);
        });
    }

    input.addEventListener('change', function () {
        const incomingFiles = Array.from(input.files || []).filter((file) => file.type.startsWith('image/'));

        incomingFiles.forEach((file) => {
            const alreadyAdded = selectedFiles.some((currentFile) =>
                currentFile.name === file.name
                && currentFile.size === file.size
                && currentFile.lastModified === file.lastModified
            );

            if (!alreadyAdded && selectedFiles.length < 5) {
                selectedFiles.push(file);
            }
        });

        syncHiddenInputs();
        renderSelectedFiles();
        input.value = '';
    });
});
</script>
