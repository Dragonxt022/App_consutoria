<div class="max-w-4xl mx-auto">
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
        <div class="bg-slate-50 p-6 border-b border-slate-100">
            <h2 class="text-xl font-bold text-slate-800">Cadastrar Produto da Loja</h2>
            <p class="text-slate-500 text-sm">Cadastre um produto afiliado e informe o link de compra da Hotmart.</p>
        </div>

        <form action="/admin/loja/criar" method="POST" class="p-8 space-y-8">
            <div class="grid md:grid-cols-2 gap-8">
                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Nome do Produto</label>
                        <input type="text" name="name" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Ex: Metodo Avancado de Gestao">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Descricao Curta</label>
                        <textarea name="shortDescription" rows="4" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Resumo comercial para a vitrine da loja"></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Preco</label>
                            <input type="text" name="price" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Ex: R$ 197,00">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Plataforma</label>
                            <input type="text" name="platform" value="Hotmart" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Categoria</label>
                        <input type="text" name="category" value="Geral" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Ex: Marketing, Gestao, Vendas">
                    </div>
                </div>

                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Galeria de Imagens</label>
                        <p class="mb-3 text-xs text-slate-400">Informe ate 5 URLs. A primeira imagem sera usada como capa principal.</p>
                        <div class="space-y-3">
                            <% for (let i = 0; i < 5; i++) { %>
                                <input type="url" name="galleryImages" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="URL da imagem <%= i + 1 %>">
                            <% } %>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Link de Afiliado</label>
                        <input type="url" name="affiliateUrl" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="https://go.hotmart.com/...">
                    </div>
                    <div class="pt-4">
                        <label class="flex items-center space-x-3 text-sm font-bold text-slate-700 cursor-pointer p-4 bg-slate-50 rounded-xl border border-slate-100">
                            <input type="checkbox" name="active" checked class="w-5 h-5 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500">
                            <span>Produto visivel na loja</span>
                        </label>
                    </div>
                    <div>
                        <label class="flex items-center space-x-3 text-sm font-bold text-slate-700 cursor-pointer p-4 bg-amber-50 rounded-xl border border-amber-100">
                            <input type="checkbox" name="featured" class="w-5 h-5 text-amber-600 rounded border-slate-300 focus:ring-amber-500">
                            <span>Destacar na pagina inicial</span>
                        </label>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Descricao Completa</label>
                <textarea name="description" rows="8" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="Detalhes completos, beneficios e publico-alvo do produto"></textarea>
            </div>

            <div class="flex justify-end space-x-4 pt-4">
                <a href="/admin/loja" class="px-6 py-3 text-slate-600 font-bold text-sm">Cancelar</a>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-10 py-3 rounded-xl text-sm font-bold shadow-lg shadow-indigo-100">
                    Salvar Produto
                </button>
            </div>
        </form>
    </div>
</div>
