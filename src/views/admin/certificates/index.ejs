<div class="space-y-8" x-data="{ showFilters: <%= (filters.search || filters.operationalStatus) ? 'true' : 'false' %> }">
    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <div class="border-b border-gray-100 bg-gray-50/50 p-6">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                    <div class="flex items-start gap-4">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-fuchsia-50 text-fuchsia-600 shadow-sm shadow-fuchsia-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Central de certificados</p>
                            <p class="mt-2 text-sm text-slate-500">Acompanhe cursos com alunos aptos, pendências de emissão e atalhos operacionais em um só lugar.</p>
                        </div>
                    </div>
                    <div class="flex w-full items-center gap-3 md:w-auto">
                        <button type="button" @click="showFilters = !showFilters" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900" :title="showFilters ? 'Ocultar filtros' : 'Mostrar filtros'">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 01.8 1.6L15 12v5a1 1 0 01-.553.894l-4 2A1 1 0 019 19v-7L3.2 4.6A1 1 0 013 4z"/>
                            </svg>
                        </button>
                        <a href="/admin/certificados/montar" class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white transition hover:bg-slate-700">
                            Montar Certificado
                        </a>
                    </div>
                </div>

                <form action="/admin/certificados" method="GET" class="w-full xl:max-w-5xl" x-show="showFilters" x-cloak x-transition>
                    <div class="grid gap-3 rounded-xl border border-gray-100 bg-white p-4 shadow-sm md:grid-cols-3 md:items-end">
                        <div class="md:col-span-2">
                            <label for="search" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Pesquisar</label>
                            <input id="search" type="text" name="search" placeholder="Buscar por curso ou local..." value="<%= filters.search || '' %>" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label for="operationalStatus" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Situação</label>
                            <select id="operationalStatus" name="operationalStatus" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                                <option value="">Todos</option>
                                <option value="aptos" <%= filters.operationalStatus === 'aptos' ? 'selected' : '' %>>Com alunos aptos</option>
                                <option value="pendencias" <%= filters.operationalStatus === 'pendencias' ? 'selected' : '' %>>Com pendências</option>
                                <option value="sem-aptos" <%= filters.operationalStatus === 'sem-aptos' ? 'selected' : '' %>>Sem aptos</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-2 md:col-span-3 md:flex-row">
                            <button type="submit" class="w-full rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white transition-colors hover:bg-indigo-700 md:w-auto">Buscar</button>
                            <% if (filters.search || filters.operationalStatus) { %>
                                <a href="/admin/certificados" class="w-full rounded-lg border border-slate-200 px-6 py-2.5 text-center text-sm font-semibold text-slate-500 transition-colors hover:bg-slate-50 md:w-auto">Limpar</a>
                            <% } %>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid gap-4 border-b border-slate-100 bg-white p-6 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-100 bg-slate-50 px-5 py-4">
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Cursos mapeados</p>
                <p class="mt-2 text-3xl font-black text-slate-900"><%= courses.length %></p>
            </div>
            <div class="rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4">
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-emerald-500">Alunos aptos</p>
                <p class="mt-2 text-3xl font-black text-emerald-700"><%= courses.reduce((sum, course) => sum + course.completedCount, 0) %></p>
            </div>
            <div class="rounded-2xl border border-amber-100 bg-amber-50 px-5 py-4">
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-amber-500">Pendências</p>
                <p class="mt-2 text-3xl font-black text-amber-700"><%= courses.reduce((sum, course) => sum + course.pendingActionCount, 0) %></p>
            </div>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <% if (!courses.length) { %>
            <div class="px-6 py-12 text-center text-slate-500">
                Nenhum curso encontrado para os filtros informados.
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-100 text-left">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Curso</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Situação</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Confirmados</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Concluídos</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Certificados</th>
                            <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% courses.forEach(course => { %>
                            <tr class="align-top hover:bg-slate-50/80">
                                <td class="px-6 py-5">
                                    <div>
                                        <p class="font-black text-slate-900"><%= course.title %></p>
                                        <p class="mt-1 text-sm text-slate-500"><%= course.location %></p>
                                        <p class="mt-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Carga: <%= course.workload %></p>
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <span class="inline-flex rounded-full px-3 py-1 text-[11px] font-black uppercase tracking-[0.18em] <%= course.operationalStatus === 'aptos' ? 'border border-emerald-200 bg-emerald-50 text-emerald-700' : course.operationalStatus === 'pendencias' ? 'border border-amber-200 bg-amber-50 text-amber-700' : 'border border-slate-200 bg-slate-50 text-slate-500' %>">
                                        <%= course.operationalStatus === 'aptos' ? 'Pronto para emissão' : course.operationalStatus === 'pendencias' ? 'Com pendências' : 'Sem aptos' %>
                                    </span>
                                </td>
                                <td class="px-6 py-5 text-sm font-black text-slate-900"><%= course.confirmedCount %></td>
                                <td class="px-6 py-5 text-sm font-black text-emerald-700"><%= course.completedCount %></td>
                                <td class="px-6 py-5 text-sm font-black text-indigo-700"><%= course.certificateCount %></td>
                                <td class="px-6 py-5">
                                    <div class="flex justify-end gap-2">
                                        <a href="/admin/inscricoes?courseId=<%= course.id %>&status=completo" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-indigo-700">
                                            Ver aptos
                                        </a>
                                        <a href="/admin/inscricoes?courseId=<%= course.id %>&status=confirmado" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
                                            Ver confirmados
                                        </a>
                                        <a href="/admin/inscricoes?courseId=<%= course.id %>" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
                                            Ir para inscrições
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>
