<%
    const months = ['Janeiro', 'Fevereiro', 'Marco', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
    const periodLabel = filters && filters.month ? `${months[filters.month - 1]} / ${filters.year}` : `Ano inteiro / ${filters ? filters.year : new Date().getFullYear()}`;
%>

<div class="space-y-10" x-data="{ showFilters: false }">
    <section class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-sm font-bold uppercase tracking-[0.25em] text-slate-400">Leitura do período</div>
                <p class="mt-2 text-sm text-slate-500">O dashboard principal agora resume o período selecionado, com visão anual por padrão.</p>
            </div>
            <div class="flex flex-col items-end gap-3">
                <div class="text-sm font-semibold text-slate-500"><%= periodLabel %></div>
                <button type="button" @click="showFilters = !showFilters" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900" :title="showFilters ? 'Ocultar filtros' : 'Mostrar filtros'">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 01.8 1.6L15 12v5a1 1 0 01-.553.894l-4 2A1 1 0 019 19v-7L3.2 4.6A1 1 0 013 4z"/>
                    </svg>
                </button>
                <form action="/admin/dashboard" method="GET" x-show="showFilters" x-cloak x-transition class="flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
                    <select name="month" class="rounded-xl border-slate-200 bg-slate-50 text-sm text-slate-700 focus:border-indigo-500 focus:ring-indigo-500">
                        <option value="" <%= !filters.month ? 'selected' : '' %>>Todos os meses</option>
                        <% months.forEach((m, index) => { %>
                            <option value="<%= index + 1 %>" <%= filters.month == (index + 1) ? 'selected' : '' %>><%= m %></option>
                        <% }) %>
                    </select>
                    <select name="year" class="rounded-xl border-slate-200 bg-slate-50 text-sm text-slate-700 focus:border-indigo-500 focus:ring-indigo-500">
                        <% filters.years.forEach((y) => { %>
                            <option value="<%= y %>" <%= filters.year == y ? 'selected' : '' %>><%= y %></option>
                        <% }) %>
                    </select>
                    <button type="submit" class="inline-flex items-center rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-indigo-700">
                        Aplicar
                    </button>
                </form>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
                <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Cursos</span>
            </div>
            <div class="text-3xl font-black text-slate-900"><%= stats.courses %></div>
            <p class="mt-1 text-sm text-slate-500"><%= stats.activeCourses %> ativos no site</p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
                <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Alunos</span>
            </div>
            <div class="text-3xl font-black text-slate-900"><%= stats.students %></div>
            <p class="mt-1 text-sm text-slate-500">Base total de alunos cadastrados</p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
                <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Pendencias</span>
            </div>
            <div class="text-3xl font-black text-slate-900"><%= stats.enrollments %></div>
            <p class="mt-1 text-sm text-slate-500">Pré-inscrições aguardando ação</p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
                <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Receita do Período</span>
            </div>
            <div class="text-3xl font-black text-slate-900">R$ <%= stats.monthlyRevenue.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></div>
            <p class="mt-1 text-sm text-slate-500"><%= periodLabel %></p>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Loja</div>
            <div class="mt-2 text-2xl font-black text-slate-900"><%= stats.products %></div>
            <p class="mt-1 text-sm text-slate-500"><%= stats.featuredProducts %> produtos em destaque</p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Conversão</div>
            <div class="mt-2 text-2xl font-black text-slate-900"><%= stats.confirmedSales %></div>
            <p class="mt-1 text-sm text-slate-500">Matrículas com pagamento confirmado</p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Operação</div>
            <div class="mt-2 text-2xl font-black text-slate-900"><%= stats.activeCourses %></div>
            <p class="mt-1 text-sm text-slate-500">Cursos ativos para captacao</p>
        </div>
    </section>

    <section>
        <h2 class="mb-5 text-xl font-bold text-slate-800">Ações Rápidas</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
            <a href="/admin/cursos/criar" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-indigo-600 p-3 text-white"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"></path></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Cadastrar curso</div>
                    <div class="text-sm text-slate-500">Criar um novo treinamento</div>
                </div>
            </a>
            <a href="/admin/inscricoes" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-amber-100 p-3 text-amber-600"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"></path></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Revisar inscrições</div>
                    <div class="text-sm text-slate-500">Atender pendencias rapidamente</div>
                </div>
            </a>
            <a href="/admin/usuarios" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-emerald-100 p-3 text-emerald-600"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-1a3 3 0 00-5.196-2.079M17 20H7"></path></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Gerenciar usuários</div>
                    <div class="text-sm text-slate-500">Editar acessos e status</div>
                </div>
            </a>
            <a href="/admin/vendas" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-rose-100 p-3 text-rose-600"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Abrir vendas</div>
                    <div class="text-sm text-slate-500">Acompanhar receita e ticket</div>
                </div>
            </a>
            <a href="/admin/loja" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-sky-100 p-3 text-sky-600"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4"></path></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Gerenciar loja</div>
                    <div class="text-sm text-slate-500">Produtos, links e destaque</div>
                </div>
            </a>
            <a href="/admin/configuracoes" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-slate-200 p-3 text-slate-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0"></path></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Configurações</div>
                    <div class="text-sm text-slate-500">Identidade, SMTP e loja</div>
                </div>
            </a>
            <a href="/admin/blog/novo" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-violet-100 p-3 text-violet-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H8a2 2 0 01-2-2V5a2 2 0 012-2h11m0 18a2 2 0 002-2V7m-2 14V7m0 0L15 3m4 4h-4a2 2 0 01-2-2V3m-5 6h5m-5 4h8m-8 4h8" /></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Novo post</div>
                    <div class="text-sm text-slate-500">Publicar conteúdo no blog</div>
                </div>
            </a>
            <a href="/admin/certidoes" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-cyan-100 p-3 text-cyan-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586A2 2 0 0114 3.586L18.414 8A2 2 0 0119 9.414V19a2 2 0 01-2 2z" /></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Certidões</div>
                    <div class="text-sm text-slate-500">Atualizar documentos públicos</div>
                </div>
            </a>
            <a href="/admin/certificados" class="group flex items-center rounded-2xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-300 hover:shadow-sm">
                <div class="mr-4 rounded-xl bg-emerald-100 p-3 text-emerald-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></div>
                <div>
                    <div class="font-bold text-slate-800 group-hover:text-indigo-600">Certificados</div>
                    <div class="text-sm text-slate-500">Gerar e revisar emissões</div>
                </div>
            </a>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-6 xl:grid-cols-[1.2fr_0.8fr]">
        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <div class="mb-5 flex items-center justify-between">
                <h2 class="text-lg font-bold text-slate-800">Últimas Inscrições</h2>
                <a href="/admin/inscricoes" class="text-sm font-bold text-indigo-600 hover:text-indigo-700">Abrir listagem</a>
            </div>
            <div class="space-y-4">
                <% if (recentEnrollments.length > 0) { %>
                    <% recentEnrollments.forEach((item) => { %>
                        <div class="flex items-center justify-between rounded-xl border border-slate-100 bg-slate-50 px-4 py-3">
                            <div>
                                <div class="font-semibold text-slate-800"><%= item.studentName %></div>
                                <div class="text-sm text-slate-500"><%= item.Course ? item.Course.title : 'Curso não encontrado' %></div>
                            </div>
                            <div class="text-right">
                                <div class="text-sm font-bold text-slate-700"><%= item.status %></div>
                                <div class="text-xs text-slate-400"><%= new Date(item.createdAt).toLocaleDateString('pt-BR') %></div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="rounded-xl border border-dashed border-slate-200 px-4 py-8 text-center text-sm text-slate-500">
                        Nenhuma inscrição recente encontrada.
                    </div>
                <% } %>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-slate-900 p-6 text-white shadow-sm">
            <div class="mb-5">
                <div class="text-xs font-bold uppercase tracking-[0.3em] text-slate-400">Resumo Operacional</div>
                <h2 class="mt-2 text-2xl font-black">Painel rapido</h2>
            </div>
            <div class="space-y-4">
                <div class="rounded-xl bg-white/5 p-4">
                    <div class="text-sm text-slate-400">Cursos ativos</div>
                    <div class="mt-1 text-2xl font-black"><%= stats.activeCourses %></div>
                </div>
                <div class="rounded-xl bg-white/5 p-4">
                    <div class="text-sm text-slate-400">Produtos em destaque</div>
                    <div class="mt-1 text-2xl font-black"><%= stats.featuredProducts %></div>
                </div>
                <div class="rounded-xl bg-white/5 p-4">
                    <div class="text-sm text-slate-400">Pré-inscrições pendentes</div>
                    <div class="mt-1 text-2xl font-black"><%= stats.enrollments %></div>
                </div>
            </div>
        </div>
    </section>
</div>
