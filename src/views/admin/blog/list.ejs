<div class="space-y-6">
    <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-md">
        <div class="flex flex-col items-start justify-between gap-4 border-b border-gray-100 bg-gray-50/50 p-4 md:flex-row md:items-center md:p-6">
            <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 shadow-sm shadow-indigo-100">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H8a2 2 0 01-2-2V5a2 2 0 012-2h11m0 18a2 2 0 002-2V7m-2 14V7m0 0L15 3m4 4h-4a2 2 0 01-2-2V3m-5 6h5m-5 4h8m-8 4h8" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Workflow editorial</p>
                    <p class="mt-2 text-xs md:text-sm text-gray-500">Total: <%= posts.length %> publicação(ões) entre rascunhos e conteúdos publicados.</p>
                </div>
            </div>
            <div class="flex w-full flex-col gap-3 md:w-auto md:flex-row md:items-center">
                <a href="/admin/blog/categorias" class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-700 hover:bg-slate-50">Categorias</a>
                <a href="/admin/blog/novo" class="flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-3 text-sm font-bold text-white transition-all shadow-lg shadow-indigo-100 hover:bg-indigo-700">
                    Criar novo
                </a>
            </div>
        </div>

        <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50">
                <tr class="text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                    <th class="px-6 py-4">Post</th>
                    <th class="px-6 py-4">Categoria</th>
                    <th class="px-6 py-4">Autor</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4">Atualizado</th>
                    <th class="px-6 py-4 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (!posts.length) { %>
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-slate-500">Nenhum post cadastrado ainda.</td>
                    </tr>
                <% } %>
                <% posts.forEach((post) => { %>
                    <tr class="align-top">
                        <td class="px-6 py-5">
                            <div class="flex items-start gap-4">
                                <div class="h-16 w-24 shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
                                    <% if (post.coverImage) { %>
                                        <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="block h-full w-full object-cover ">
                                    <% } %>
                                </div>
                                <div>
                                    <div class="font-semibold text-slate-900"><%= post.title %></div>
                                    <div class="mt-1 text-sm text-slate-500 line-clamp-2"><%= post.excerpt || 'Sem resumo informado.' %></div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-5 text-sm text-slate-600"><%= post.category ? post.category.name : 'Outros' %></td>
                        <td class="px-6 py-5 text-sm text-slate-600"><%= post.author ? post.author.name : 'Sem autor' %></td>
                        <td class="px-6 py-5">
                            <span class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider <%= post.status === 'publicado' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                                <%= post.status %>
                            </span>
                        </td>
                        <td class="px-6 py-5 text-sm text-slate-500"><%= new Date(post.updatedAt).toLocaleString('pt-BR') %></td>
                        <td class="px-6 py-5">
                            <div class="flex justify-end gap-2">
                                <a
                                    href="/admin/blog/<%= post.id %>/editar"
                                    class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-indigo-100 bg-indigo-50 text-indigo-600 transition hover:border-indigo-200 hover:bg-indigo-100 hover:text-indigo-700"
                                    title="Editar post"
                                    aria-label="Editar post"
                                >
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                </a>
                                <form action="/admin/blog/<%= post.id %>/deletar" method="POST" onsubmit="return confirm('Deseja remover este post?')">
                                    <button
                                        type="submit"
                                        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-rose-100 bg-rose-50 text-rose-600 transition hover:border-rose-200 hover:bg-rose-100 hover:text-rose-700"
                                        title="Excluir post"
                                        aria-label="Excluir post"
                                    >
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
