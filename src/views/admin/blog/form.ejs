<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">

<style>
    .blog-editor-shell {
        border: 1px solid rgb(226 232 240);
        background: #fff;
    }

    .blog-editor-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid rgb(226 232 240);
        background: rgb(248 250 252);
        padding: 0.875rem 1rem;
    }

    .blog-editor-toolbar .ql-toolbar {
        flex: 1;
        border: 0;
        padding: 0;
        background: transparent;
    }

    .blog-editor-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .blog-editor-actions button,
    .blog-editor-actions label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 2.5rem;
        padding: 0 1rem;
        border: 1px solid rgb(203 213 225);
        background: #fff;
        color: rgb(15 23 42);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
    }

    .blog-editor-actions button:hover,
    .blog-editor-actions label:hover {
        background: rgb(241 245 249);
    }

    .blog-editor-shell .ql-container {
        border: 0;
        font-size: 1rem;
        min-height: 520px;
    }

    .blog-editor-shell .ql-editor {
        min-height: 520px;
        line-height: 1.8;
        padding: 1.5rem;
    }

    .blog-editor-shell .ql-editor.ql-blank::before {
        left: 1.5rem;
        color: rgb(148 163 184);
        font-style: normal;
    }

    .blog-editor-shell.is-fullscreen {
        position: fixed;
        inset: 1rem;
        z-index: 90;
        display: flex;
        flex-direction: column;
        box-shadow: 0 30px 90px rgba(15, 23, 42, 0.28);
    }

    .blog-editor-shell.is-fullscreen .ql-container,
    .blog-editor-shell.is-fullscreen .ql-editor {
        min-height: calc(100vh - 12rem);
        height: calc(100vh - 12rem);
    }

    .blog-editor-overlay {
        position: fixed;
        inset: 0;
        z-index: 80;
        background: rgba(15, 23, 42, 0.48);
        backdrop-filter: blur(2px);
    }

    .blog-editor-upload-state {
        position: absolute;
        top: 1rem;
        right: 1rem;
        z-index: 12;
        display: none;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: rgba(15, 23, 42, 0.88);
        color: #fff;
        box-shadow: 0 16px 45px rgba(15, 23, 42, 0.24);
    }

    .blog-editor-upload-state.is-visible {
        display: inline-flex;
    }

    .blog-editor-upload-spinner {
        width: 1.1rem;
        height: 1.1rem;
        border: 2px solid rgba(255, 255, 255, 0.25);
        border-top-color: #fff;
        border-radius: 9999px;
        animation: blog-editor-spin 0.9s linear infinite;
    }

    .blog-editor-upload-copy {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .blog-editor-upload-copy strong {
        font-size: 0.82rem;
        line-height: 1.1;
    }

    .blog-editor-upload-copy span {
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.72);
    }

    .blog-editor-context-menu {
        position: fixed;
        z-index: 95;
        display: none;
        min-width: 15rem;
        border: 1px solid rgb(226 232 240);
        background: #fff;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);
        padding: 0.75rem;
    }

    .blog-editor-context-menu.is-open {
        display: block;
    }

    .blog-editor-context-menu-header {
        margin-bottom: 0.65rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgb(100 116 139);
    }

    .blog-editor-context-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
    }

    .blog-editor-context-grid button,
    .blog-editor-context-grid label {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 2.5rem;
        border: 1px solid rgb(226 232 240);
        background: rgb(248 250 252);
        color: rgb(15 23 42);
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0.45rem 0.35rem;
        gap: 0.3rem;
    }

    .blog-editor-context-grid button:hover,
    .blog-editor-context-grid label:hover {
        background: rgb(241 245 249);
    }

    .blog-editor-context-grid input[type="color"] {
        width: 2rem;
        height: 2rem;
        border: 0;
        background: transparent;
        padding: 0;
        cursor: pointer;
    }

    .blog-editor-context-grid svg {
        width: 1rem;
        height: 1rem;
    }

    .blog-editor-context-label {
        line-height: 1;
    }

    @keyframes blog-editor-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (max-width: 1024px) {
        .blog-editor-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .blog-editor-actions {
            justify-content: space-between;
        }

        .blog-editor-shell .ql-container,
        .blog-editor-shell .ql-editor {
            min-height: 420px;
        }
    }
</style>

<div class="space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-slate-900"><%= formMode === 'create' ? 'Criar novo post' : 'Editar post' %></h2>
            <p class="text-sm text-slate-500">Editor com suporte a imagens no corpo, atalho contextual e modo tela cheia.</p>
        </div>
        <div id="autosaveStatus" class="text-sm text-slate-400">
            <%= post.status === 'publicado' ? 'Autosave desativado para posts publicados.' : 'Rascunho automático a cada 2 minutos.' %>
        </div>
    </div>

    <form id="blogForm" action="<%= formMode === 'create' ? '/admin/blog/criar' : `/admin/blog/${post.id}/editar` %>" method="POST" enctype="multipart/form-data" class="grid gap-6 xl:grid-cols-[1.3fr_0.7fr]">
        <div class="space-y-6">
            <div class="border border-slate-200 bg-white p-6 shadow-sm">
                <div class="space-y-5">
                    <div>
                        <label class="mb-2 block text-sm font-medium text-slate-700">Título</label>
                        <input type="text" name="title" id="title" value="<%= post.title || '' %>" class="w-full border border-slate-200 px-4 py-3" required>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-slate-700">Resumo</label>
                        <textarea name="excerpt" id="excerpt" rows="4" class="w-full border border-slate-200 px-4 py-3"><%= post.excerpt || '' %></textarea>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-slate-700">Conteúdo</label>
                        <div id="editorOverlay" class="blog-editor-overlay hidden"></div>
                        <div id="editorShell" class="blog-editor-shell">
                            <div id="editorUploadState" class="blog-editor-upload-state" aria-live="polite">
                                <div class="blog-editor-upload-spinner"></div>
                                <div class="blog-editor-upload-copy">
                                    <strong>Processando imagens</strong>
                                    <span id="editorUploadStateText">Enviando arquivos para o editor...</span>
                                </div>
                            </div>
                            <div class="blog-editor-toolbar">
                                <div id="editorToolbar">
                                    <span class="ql-formats">
                                        <select class="ql-header">
                                            <option selected></option>
                                            <option value="1"></option>
                                            <option value="2"></option>
                                            <option value="3"></option>
                                        </select>
                                        <select class="ql-font"></select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-bold"></button>
                                        <button class="ql-italic"></button>
                                        <button class="ql-underline"></button>
                                        <button class="ql-strike"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <select class="ql-color"></select>
                                        <select class="ql-background"></select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-blockquote"></button>
                                        <button class="ql-link"></button>
                                        <button class="ql-image"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-list" value="ordered"></button>
                                        <button class="ql-list" value="bullet"></button>
                                        <button class="ql-clean"></button>
                                    </span>
                                </div>
                                <div class="blog-editor-actions">
                                    <label for="bodyImageInput">
                                        Inserir imagens
                                    </label>
                                    <button type="button" id="editorFullscreenToggle">
                                        Tela cheia
                                    </button>
                                </div>
                            </div>
                            <div id="editor"><%- post.content || '' %></div>
                        </div>
                        <input type="hidden" name="content" id="content">
                        <input type="file" id="bodyImageInput" accept="image/*" multiple class="hidden">
                        <div id="editorContextMenu" class="blog-editor-context-menu">
                            <div class="blog-editor-context-menu-header">Atalhos do editor</div>
                            <div class="blog-editor-context-grid">
                                <button type="button" data-editor-action="bold" title="Negrito">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 5h6a4 4 0 010 8H7zm0 8h8a4 4 0 000-8H7z"/></svg>
                                    <span class="blog-editor-context-label">Negrito</span>
                                </button>
                                <button type="button" data-editor-action="italic" title="Itálico">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5h6M5 19h6m1-14l-4 14"/></svg>
                                    <span class="blog-editor-context-label">Itálico</span>
                                </button>
                                <button type="button" data-editor-action="underline" title="Sublinhar">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4v6a6 6 0 0012 0V4M4 20h16"/></svg>
                                    <span class="blog-editor-context-label">Linha</span>
                                </button>
                                <button type="button" data-editor-action="header" data-editor-value="2" title="Título">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6v12M20 6v12M4 12h16"/></svg>
                                    <span class="blog-editor-context-label">Título</span>
                                </button>
                                <button type="button" data-editor-action="blockquote" title="Citação">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 10H6V6h4zm8 0h-4V6h4zM10 18H6v-4h4zm8 0h-4v-4h4z"/></svg>
                                    <span class="blog-editor-context-label">Citação</span>
                                </button>
                                <button type="button" data-editor-action="link" title="Link">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-1.414 1.414a4 4 0 01-5.657-5.657l1.414-1.414m3.536-1.414a4 4 0 015.657 5.657l-1.414 1.414a4 4 0 01-5.657-5.657"/></svg>
                                    <span class="blog-editor-context-label">Link</span>
                                </button>
                                <label>
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 010-8 4 4 0 014 4 4 4 0 104 4h2"/></svg>
                                    <input type="color" id="contextColorInput" value="#1d4ed8">
                                    <span class="blog-editor-context-label">Cor</span>
                                </label>
                                <button type="button" id="contextAddImagesButton" title="Imagens">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4-4 4 4 4-6 4 6M4 6h16v12H4z"/></svg>
                                    <span class="blog-editor-context-label">Imagens</span>
                                </button>
                                <button type="button" data-editor-action="clean" title="Limpar formato">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M9 6h10l-4 5v7H9V6zM5 18h6"/></svg>
                                    <span class="blog-editor-context-label">Limpar</span>
                                </button>
                            </div>
                        </div>
                        <p class="mt-2 text-xs text-slate-500">Clique com o botão direito dentro do texto para abrir atalhos de formatação sem voltar ao topo.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="border border-slate-200 bg-white p-6 shadow-sm">
                <h3 class="text-lg font-semibold text-slate-900">Publicação</h3>
                <div class="mt-5 space-y-4">
                    <div>
                        <label class="mb-2 block text-sm font-medium text-slate-700">Status</label>
                        <select name="status" id="status" class="w-full border border-slate-200 px-4 py-3">
                            <option value="rascunho" <%= post.status === 'rascunho' ? 'selected' : '' %>>Rascunho</option>
                            <option value="publicado" <%= post.status === 'publicado' ? 'selected' : '' %>>Publicado</option>
                        </select>
                        <p class="mt-2 text-xs text-slate-500">Todo novo post começa como rascunho.</p>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-slate-700">Categoria</label>
                        <select name="categoryId" id="categoryId" class="w-full border border-slate-200 px-4 py-3">
                            <% categories.forEach((category) => { %>
                                <option value="<%= category.id %>" <%= Number(post.categoryId) === Number(category.id) ? 'selected' : '' %>><%= category.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-slate-700">Autor</label>
                        <select name="authorId" id="authorId" class="w-full border border-slate-200 px-4 py-3">
                            <% authors.forEach((author) => { %>
                                <option value="<%= author.id %>" <%= Number(post.authorId) === Number(author.id) ? 'selected' : '' %>><%= author.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-slate-700">Foto de capa</label>
                        <input type="file" name="coverImage" accept="image/*" class="w-full border border-slate-200 px-4 py-3">
                        <% if (post.coverImage) { %>
                            <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="mt-4 h-48 w-full object-cover">
                            <label class="mt-3 flex items-center gap-2 text-sm text-slate-600">
                                <input type="checkbox" name="removeCoverImage">
                                Remover capa atual
                            </label>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex gap-3">
                    <a href="/admin/blog" class="flex-1 border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancelar</a>
                    <button type="submit" class="flex-1 bg-indigo-600 px-4 py-3 text-sm font-semibold text-white hover:bg-indigo-700">Salvar</button>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    const editorShell = document.getElementById('editorShell');
    const editorOverlay = document.getElementById('editorOverlay');
    const fullscreenToggle = document.getElementById('editorFullscreenToggle');
    const bodyImageInput = document.getElementById('bodyImageInput');
    const contextMenu = document.getElementById('editorContextMenu');
    const contextColorInput = document.getElementById('contextColorInput');
    const contextAddImagesButton = document.getElementById('contextAddImagesButton');
    const editorUploadState = document.getElementById('editorUploadState');
    const editorUploadStateText = document.getElementById('editorUploadStateText');

    const editor = new Quill('#editor', {
        theme: 'snow',
        placeholder: 'Escreva a matéria aqui...',
        modules: {
            toolbar: '#editorToolbar'
        }
    });

    const contentInput = document.getElementById('content');
    const form = document.getElementById('blogForm');
    const autosaveStatus = document.getElementById('autosaveStatus');
    const statusField = document.getElementById('status');
    let postId = <%= post.id ? post.id : 'null' %>;
    let autosaveEnabled = <%= post.status === 'publicado' ? 'false' : 'true' %>;
    let pendingSelection = null;

    function syncContent() {
        contentInput.value = editor.root.innerHTML;
    }

    function updateAutosaveMessage() {
        autosaveStatus.textContent = autosaveEnabled
            ? 'Rascunho automático ativo a cada 2 minutos.'
            : 'Autosave desativado para posts publicados.';
    }

    function setUploadState(isVisible, message = 'Enviando arquivos para o editor...') {
        editorUploadState.classList.toggle('is-visible', isVisible);
        editorUploadStateText.textContent = message;
    }

    function closeContextMenu() {
        contextMenu.classList.remove('is-open');
    }

    function applyFormat(action, value = true) {
        const range = editor.getSelection(true);
        if (!range) {
            editor.focus();
        }

        if (action === 'link') {
            const current = editor.getFormat(range || undefined).link || '';
            const url = window.prompt('Informe a URL do link:', current || 'https://');
            if (url) {
                editor.format('link', url);
            }
            return;
        }

        if (action === 'clean') {
            if (range && range.length > 0) {
                editor.removeFormat(range.index, range.length);
            }
            return;
        }

        editor.format(action, value);
    }

    async function uploadEditorImages(files) {
        if (!files.length) return [];

        const formData = new FormData();
        files.forEach((file) => formData.append('blog_image', file));

        const response = await fetch('/admin/blog/upload-imagem', {
            method: 'POST',
            body: formData
        });

        let data = null;
        try {
            data = await response.json();
        } catch (error) {
            if (!response.ok) {
                throw new Error('Nao foi possivel processar o upload das imagens.');
            }

            throw error;
        }

        if (!response.ok || !data.success || !Array.isArray(data.urls)) {
            throw new Error(data.message || 'Erro ao enviar imagens');
        }

        return data.urls;
    }

    async function insertImages(files) {
        const validFiles = Array.from(files || []);
        if (!validFiles.length) return;

        const uploadMessage = validFiles.length > 1 ? 'Enviando imagens…' : 'Enviando imagem…';
        autosaveStatus.textContent = uploadMessage;
        setUploadState(true, validFiles.length > 1 ? 'Enviando e preparando imagens no conteúdo...' : 'Enviando e preparando imagem no conteúdo...');

        try {
            const urls = await uploadEditorImages(validFiles);
            const selection = pendingSelection || editor.getSelection(true);
            let insertIndex = selection ? selection.index : editor.getLength();

            urls.forEach((url) => {
                editor.insertEmbed(insertIndex, 'image', url, 'user');
                insertIndex += 1;
                editor.insertText(insertIndex, '\n', 'user');
                insertIndex += 1;
            });

            editor.setSelection(Math.max(insertIndex - 1, 0), 0, 'silent');
            pendingSelection = null;
            autosaveStatus.textContent = urls.length > 1 ? 'Imagens enviadas com sucesso.' : 'Imagem enviada com sucesso.';
            syncContent();
        } catch (error) {
            pendingSelection = null;
            autosaveStatus.textContent = error.message;
        } finally {
            setUploadState(false);
            bodyImageInput.value = '';
        }
    }

    syncContent();
    updateAutosaveMessage();
    editor.on('text-change', syncContent);
    editor.on('selection-change', (range) => {
        if (range) {
            pendingSelection = range;
        }
    });

    editor.getModule('toolbar').addHandler('image', () => {
        pendingSelection = editor.getSelection(true) || pendingSelection;
        bodyImageInput.click();
    });

    bodyImageInput.addEventListener('change', () => {
        insertImages(bodyImageInput.files);
    });

    contextAddImagesButton.addEventListener('click', () => {
        pendingSelection = editor.getSelection(true) || pendingSelection;
        closeContextMenu();
        bodyImageInput.click();
    });

    contextColorInput.addEventListener('input', (event) => {
        applyFormat('color', event.target.value);
    });

    contextMenu.querySelectorAll('[data-editor-action]').forEach((button) => {
        button.addEventListener('click', () => {
            const { editorAction, editorValue } = button.dataset;
            applyFormat(editorAction, editorValue || true);
            closeContextMenu();
            editor.focus();
        });
    });

    editor.root.addEventListener('contextmenu', (event) => {
        event.preventDefault();
        const maxX = window.innerWidth - contextMenu.offsetWidth - 16;
        const maxY = window.innerHeight - contextMenu.offsetHeight - 16;

        contextMenu.style.left = `${Math.max(12, Math.min(event.clientX, maxX))}px`;
        contextMenu.style.top = `${Math.max(12, Math.min(event.clientY, maxY))}px`;
        contextMenu.classList.add('is-open');
    });

    document.addEventListener('click', (event) => {
        if (!contextMenu.contains(event.target)) {
            closeContextMenu();
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeContextMenu();
            if (editorShell.classList.contains('is-fullscreen')) {
                toggleFullscreen();
            }
        }
    });

    function toggleFullscreen() {
        const isFullscreen = editorShell.classList.toggle('is-fullscreen');
        editorOverlay.classList.toggle('hidden', !isFullscreen);
        document.body.classList.toggle('overflow-hidden', isFullscreen);
        fullscreenToggle.textContent = isFullscreen ? 'Sair da tela cheia' : 'Tela cheia';
    }

    fullscreenToggle.addEventListener('click', toggleFullscreen);
    editorOverlay.addEventListener('click', toggleFullscreen);

    statusField.addEventListener('change', () => {
        autosaveEnabled = statusField.value !== 'publicado';
        updateAutosaveMessage();
    });

    async function autoSave() {
        if (!autosaveEnabled) {
            updateAutosaveMessage();
            return;
        }

        syncContent();
        autosaveStatus.textContent = 'Salvando rascunho…';

        const payload = {
            title: document.getElementById('title').value,
            excerpt: document.getElementById('excerpt').value,
            content: contentInput.value,
            status: statusField.value,
            categoryId: document.getElementById('categoryId').value,
            authorId: document.getElementById('authorId').value
        };

        const response = await fetch(postId ? `/admin/blog/autosave/${postId}` : '/admin/blog/autosave/novo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.message || 'Erro ao salvar rascunho');
        }

        if (!postId && data.postId) {
            postId = data.postId;
            history.replaceState({}, '', `/admin/blog/${postId}/editar`);
            form.action = `/admin/blog/${postId}/editar`;
        }

        autosaveStatus.textContent = `Rascunho salvo em ${new Date(data.savedAt).toLocaleTimeString('pt-BR')}`;
    }

    setInterval(() => {
        autoSave().catch((error) => {
            autosaveStatus.textContent = error.message;
        });
    }, 120000);

    form.addEventListener('submit', syncContent);
</script>
