<div class="space-y-6">
    <div class="flex flex-col gap-2">
        <h2 class="text-2xl font-bold text-slate-900">Categorias do Blog</h2>
        <p class="text-sm text-slate-500">Organize as matérias por tema e mantenha a navegação pública do blog mais clara.</p>
    </div>

    <div class="grid gap-6 xl:grid-cols-[0.85fr_1.15fr]">
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-100 bg-slate-50 px-6 py-5">
                <h3 class="text-lg font-bold text-slate-900">Nova categoria</h3>
                <p class="mt-1 text-sm text-slate-500">Crie uma nova categoria para usar nas próximas publicações.</p>
            </div>

            <form action="/admin/blog/categorias/criar" method="POST" class="space-y-5 p-6">
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">Nome</label>
                    <input type="text" name="name" class="w-full rounded-2xl border border-slate-200 px-4 py-3" required>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">Descrição</label>
                    <textarea name="description" rows="5" class="w-full rounded-2xl border border-slate-200 px-4 py-3" placeholder="Ex.: publicações sobre controle interno, eventos ou gestão."></textarea>
                </div>
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white hover:bg-indigo-700">
                    Salvar categoria
                </button>
            </form>
        </div>

        <div class="space-y-4">
            <% categories.forEach((category) => { %>
                <form action="/admin/blog/categorias/<%= category.id %>/editar" method="POST" class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
                    <div class="flex flex-col gap-4 border-b border-slate-100 bg-slate-50 px-6 py-5 md:flex-row md:items-start md:justify-between">
                        <div>
                            <div class="flex flex-wrap items-center gap-3">
                                <h3 class="text-lg font-bold text-slate-900"><%= category.name %></h3>
                                <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wider <%= category.active ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>">
                                    <%= category.active ? 'Ativa' : 'Inativa' %>
                                </span>
                                <% if (category.slug === 'outros') { %>
                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-indigo-700">Padrão</span>
                                <% } %>
                            </div>
                            <p class="mt-2 text-sm text-slate-500"><%= category.posts ? category.posts.length : 0 %> posts vinculados</p>
                        </div>

                        <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-600">
                            <input type="checkbox" name="active" <%= category.active ? 'checked' : '' %> <%= category.slug === 'outros' ? 'disabled' : '' %>>
                            Categoria ativa
                        </label>
                    </div>

                    <div class="grid gap-5 p-6 md:grid-cols-[0.9fr_1.1fr_auto] md:items-end">
                        <div>
                            <label class="mb-2 block text-sm font-medium text-slate-700">Nome</label>
                            <input type="text" name="name" value="<%= category.name %>" class="w-full rounded-2xl border border-slate-200 px-4 py-3" required>
                        </div>
                        <div>
                            <label class="mb-2 block text-sm font-medium text-slate-700">Descrição</label>
                            <textarea name="description" rows="3" class="w-full rounded-2xl border border-slate-200 px-4 py-3"><%= category.description || '' %></textarea>
                        </div>
                        <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                            Atualizar
                        </button>
                    </div>
                </form>
            <% }) %>
        </div>
    </div>
</div>
