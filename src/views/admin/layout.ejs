<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Painel Administrativo</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script src="/vendor/numeral.min.js"></script>
    <script src="/vendor/numeral.pt-br.js"></script>
    <script src="/js/currency-fields.js"></script>

    <style>
        body { font-family: 'Inter', sans-serif; overflow-x: hidden; }
        .sidebar-group-title {
            color: #94a3b8;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
        .sidebar-link-active {
            background-color: #eef2ff;
            color: #0f172a;
        }
        .sidebar-link-active svg {
            color: #4f46e5;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .scrollbar-hide::-webkit-scrollbar {
            width: 0;
            height: 0;
            display: none;
        }
        [x-cloak] {
            display: none !important;
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen" x-data="{ mobileSidebarOpen: false, desktopSidebarCollapsed: localStorage.getItem('adminSidebarCollapsed') === 'true', sidebarCollapsed: window.innerWidth >= 768 ? (localStorage.getItem('adminSidebarCollapsed') === 'true') : false, toastVisible: <%= toast ? 'true' : 'false' %>, notificationsOpen: false }" x-init="window.addEventListener('resize', () => { const isDesktop = window.innerWidth >= 768; sidebarCollapsed = isDesktop ? desktopSidebarCollapsed : false; if (isDesktop) mobileSidebarOpen = false; }); $watch('mobileSidebarOpen', value => document.body.classList.toggle('overflow-hidden', value)); $watch('desktopSidebarCollapsed', value => { localStorage.setItem('adminSidebarCollapsed', value); if (window.innerWidth >= 768) sidebarCollapsed = value; }); if (toastVisible) { setTimeout(() => toastVisible = false, 3500); }" @keydown.window.escape="mobileSidebarOpen = false; notificationsOpen = false">
    <div class="flex min-h-screen">
        <div
            x-cloak
            x-show="mobileSidebarOpen"
            x-transition.opacity
            class="fixed inset-0 z-40 bg-slate-950/60 md:hidden"
            @click="mobileSidebarOpen = false"
        ></div>

        <aside
            x-cloak
            x-show="mobileSidebarOpen || window.innerWidth >= 768"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="-translate-x-full opacity-0"
            x-transition:enter-end="translate-x-0 opacity-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="translate-x-0 opacity-100"
            x-transition:leave-end="-translate-x-full opacity-0"
            class="fixed inset-y-0 left-0 z-50 flex w-[18.5rem] max-w-[88vw] flex-col border-r border-slate-200 bg-white text-slate-600 shadow-2xl md:max-w-none md:translate-x-0 md:shadow-none"
            x-bind:class="sidebarCollapsed ? 'md:w-24' : 'md:w-64'"
        >
            <div class="border-b border-slate-200 bg-white px-4 py-4">
                <div class="flex items-center justify-between gap-3 md:justify-center">
                    <a href="/" class="group flex min-w-0 items-center justify-center">
                    <% if (siteSettings.use_logo === 'true' && siteSettings.logo_url) { %>
                        <img
                            src="<%= siteSettings.logo_url %>"
                            alt="<%= siteSettings.site_name %>"
                            class="h-10 w-auto object-contain transition duration-200 group-hover:scale-105"
                            :class="sidebarCollapsed ? 'max-w-[48px]' : 'max-w-[144px]'"
                            onerror="this.style.display='none'"
                        >
                    <% } else { %>
                        <div class="bg-indigo-600 p-2 rounded transform transition duration-200 group-hover:rotate-6 group-hover:scale-110">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        <span x-show="!sidebarCollapsed" x-transition.opacity class="ml-3 text-xl font-bold text-slate-900 uppercase tracking-wider group-hover:text-indigo-600 transition-colors"><%= siteSettings.site_name %></span>
                    <% } %>
                    </a>
                    <button
                        type="button"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-600 transition hover:bg-slate-100 md:hidden"
                        @click="mobileSidebarOpen = false"
                        aria-label="Fechar menu lateral"
                    >
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <nav class="mt-6 flex-1 overflow-y-auto px-4 pb-8 scrollbar-hide">
                <p class="sidebar-group-title" x-show="!sidebarCollapsed">Início</p>
                <div class="space-y-1 mb-4">
                    <a href="/admin/dashboard" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= title === 'Dashboard' ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Dashboard' : ''">
                        <svg class="h-6 w-6 <%= title === 'Dashboard' ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span x-show="!sidebarCollapsed">Dashboard</span>
                    </a>
                </div>

                <p class="sidebar-group-title" x-show="!sidebarCollapsed">Gestão</p>
                <div class="space-y-1 mb-4">
                    <a href="/admin/inscricoes" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= title === 'Gestão de Inscrições' ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Inscrições' : ''">
                        <svg class="h-6 w-6 <%= title === 'Gestão de Inscrições' ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                        <span x-show="!sidebarCollapsed">Inscrições</span>
                    </a>

                    <a href="/admin/vendas" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= title === 'Dashboard de Vendas' ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Vendas' : ''">
                        <svg class="h-6 w-6 <%= title === 'Dashboard de Vendas' ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span x-show="!sidebarCollapsed">Vendas</span>
                    </a>

                    <a href="/admin/usuarios" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= ['Usuarios', 'Editar Usuario'].includes(title) ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Usuários' : ''">
                        <svg class="h-6 w-6 <%= ['Usuarios', 'Editar Usuario'].includes(title) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-1a3 3 0 00-5.196-2.079M17 20H7m10 0v-1c0-.653-.126-1.277-.355-1.848M7 20H2v-1a3 3 0 015.196-2.079M7 20v-1c0-.653.126-1.277.355-1.848m0 0a5.002 5.002 0 019.29 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span x-show="!sidebarCollapsed">Usuários</span>
                    </a>

                    <a href="/admin/loja" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= ['Loja', 'Cadastrar Produto', 'Editar Produto'].includes(title) ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Loja' : ''">
                        <svg class="h-6 w-6 <%= ['Loja', 'Cadastrar Produto', 'Editar Produto'].includes(title) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m1.6 8L5.4 5M7 13l-1.293 6.293A1 1 0 006.683 21h10.634a1 1 0 00.976-1.293L17 13M9 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"></path>
                        </svg>
                        <span x-show="!sidebarCollapsed">Loja</span>
                    </a>

                    <a href="/admin/certidoes" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= ['Certidoes', 'Cadastrar Certidao', 'Editar Certidao'].includes(title) ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Certidões' : ''">
                        <svg class="h-6 w-6 <%= ['Certidoes', 'Cadastrar Certidao', 'Editar Certidao'].includes(title) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586A2 2 0 0114 3.586L18.414 8A2 2 0 0119 9.414V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span x-show="!sidebarCollapsed">Certidões</span>
                    </a>

                    <div x-show="!sidebarCollapsed" x-data="{ open: <%= ['Blog', 'Criar Novo Post', 'Editar Post', 'Categorias do Blog'].includes(title) ? 'true' : 'false' %> }">
                        <button @click="open = !open" class="w-full flex items-center px-3 py-3 text-sm font-medium rounded-lg hover:bg-slate-100 hover:text-slate-900 transition-colors justify-between <%= ['Blog', 'Criar Novo Post', 'Editar Post', 'Categorias do Blog'].includes(title) ? 'sidebar-link-active' : '' %>">
                            <div class="flex items-center">
                                <svg class="mr-3 h-6 w-6 <%= ['Blog', 'Criar Novo Post', 'Editar Post', 'Categorias do Blog'].includes(title) ? 'text-indigo-500' : 'text-slate-400 group-hover:text-indigo-500' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H8a2 2 0 01-2-2V5a2 2 0 012-2h11m0 18a2 2 0 002-2V7m-2 14V7m0 0L15 3m4 4h-4a2 2 0 01-2-2V3m-5 6h5m-5 4h8m-8 4h8" />
                                </svg>
                                <span>Blog</span>
                            </div>
                            <svg :class="open ? 'rotate-180' : ''" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>

                        <div x-show="open" x-collapse class="pl-12 space-y-1 mt-1" style="display: none;">
                            <a href="/admin/blog" class="block py-2 text-sm hover:text-indigo-400 transition-colors <%= title === 'Blog' ? 'text-indigo-400 font-medium' : '' %>">Lista</a>
                            <a href="/admin/blog/novo" class="block py-2 text-sm hover:text-indigo-400 transition-colors <%= ['Criar Novo Post', 'Editar Post'].includes(title) ? 'text-indigo-400 font-medium' : '' %>">Criar novo</a>
                            <a href="/admin/blog/categorias" class="block py-2 text-sm hover:text-indigo-400 transition-colors <%= title === 'Categorias do Blog' ? 'text-indigo-400 font-medium' : '' %>">Categorias</a>
                        </div>
                    </div>
                    <a x-show="sidebarCollapsed" x-cloak href="/admin/blog" class="group flex items-center justify-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= ['Blog', 'Criar Novo Post', 'Editar Post', 'Categorias do Blog'].includes(title) ? 'sidebar-link-active' : '' %>" title="Blog">
                        <svg class="h-6 w-6 <%= ['Blog', 'Criar Novo Post', 'Editar Post', 'Categorias do Blog'].includes(title) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H8a2 2 0 01-2-2V5a2 2 0 012-2h11m0 18a2 2 0 002-2V7m-2 14V7m0 0L15 3m4 4h-4a2 2 0 01-2-2V3m-5 6h5m-5 4h8m-8 4h8" />
                        </svg>
                    </a>

                    <div x-show="!sidebarCollapsed" x-data="{ open: <%= ['Listar Cursos', 'Cadastrar Curso', 'Editar Curso'].includes(title) ? 'true' : 'false' %> }">
                        <button @click="open = !open" class="w-full flex items-center px-3 py-3 text-sm font-medium rounded-lg hover:bg-slate-100 hover:text-slate-900 transition-colors justify-between <%= ['Listar Cursos', 'Cadastrar Curso', 'Editar Curso'].includes(title) ? 'sidebar-link-active' : '' %>">
                            <div class="flex items-center">
                                <svg class="mr-3 h-6 w-6 <%= ['Listar Cursos', 'Cadastrar Curso', 'Editar Curso'].includes(title) ? 'text-indigo-500' : 'text-slate-400 group-hover:text-indigo-500' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                                <span>Cursos</span>
                            </div>
                            <svg :class="open ? 'rotate-180' : ''" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>

                        <div x-show="open" x-collapse class="pl-12 space-y-1 mt-1" style="display: none;">
                            <a href="/admin/cursos" class="block py-2 text-sm hover:text-indigo-400 transition-colors <%= title === 'Listar Cursos' ? 'text-indigo-400 font-medium' : '' %>">
                                Listar
                            </a>
                            <a href="/admin/cursos/criar" class="block py-2 text-sm hover:text-indigo-400 transition-colors <%= ['Cadastrar Curso', 'Editar Curso'].includes(title) ? 'text-indigo-400 font-medium' : '' %>">
                                Cadastrar
                            </a>
                        </div>
                    </div>
                    <a x-show="sidebarCollapsed" x-cloak href="/admin/cursos" class="group flex items-center justify-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= ['Listar Cursos', 'Cadastrar Curso', 'Editar Curso'].includes(title) ? 'sidebar-link-active' : '' %>" title="Cursos">
                        <svg class="h-6 w-6 <%= ['Listar Cursos', 'Cadastrar Curso', 'Editar Curso'].includes(title) ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </a>
                </div>

                <p class="sidebar-group-title" x-show="!sidebarCollapsed">Ferramentas</p>
                <div class="space-y-1 mb-4">
                    <a href="/admin/certificados" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= title === 'Gerador de Certificados' ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Certificados' : ''">
                        <svg class="h-6 w-6 <%= title === 'Gerador de Certificados' ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span x-show="!sidebarCollapsed">Certificados</span>
                    </a>
                    <a href="/admin/certificados/montar" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= title === 'Montar Certificado' ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Montar Certificado' : ''">
                        <svg class="h-6 w-6 <%= title === 'Montar Certificado' ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2zm3 4h4m-5 4h6m-6 4h6" />
                        </svg>
                        <span x-show="!sidebarCollapsed">Montar Certificado</span>
                    </a>
                </div>

                <p class="sidebar-group-title" x-show="!sidebarCollapsed">Sistema</p>
                <div class="space-y-1">
                    <a href="/admin/configuracoes" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= title === 'Configurações do Site' ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Configurações' : ''">
                        <svg class="h-6 w-6 <%= title === 'Configurações do Site' ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        </svg>
                        <span x-show="!sidebarCollapsed">Configurações</span>
                    </a>

                    <a href="/admin/perfil" class="group flex items-center rounded-lg px-3 py-3 text-sm font-medium transition-colors hover:bg-slate-100 hover:text-slate-900 <%= title === 'Perfil do Administrador' ? 'sidebar-link-active' : '' %>" :class="sidebarCollapsed ? 'justify-center' : ''" :title="sidebarCollapsed ? 'Meu Perfil' : ''">
                        <svg class="h-6 w-6 <%= title === 'Perfil do Administrador' ? 'text-indigo-600' : 'text-slate-400 group-hover:text-indigo-600' %>" :class="sidebarCollapsed ? '' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A9 9 0 1118.88 17.8M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span x-show="!sidebarCollapsed">Meu Perfil</span>
                    </a>
                </div>
            </nav>

            <div class="border-t border-slate-200 p-4">
                <a href="/logout" class="flex items-center px-3 py-2 text-rose-600 transition-colors hover:bg-rose-50 hover:text-rose-700 rounded-lg" :class="sidebarCollapsed ? 'justify-center' : 'space-x-3'" :title="sidebarCollapsed ? 'Sair' : ''">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                    <span x-show="!sidebarCollapsed">Sair</span>
                </a>
            </div>
        </aside>

        <main class="flex-grow p-4 transition-all duration-300 sm:p-6 md:p-8" :class="desktopSidebarCollapsed ? 'md:ml-24' : 'md:ml-64'">
            <% if (toast) { %>
                <div
                    x-cloak
                    x-show="toastVisible"
                    x-transition:enter="transform transition ease-out duration-300"
                    x-transition:enter-start="translate-x-12 opacity-0"
                    x-transition:enter-end="translate-x-0 opacity-100"
                    x-transition:leave="transform transition ease-in duration-200"
                    x-transition:leave-start="translate-x-0 opacity-100"
                    x-transition:leave-end="translate-x-12 opacity-0"
                    class="fixed right-4 top-4 z-[70] w-[min(24rem,calc(100vw-2rem))] overflow-hidden rounded-2xl border shadow-2xl <%= toast.type === 'error' ? 'border-rose-200 bg-rose-50 text-rose-900' : 'border-emerald-200 bg-emerald-50 text-emerald-900' %>"
                >
                    <div class="flex items-start gap-3 p-4">
                        <div class="mt-0.5 rounded-xl p-2 <%= toast.type === 'error' ? 'bg-rose-100 text-rose-600' : 'bg-emerald-100 text-emerald-600' %>">
                            <% if (toast.type === 'error') { %>
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <% } else { %>
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            <% } %>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-bold uppercase tracking-wider opacity-70"><%= toast.type === 'error' ? 'Erro' : 'Sucesso' %></p>
                            <p class="mt-1 text-sm font-medium leading-relaxed"><%= toast.message %></p>
                        </div>
                        <button type="button" @click="toastVisible = false" class="rounded-lg p-1 text-slate-400 transition hover:bg-white/70 hover:text-slate-600">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                        </button>
                    </div>
                </div>
            <% } %>
            <header class="mb-8 sm:mb-10">
                <div class="flex items-start justify-between gap-4">
                    <div class="flex items-start gap-3">
                        <button
                            type="button"
                            class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 md:hidden"
                            @click="mobileSidebarOpen = true"
                            aria-label="Abrir menu lateral"
                        >
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>
                        <button
                            type="button"
                            class="hidden h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 md:inline-flex"
                            @click="desktopSidebarCollapsed = !desktopSidebarCollapsed"
                            :aria-label="desktopSidebarCollapsed ? 'Expandir menu lateral' : 'Recolher menu lateral'"
                        >
                            <svg x-show="!desktopSidebarCollapsed" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                            <svg x-show="desktopSidebarCollapsed" x-cloak class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>

                        <div>
                            <h1 class="text-2xl font-bold text-slate-800"><%= title %></h1>
                            <p class="text-slate-500 text-sm">Bem-vindo, <%= user.name %></p>
                        </div>
                    </div>

                    <div class="relative flex items-center gap-3" @click.outside="notificationsOpen = false">
                        <a
                            href="/admin/perfil"
                            class="group flex items-center space-x-3 rounded-2xl px-2 py-1 transition hover:bg-white/70 sm:space-x-4"
                            aria-label="Ir para meu perfil"
                            title="Meu perfil"
                        >
                            <div class="text-right hidden sm:block">
                                <p class="text-xs font-bold text-indigo-600 uppercase tracking-tighter">Administrador</p>
                                <p class="text-slate-900 text-sm font-medium transition group-hover:text-indigo-700"><%= user.name %></p>
                            </div>
                            <img class="h-10 w-10 rounded-full border-2 border-white shadow-sm object-cover transition group-hover:scale-105 group-hover:shadow-md" src="<%= user.avatar ? user.avatar : ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=4f46e5&color=fff') %>" alt="Avatar de <%= user.name %>">
                        </a>

                        <button
                            type="button"
                            class="relative inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-indigo-600"
                            @click="notificationsOpen = !notificationsOpen"
                            aria-label="Abrir notificações"
                            title="Notificações"
                        >
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                            <% if (adminNotificationUnreadCount > 0) { %>
                                <span class="absolute right-0 top-0 inline-flex h-5 min-w-5 translate-x-1/4 -translate-y-1/4 items-center justify-center rounded-full border-2 border-white bg-indigo-600 px-1 text-[10px] font-black leading-none text-white shadow-sm whitespace-nowrap">
                                    <%= adminNotificationUnreadCount > 99 ? '99+' : adminNotificationUnreadCount %>
                                </span>
                            <% } %>
                        </button>

                        <div
                            x-cloak
                            x-show="notificationsOpen"
                            x-transition.opacity.scale.origin.top.right
                            class="absolute right-0 top-full z-50 mt-3 h-[30rem] w-[min(22rem,calc(100vw-1.5rem))] overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl"
                        >
                            <div class="border-b border-slate-100 px-4 py-4">
                                <div class="flex items-center justify-between gap-3">
                                    <div>
                                        <p class="text-[13px] font-bold text-slate-900">Notificações</p>
                                        <p class="mt-1 text-[11px] leading-5 text-slate-500">Últimos alertas do painel administrativo.</p>
                                    </div>
                                    <% if (adminNotificationUnreadCount > 0) { %>
                                        <span class="inline-flex min-h-10 min-w-[5.75rem] flex-col items-center justify-center rounded-full bg-indigo-600 px-3 py-1 text-white shadow-sm">
                                            <span class="text-base font-black leading-none"><%= adminNotificationUnreadCount %></span>
                                            <span class="mt-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-indigo-100">nova(s)</span>
                                        </span>
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <% if (!adminNotificationsTray.length) { %>
                                <div class="flex h-[calc(30rem-5.5rem)] items-center justify-center px-4 py-9 text-center">
                                    <div>
                                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                                        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                                        </svg>
                                    </div>
                                    <p class="mt-4 text-sm font-semibold text-slate-700">Nenhuma notificação recente</p>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="h-[calc(30rem-5.5rem-3.75rem)] overflow-y-auto scrollbar-hide">
                                    <% adminNotificationsTray.forEach((notification) => { %>
                                        <a href="/admin/notificacoes/<%= notification.id %>/abrir" class="flex gap-3 border-b border-slate-100 px-4 py-3 transition hover:bg-slate-50">
                                            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-2xl <%= notification.iconBgClass %> <%= notification.iconTextClass %>">
                                                <% if (notification.type === 'new_enrollment') { %>
                                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                                <% } else if (notification.type === 'expired_certificate') { %>
                                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M9 12h6m2 9H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586A2 2 0 0114 3.586L18.414 8A2 2 0 0119 9.414V19a2 2 0 01-2 2z" /></svg>
                                                <% } else if (notification.type === 'blog_published') { %>
                                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H8a2 2 0 01-2-2V5a2 2 0 012-2h11m0 18a2 2 0 002-2V7m-2 14V7m0 0L15 3m4 4h-4a2 2 0 01-2-2V3m-5 6h5m-5 4h8m-8 4h8" /></svg>
                                                <% } else if (notification.type === 'smtp_failure') { %>
                                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H8m0 0l3-3m-3 3l3 3m9-7v8a2 2 0 01-2 2H6a2 2 0 01-2-2V8a2 2 0 012-2h12a2 2 0 012 2z" /></svg>
                                                <% } else { %>
                                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                <% } %>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-start gap-2">
                                                    <p class="truncate text-[13px] font-bold leading-5 text-slate-800"><%= notification.title %></p>
                                                    <% if (!notification.isRead) { %>
                                                        <span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500 shadow-sm"></span>
                                                    <% } %>
                                                </div>
                                                <p class="mt-0.5 line-clamp-2 text-[12px] leading-6 text-slate-500"><%= notification.message %></p>
                                                <p class="mt-2 text-[10px] font-medium uppercase tracking-wide text-slate-400"><%= notification.createdAtLabel %></p>
                                            </div>
                                        </a>
                                    <% }) %>
                                </div>
                            <% } %>

                            <div class="flex justify-center border-t border-slate-100 px-4 py-3.5">
                                <a href="/admin/notificacoes" class="inline-flex items-center text-[13px] font-bold text-indigo-600 transition hover:text-indigo-700">
                                    Visualizar todas
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <%- body %>
        </main>
    </div>
</body>
</html>
