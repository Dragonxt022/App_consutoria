<div class="w-full max-w-5xl mr-auto" x-data="{ activeConfigTab: '<%= activeTab %>' }">
        <form id="settings-form" action="/admin/configuracoes" method="POST" enctype="multipart/form-data" class="space-y-8">
            <input type="hidden" name="active_tab" :value="activeConfigTab">
            <section class="sticky top-4 z-20 rounded-2xl border border-slate-200 bg-white/95 p-3 shadow-sm backdrop-blur">
                <div class="mb-3 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                    <p class="text-xs font-black uppercase tracking-[0.24em] text-slate-400">Submenu de Configurações</p>
                    </div>
                    <a href="/admin/atualizacoes" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700">
                        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        Atualizações
                    </a>
                </div>
                <div class="grid grid-cols-2 gap-2 md:grid-cols-3 xl:grid-cols-7">
                    <a href="/admin/configuracoes?tab=identidade" @click.prevent="activeConfigTab = 'identidade'; window.history.replaceState({}, '', '/admin/configuracoes?tab=identidade')" :class="activeConfigTab === 'identidade' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all">
                        Identidade
                    </a>
                    <a href="/admin/configuracoes?tab=seo" @click.prevent="activeConfigTab = 'seo'; window.history.replaceState({}, '', '/admin/configuracoes?tab=seo')" :class="activeConfigTab === 'seo' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all">
                        SEO
                    </a>
                    <a href="/admin/configuracoes?tab=loja" @click.prevent="activeConfigTab = 'loja'; window.history.replaceState({}, '', '/admin/configuracoes?tab=loja')" :class="activeConfigTab === 'loja' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all">
                        Loja
                    </a>
                    <a href="/admin/configuracoes?tab=certificados" @click.prevent="activeConfigTab = 'certificados'; window.history.replaceState({}, '', '/admin/configuracoes?tab=certificados')" :class="activeConfigTab === 'certificados' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all">
                        Certificados
                    </a>
                    <a href="/admin/configuracoes?tab=rodape" @click.prevent="activeConfigTab = 'rodape'; window.history.replaceState({}, '', '/admin/configuracoes?tab=rodape')" :class="activeConfigTab === 'rodape' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all">
                        Rodapé
                    </a>
                    <a href="/admin/configuracoes?tab=banners" @click.prevent="activeConfigTab = 'banners'; window.history.replaceState({}, '', '/admin/configuracoes?tab=banners')" :class="activeConfigTab === 'banners' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all">
                        Banners
                    </a>
                    <a href="/admin/configuracoes?tab=email" @click.prevent="activeConfigTab = 'email'; window.history.replaceState({}, '', '/admin/configuracoes?tab=email')" :class="activeConfigTab === 'email' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all">
                        E-mail
                    </a>
                </div>
            </section>

            <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm space-y-10">
            
            <!-- Identidade Visual -->
            <section x-show="activeConfigTab === 'identidade'" x-transition.opacity class="space-y-6">
                <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider">Identidade Visual</h3>
                
                <div class="grid gap-6 lg:grid-cols-2 xl:grid-cols-[1.1fr_0.95fr]">
                    <div class="space-y-4 rounded-2xl border border-slate-200 bg-slate-50/70 p-5 lg:col-span-2 xl:col-span-1">
                        <label class="block text-xs font-bold text-slate-500 uppercase">Nome do Site</label>
                        <input type="text" name="site_name" value="<%= settings.site_name %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                        <p class="text-xs text-slate-400">Nome principal usado no cabeçalho, SEO e identidade textual da aplicação.</p>
                    </div>

                    <div class="space-y-4 rounded-2xl border border-slate-200 bg-slate-50/70 p-5">
                        <label class="block text-xs font-bold text-slate-500 uppercase">Logotipo</label>
                        <div class="flex items-center gap-4">
                            <div class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
                                <img
                                    id="logoPreview"
                                    src="<%= settings.logo_url || '' %>"
                                    class="<%= settings.logo_url ? '' : 'hidden ' %>h-full w-full object-contain"
                                    alt="Preview do logotipo"
                                    onerror="this.classList.add('hidden'); document.getElementById('logoPreviewPlaceholder')?.classList.remove('hidden');"
                                >
                                <span id="logoPreviewPlaceholder" class="<%= settings.logo_url ? 'hidden ' : '' %>text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Logo</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <input id="logoInput" type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                                <p class="mt-3 text-xs text-slate-400">Use uma arte com bom respiro visual para cabeçalhos e áreas institucionais.</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4 rounded-2xl border border-slate-200 bg-slate-50/70 p-5">
                        <label class="block text-xs font-bold text-slate-500 uppercase">Ícone da Aplicação</label>
                        <div class="flex items-center gap-4">
                            <div class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
                                <img
                                    id="appIconPreview"
                                    src="<%= settings.app_icon_url || '' %>"
                                    class="<%= settings.app_icon_url ? '' : 'hidden ' %>h-full w-full object-contain"
                                    alt="Preview do ícone da aplicação"
                                    onerror="this.classList.add('hidden'); document.getElementById('appIconPreviewPlaceholder')?.classList.remove('hidden');"
                                >
                                <span id="appIconPreviewPlaceholder" class="<%= settings.app_icon_url ? 'hidden ' : '' %>text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Ícone</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <input id="appIconInput" type="file" name="app_icon" accept="image/png,image/jpeg,image/webp" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                                <p class="mt-3 text-xs text-slate-400">Usado na aba do navegador e como ícone geral da aplicação. Formatos: PNG, JPG ou WEBP.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl">
                    <div>
                        <span class="block font-bold text-slate-700">Modo de Exibição do Logo</span>
                        <span class="text-xs text-slate-500">Escolha entre exibir apenas o nome textual ou apenas a imagem do logo.</span>
                    </div>
                    
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="hidden" name="use_logo" value="false">
                        <input type="checkbox" name="use_logo" value="true" <%= settings.use_logo === 'true' ? 'checked' : '' %> class="sr-only peer">
                        <div class="w-14 h-7 bg-slate-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-indigo-600"></div>
                        <span class="ml-3 text-sm font-medium text-slate-900"><%= settings.use_logo === 'true' ? 'Somente Logo' : 'Somente Nome' %></span>
                    </label>
                </div>
            </section>

            <hr x-show="activeConfigTab === 'identidade'" class="border-slate-100">

            <section x-show="activeConfigTab === 'seo'" x-transition.opacity class="space-y-6">
                <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider">SEO e Compartilhamento</h3>
                <p class="text-sm text-slate-500">Defina o título e a descrição padrão do site. A logo cadastrada será usada como imagem padrão de compartilhamento.</p>

                <div class="grid gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Título padrão do site</label>
                        <input type="text" name="seo_site_title" value="<%= settings.seo_site_title || '' %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Ex: Consultoria Profissional | Início">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Descrição padrão</label>
                        <textarea name="seo_site_description" rows="4" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Resumo principal do site para Google, WhatsApp e redes sociais."><%= settings.seo_site_description || '' %></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Palavras-chave</label>
                        <input type="text" name="seo_site_keywords" value="<%= settings.seo_site_keywords || '' %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="cursos, treinamentos, capacitação, certificações">
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                    <p class="text-xs font-black uppercase tracking-[0.24em] text-slate-400">Prévia de compartilhamento</p>
                    <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                        <div class="flex items-center gap-4 border-b border-slate-100 px-4 py-4">
                            <% if (settings.logo_url) { %>
                                <img src="<%= settings.logo_url %>" alt="Logo do site" class="h-14 w-14 rounded-xl bg-slate-50 object-contain p-2">
                            <% } else { %>
                                <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-indigo-50 text-xl font-black text-indigo-600"><%= (settings.site_name || 'S').charAt(0).toUpperCase() %></div>
                            <% } %>
                            <div class="min-w-0">
                                <div class="truncate text-base font-bold text-slate-900"><%= settings.seo_site_title || settings.site_name || 'Título do site' %></div>
                                <div class="mt-1 text-sm text-slate-500 truncate"><%= settings.seo_site_description || 'A descrição padrão do site aparecerá aqui quando você salvar.' %></div>
                                <div class="mt-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Imagem padrão: logo do site</div>
                            </div>
                        </div>
                        <div class="px-4 py-3 text-xs text-slate-500">Ao compartilhar o link do site, o sistema usará esse título, essa descrição e a logo cadastrada como imagem principal.</div>
                    </div>
                </div>
            </section>

            <hr x-show="activeConfigTab === 'seo'" class="border-slate-100">

            <section x-show="activeConfigTab === 'loja'" x-transition.opacity class="space-y-6">
                <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider">Configurações da Loja</h3>

                <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl">
                    <div>
                        <span class="block font-bold text-slate-700">Ofertas abaixo dos cursos</span>
                        <span class="text-xs text-slate-500">Exibe uma linha com até 4 produtos da loja no final da página de detalhes do curso.</span>
                    </div>

                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="hidden" name="show_course_store_offers" value="false">
                        <input type="checkbox" name="show_course_store_offers" value="true" <%= settings.show_course_store_offers === 'true' ? 'checked' : '' %> class="sr-only peer">
                        <div class="w-14 h-7 bg-slate-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-indigo-600"></div>
                        <span class="ml-3 text-sm font-medium text-slate-900"><%= settings.show_course_store_offers === 'true' ? 'Ativado' : 'Desativado' %></span>
                    </label>
                </div>
            </section>

            <!-- Certificado -->
            <section x-show="activeConfigTab === 'certificados'" x-transition.opacity class="space-y-6">
                <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider">Configurações de Certificado</h3>
                <p class="text-xs text-slate-500">Padronize a assinatura usada nos certificados (1200 x 360 px).</p>

                <div class="grid md:grid-cols-1 gap-6">
                    <div class="max-w-2xl">
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Assinatura do Certificado</label>
                        <div class="space-y-3">
                            <div class="flex flex-wrap items-center gap-2">
                                <input id="certSignatureInput" type="file" name="cert_signature" accept="image/png,image/jpeg,image/webp" class="text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                                <button type="button" id="openSignatureModal" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded text-sm">Desenhar</button>
                                <button type="button" id="clearSignatureSelection" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded text-sm">Limpar</button>
                                <input type="hidden" name="certificate_signature_base64" id="certificate_signature_base64">
                            </div>

                            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Preview Final (1200 x 360)</div>
                                <div class="h-20 w-full max-w-md rounded bg-white border border-dashed border-slate-200 flex items-center justify-center overflow-hidden">
                                    <% if (settings.certificate_signature_url) { %>
                                        <img id="signaturePreview" src="<%= settings.certificate_signature_url %>" class="h-full w-full object-contain" alt="Assinatura atual">
                                    <% } else { %>
                                        <img id="signaturePreview" src="" class="h-full w-full object-contain hidden" alt="Preview da assinatura">
                                    <% } %>
                                    <span id="signaturePreviewPlaceholder" class="<%= settings.certificate_signature_url ? 'hidden' : '' %> text-xs text-slate-400">Nenhuma assinatura selecionada</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Signature Drawing Modal -->
            <div id="signatureModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
                <div class="bg-white rounded-xl p-6 w-[900px] max-w-full">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-lg font-bold">Desenhar Assinatura</h4>
                        <button type="button" id="closeSignatureModal" class="text-slate-500">Fechar</button>
                    </div>
                    <p class="text-xs text-slate-500 mb-3">Assinatura digital padronizada para 1200 x 360 px.</p>
                    <div class="border rounded p-2 bg-slate-50">
                        <canvas id="signatureCanvas" width="760" height="220" style="width:100%; height:220px; display:block; background:#fff; touch-action:none;"></canvas>
                    </div>
                    <div class="mt-4 flex items-center justify-between">
                        <div>
                            <button id="clearSignature" type="button" class="bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded mr-2">Limpar</button>
                            <button id="saveSignature" type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded">Usar Assinatura</button>
                        </div>
                        <div class="text-sm text-slate-500">Ao salvar, substitui o upload de imagem atual.</div>
                    </div>
                </div>
            </div>

            <!-- Signature Crop Modal -->
            <div id="signatureCropModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">
                <div class="bg-white rounded-xl p-6 w-[920px] max-w-full">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-lg font-bold">Ajustar Assinatura PNG</h4>
                        <button type="button" id="closeCropModal" class="text-slate-500">Fechar</button>
                    </div>
                    <p class="text-xs text-slate-500 mb-3">Arraste para posicionar e use zoom. O recorte final será salvo no padrão 1200 x 360 px.</p>
                    <div class="border rounded p-2 bg-slate-50">
                        <canvas id="cropCanvas" width="760" height="240" style="width:100%; height:240px; display:block; background:#fff; touch-action:none;"></canvas>
                    </div>
                    <div class="mt-4">
                        <label for="cropZoom" class="block text-xs font-semibold text-slate-600 mb-1">Zoom</label>
                        <input type="range" id="cropZoom" min="1" max="4" value="1.2" step="0.01" class="w-full">
                    </div>
                    <div class="mt-4 flex items-center justify-between">
                        <button type="button" id="resetCrop" class="bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded">Resetar</button>
                        <button type="button" id="confirmCrop" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded">Confirmar Corte</button>
                    </div>
                </div>
            </div>

            <!-- Informações do Rodapé -->
            <section x-show="activeConfigTab === 'rodape'" x-transition.opacity class="space-y-6">
                <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider">Informações do Rodapé</h3>
                
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">E-mail de Contato</label>
                        <input type="email" name="footer_email" value="<%= settings.footer_email %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Telefone</label>
                        <input type="text" name="footer_phone" value="<%= settings.footer_phone %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Endereço</label>
                    <input type="text" name="footer_address" value="<%= settings.footer_address %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Direitos Autorais (Copyright)</label>
                    <input type="text" name="footer_copyright" value="<%= settings.footer_copyright %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Instagram</label>
                        <input type="url" name="social_instagram" value="<%= settings.social_instagram %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="https://instagram.com/...">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Facebook</label>
                        <input type="url" name="social_facebook" value="<%= settings.social_facebook %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="https://facebook.com/...">
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">LinkedIn</label>
                        <input type="url" name="social_linkedin" value="<%= settings.social_linkedin %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="https://linkedin.com/company/...">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-2">YouTube</label>
                        <input type="url" name="social_youtube" value="<%= settings.social_youtube %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="https://youtube.com/...">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">WhatsApp</label>
                    <input type="url" name="social_whatsapp" value="<%= settings.social_whatsapp %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="https://wa.me/55...">
                </div>
            </section>

            <section x-show="activeConfigTab === 'banners'" x-transition.opacity class="space-y-6">
                <div>
                    <h3 class="text-sm font-bold text-indigo-600 uppercase tracking-wider">Banners da Home</h3>
                    <p class="mt-2 text-xs text-slate-500">Cadastre até 6 banners para a página inicial. Tamanho recomendado: 1920 x 700 px. O layout será responsivo no desktop e mobile.</p>
                </div>

                <div id="banner-list" class="grid gap-5">
                    <% for (let i = 0; i < 6; i++) { const banner = (settings.home_banners && settings.home_banners[i]) ? settings.home_banners[i] : null; %>
