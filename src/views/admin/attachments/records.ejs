<div class="space-y-4" x-data="{ showFilters: <%= (filters.search || filters.visibilityType || filters.courseId || filters.userId) ? 'true' : 'false' %> }">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-slate-500">Total: <%= attachments.length %> anexo(s) encontrado(s).</p>
        <div class="flex items-center gap-3">
            <button type="button" @click="showFilters = !showFilters" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900" :title="showFilters ? 'Ocultar filtros' : 'Mostrar filtros'">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 01.8 1.6L15 12v5a1 1 0 01-.553.894l-4 2A1 1 0 019 19v-7L3.2 4.6A1 1 0 013 4z"/>
                </svg>
            </button>
            <a href="/admin/anexos" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700">
                Enviar novo anexo
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <form action="/admin/anexos/historico" method="GET" x-show="showFilters" x-cloak x-transition class="border-b border-slate-100 px-6 py-5">
            <div class="grid gap-4 lg:grid-cols-[1fr_220px_240px_240px_auto]">
                <div>
                    <label for="search" class="block text-xs font-black uppercase tracking-[0.2em] text-slate-500">Buscar</label>
                    <input id="search" name="search" type="text" value="<%= filters.search %>" placeholder="Nome do anexo, descrição ou arquivo" class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm outline-none transition focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100">
                </div>
                <div>
                    <label for="visibilityTypeFilter" class="block text-xs font-black uppercase tracking-[0.2em] text-slate-500">Destino</label>
                    <select id="visibilityTypeFilter" name="visibilityType" class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm outline-none transition focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100">
                        <option value="">Todos</option>
                        <option value="course" <%= filters.visibilityType === 'course' ? 'selected' : '' %>>Todos do curso</option>
                        <option value="user" <%= filters.visibilityType === 'user' ? 'selected' : '' %>>Usuário específico</option>
                    </select>
                </div>
                <div>
                    <label for="courseIdFilter" class="block text-xs font-black uppercase tracking-[0.2em] text-slate-500">Curso</label>
                    <select id="courseIdFilter" name="courseId" class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm outline-none transition focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100">
                        <option value="">Todos</option>
                        <% courses.forEach((course) => { %>
                            <option value="<%= course.id %>" <%= filters.courseId === String(course.id) ? 'selected' : '' %>><%= course.title %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label for="userIdFilter" class="block text-xs font-black uppercase tracking-[0.2em] text-slate-500">Usuário</label>
                    <select id="userIdFilter" name="userId" class="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm outline-none transition focus:border-indigo-300 focus:ring-4 focus:ring-indigo-100">
                        <option value="">Todos</option>
                        <% students.forEach((student) => { %>
                            <option value="<%= student.id %>" <%= filters.userId === String(student.id) ? 'selected' : '' %>><%= student.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="flex items-end gap-2">
                    <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-black text-white transition hover:bg-slate-800">
                        Filtrar
                    </button>
                    <a href="/admin/anexos/historico" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-600 transition hover:bg-slate-50">
                        Limpar
                    </a>
                </div>
            </div>
        </form>

        <% if (!attachments.length) { %>
            <div class="px-6 py-14 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-300">
                    <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10M7 11h10M7 15h6m-6 6h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                </div>
                <h4 class="mt-5 text-xl font-black text-slate-900">Nenhum anexo encontrado.</h4>
                <p class="mt-2 text-sm text-slate-500">Ajuste os filtros acima ou volte para a ferramenta de cadastro para criar um novo material.</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-100 text-left">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Arquivo</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Destino</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Regra de acesso</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Criado por</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Data</th>
                            <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% attachments.forEach((attachment) => { %>
                            <tr class="align-top hover:bg-slate-50/80">
                                <td class="px-6 py-5">
                                    <div class="flex items-start gap-4">
                                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">
                                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10M7 11h10M7 15h6m-6 6h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                            </svg>
                                        </div>
                                        <div>
                                            <p class="font-black text-slate-900"><%= attachment.title %></p>
                                            <p class="mt-1 text-sm text-slate-500"><%= attachment.fileCountLabel %> • <%= attachment.fileSizeLabel %></p>
                                            <p class="mt-1 text-xs text-slate-400"><%= attachment.files[0]?.originalName || attachment.originalName %><%= attachment.fileCount > 1 ? ' e outros' : '' %></p>
                                            <% if (attachment.description) { %>
                                                <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500"><%= attachment.description %></p>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-5 text-sm text-slate-600">
                                    <% if (attachment.visibilityType === 'course') { %>
                                        <p class="font-semibold text-slate-900"><%= attachment.visibilityLabel %></p>
                                        <p class="mt-1"><%= attachment.Course ? attachment.Course.title : 'Curso removido' %></p>
                                    <% } else { %>
                                        <p class="font-semibold text-slate-900">Usuário específico</p>
                                        <p class="mt-1"><%= attachment.recipient ? attachment.recipient.name : 'Usuário removido' %></p>
                                        <p class="text-xs text-slate-400"><%= attachment.recipient ? attachment.recipient.email : '' %></p>
                                    <% } %>
                                </td>
                                <td class="px-6 py-5 text-sm text-slate-600">
                                    <% if (attachment.visibilityType === 'course') { %>
                                        <span class="inline-flex rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.18em] text-cyan-700">
                                            <%= attachment.requiredEnrollmentStatusLabel %>
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-[11px] font-black uppercase tracking-[0.18em] text-slate-600">
                                            Sem requisito
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-5 text-sm text-slate-600">
                                    <p class="font-semibold text-slate-900"><%= attachment.creator ? attachment.creator.name : 'Administrador' %></p>
                                </td>
                                <td class="px-6 py-5 text-sm text-slate-600">
                                    <%= new Date(attachment.createdAt).toLocaleDateString('pt-BR') %>
                                </td>
                                <td class="px-6 py-5 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="<%= attachment.fileUrl %>" target="_blank" class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-slate-400 transition hover:bg-indigo-50 hover:text-indigo-600" title="Abrir anexo">
                                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0A9 9 0 113 12a9 9 0 0118 0z" />
                                            </svg>
                                        </a>
                                        <form action="/admin/anexos/<%= attachment.id %>/deletar" method="POST" onsubmit="return confirm('Deseja remover este anexo e revogar o acesso dos destinatários?');">
                                            <button type="submit" class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-slate-400 transition hover:bg-rose-50 hover:text-rose-600" title="Excluir anexo">
                                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>
