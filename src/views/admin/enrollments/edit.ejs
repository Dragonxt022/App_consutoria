<%
    const toNumber = (value) => {
        const numericValue = Number(value);
        return Number.isFinite(numericValue) ? numericValue : 0;
    };

    const currentCoursePrice = toNumber(enrollment.coursePrice);
    const currentDiscount = toNumber(enrollment.discount);
    const currentFinalPrice = toNumber(enrollment.finalPrice);
    const currentDiscountPercent = currentCoursePrice > 0 ? ((currentDiscount / currentCoursePrice) * 100).toFixed(2) : '0.00';
%>
<div class="w-full max-w-6xl mr-auto space-y-6">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h2 class="text-xl font-bold text-slate-800">Editar Inscrição #<%= enrollment.id %></h2>
                <p class="text-sm text-slate-500 mt-1">Atualize os dados do participante, curso vinculado, status e condições financeiras.</p>
            </div>
            <a href="/admin/inscricoes" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100">
                Voltar para a lista
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                <form id="enrollment-edit-form" action="/admin/inscricoes/<%= enrollment.id %>/edit" method="POST" class="space-y-6">
                    <div class="border-b border-slate-100 pb-6">
                    <h3 class="text-lg font-semibold text-slate-800 mb-4">Dados do Aluno</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Nome Completo</label>
                            <input type="text" name="studentName" value="<%= enrollment.studentName %>" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">E-mail</label>
                            <input type="email" name="studentEmail" value="<%= enrollment.studentEmail %>" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Telefone</label>
                            <input type="text" name="studentPhone" value="<%= enrollment.studentPhone %>" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">CPF ou CNPJ</label>
                            <input type="text" name="cpfCnpj" value="<%= enrollment.cpfCnpj || '' %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="000.000.000-00 ou 00.000.000/0000-00">
                        </div>
                    </div>
                    </div>

                    <div class="border-b border-slate-100 pb-6">
                    <h3 class="text-lg font-semibold text-slate-800 mb-4">Dados Corporativos</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Empresa</label>
                            <input type="text" name="company" value="<%= enrollment.company || '' %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Tipo de Organização</label>
                            <select name="entePublico" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none">
                                <option value="">Selecione uma opção</option>
                                <option value="0" <%= enrollment.entePublico === false ? 'selected' : '' %>>Setor Privado</option>
                                <option value="1" <%= enrollment.entePublico === true ? 'selected' : '' %>>Ente Público</option>
                            </select>
                        </div>
                    </div>
                    </div>

                    <div class="border-b border-slate-100 pb-6">
                    <h3 class="text-lg font-semibold text-slate-800 mb-4">Endereço</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">País</label>
                            <input type="text" name="pais" value="<%= enrollment.pais || '' %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Brasil">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">CEP</label>
                            <input type="text" name="cep" value="<%= enrollment.cep || '' %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="00000-000">
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Endereço Completo</label>
                            <input type="text" name="endereco" value="<%= enrollment.endereco || '' %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Rua, número, complemento">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Cidade</label>
                            <input type="text" name="cidade" value="<%= enrollment.cidade || '' %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="São Paulo">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Estado / UF</label>
                            <select name="estado" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none">
                                <option value="">Selecione um estado</option>
                                <option value="SP" <%= enrollment.estado === 'SP' ? 'selected' : '' %>>São Paulo</option>
                                <option value="RJ" <%= enrollment.estado === 'RJ' ? 'selected' : '' %>>Rio de Janeiro</option>
                                <option value="MG" <%= enrollment.estado === 'MG' ? 'selected' : '' %>>Minas Gerais</option>
                                <option value="BA" <%= enrollment.estado === 'BA' ? 'selected' : '' %>>Bahia</option>
                                <option value="RS" <%= enrollment.estado === 'RS' ? 'selected' : '' %>>Rio Grande do Sul</option>
                            </select>
                        </div>
                    </div>
                    </div>

                    <div class="border-b border-slate-100 pb-6">
                        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Observações</label>
                        <textarea name="observations" rows="4" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none"><%= enrollment.observations || '' %></textarea>
                    </div>

                    <div class="flex justify-end gap-3 pt-2">
                        <a href="/admin/inscricoes" class="px-6 py-3 text-sm font-bold text-slate-600">Cancelar</a>
                        <button type="submit" class="rounded-xl bg-indigo-600 px-8 py-3 text-sm font-bold text-white transition-colors hover:bg-indigo-700">
                            Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="space-y-6">
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5">
                <div class="mb-4">
                    <h3 class="text-base font-bold text-slate-800">Anexos da Inscrição</h3>
                    <p class="mt-1 text-sm text-slate-500">Aqui você acompanha o documento enviado pelo aluno para validação administrativa.</p>
                </div>

                <% if (attachment) { %>
                    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
                        <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-700">Documento enviado</p>
                        <p class="mt-3 text-sm font-bold text-slate-900"><%= attachment.originalName %></p>
                        <div class="mt-3 space-y-2 text-xs text-slate-600">
                            <p>Enviado em: <span class="font-semibold text-slate-900"><%= attachment.uploadedAt ? new Date(attachment.uploadedAt).toLocaleString('pt-BR') : 'Agora há pouco' %></span></p>
                            <p>Tamanho: <span class="font-semibold text-slate-900"><%= attachment.size ? `${(attachment.size / 1024).toFixed(1)} KB` : 'Não informado' %></span></p>
                            <p>Tipo: <span class="font-semibold text-slate-900"><%= attachment.mimeType || 'Documento' %></span></p>
                        </div>
                        <a href="/admin/inscricoes/<%= enrollment.id %>/anexo" target="_blank" class="mt-4 inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-700">
                            Abrir documento enviado
                        </a>
                    </div>
                <% } else { %>
                    <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-5 text-sm text-slate-500">
                        Nenhum documento complementar foi enviado para esta inscrição até o momento.
                    </div>
                <% } %>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5">
                <div class="mb-5">
                    <h3 class="text-base font-bold text-slate-800">Curso e Valores</h3>
                    <p class="mt-1 text-sm text-slate-500">Ajuste curso, status e desconto sem tirar o foco do cadastro principal.</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Curso</label>
                        <select name="courseId" id="courseSelect" form="enrollment-edit-form" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                            <% courses.forEach(course => { %>
                                <option value="<%= course.id %>" data-price="<%= course.priceValue %>" <%= enrollment.courseId === course.id ? 'selected' : '' %>><%= course.title %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Status</label>
                        <select name="status" form="enrollment-edit-form" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                            <option value="pendente" <%= enrollment.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                            <option value="confirmado" <%= enrollment.status === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
                            <option value="completo" <%= enrollment.status === 'completo' ? 'selected' : '' %>>Completo</option>
                            <option value="cancelado" <%= enrollment.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Valor do Curso (R$)</label>
                        <input type="text" name="coursePrice" id="coursePrice" form="enrollment-edit-form" value="<%= currentCoursePrice.toFixed(2) %>" data-currency-input data-currency-prefix="R$ " data-currency-storage="decimal" inputmode="numeric" autocomplete="off" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                    </div>

                    <div class="grid grid-cols-2 gap-3 items-end">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Desconto (R$)</label>
                            <input type="text" name="discount" id="discount" form="enrollment-edit-form" value="<%= currentDiscount.toFixed(2) %>" data-currency-input data-currency-prefix="R$ " data-currency-storage="decimal" inputmode="numeric" autocomplete="off" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wide text-slate-500 mb-2">Desconto (%)</label>
                            <input type="number" step="0.01" name="discountPercent" id="discountPercent" form="enrollment-edit-form" value="<%= currentDiscountPercent %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <span class="w-full text-sm text-gray-600">Aplicar desconto rápido:</span>
                        <button type="button" class="px-3 py-1 bg-white border border-slate-200 rounded-md text-sm hover:bg-gray-50" data-percent="5">5%</button>
                        <button type="button" class="px-3 py-1 bg-white border border-slate-200 rounded-md text-sm hover:bg-gray-50" data-percent="10">10%</button>
                        <button type="button" class="px-3 py-1 bg-white border border-slate-200 rounded-md text-sm hover:bg-gray-50" data-percent="15">15%</button>
                        <button type="button" class="px-3 py-1 bg-white border border-slate-200 rounded-md text-sm hover:bg-gray-50" data-percent="20">20%</button>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-3 text-sm">
                <h3 class="text-base font-bold text-slate-800">Resumo Financeiro</h3>
                <div class="flex items-start justify-between gap-3">
                    <span class="text-slate-500">Valor Original</span>
                    <span class="font-semibold text-slate-700" id="originalPriceDisplay">R$ <%= currentCoursePrice.toFixed(2) %></span>
                </div>
                <div class="flex items-start justify-between gap-3">
                    <span class="text-slate-500">Desconto</span>
                    <span class="font-medium text-red-600 text-right" id="discountDisplay">R$ <%= currentDiscount.toFixed(2) %> (<span id="discountPercentDisplay"><%= currentDiscountPercent %></span>%)</span>
                </div>
                <div class="flex items-start justify-between gap-3 pt-3 border-t border-slate-100">
                    <span class="text-slate-500">Valor Final</span>
                    <span class="text-2xl font-bold text-green-600" id="finalPriceDisplay">R$ <%= currentFinalPrice.toFixed(2) %></span>
                </div>
            </div>

            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">
                <h3 class="font-bold">Resumo da Inscrição</h3>
                <div class="mt-3 space-y-3 text-xs">
                    <div class="flex items-start justify-between gap-3">
                        <span class="text-amber-700/80">Criado em</span>
                        <span class="font-semibold"><%= new Date(enrollment.createdAt).toLocaleString('pt-BR') %></span>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                        <span class="text-amber-700/80">Atualizado em</span>
                        <span class="font-semibold"><%= new Date(enrollment.updatedAt).toLocaleString('pt-BR') %></span>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                        <span class="text-amber-700/80">Status atual</span>
                        <span class="font-semibold capitalize"><%= enrollment.status %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const courseSelect = document.getElementById('courseSelect');
    const coursePriceInput = document.getElementById('coursePrice');
    const discountInput = document.getElementById('discount');
    const discountPercentInput = document.getElementById('discountPercent');
    const finalPriceDisplay = document.getElementById('finalPriceDisplay');
    const originalPriceDisplay = document.getElementById('originalPriceDisplay');
    const discountDisplay = document.getElementById('discountDisplay');
    const discountPercentDisplay = document.getElementById('discountPercentDisplay');

    function toCurrencyNumber(v) {
        if (window.currencyFields) {
            return window.currencyFields.parse(v);
        }
        return parseFloat(v) || 0;
    }

    function toPercentNumber(v) {
        return parseFloat(v) || 0;
    }

    function formatBRL(v) {
        if (window.currencyFields) {
            return window.currencyFields.format(v, 'R$ ');
        }
        return 'R$ ' + Number(v).toFixed(2);
    }

    function updateDisplays(price, discount) {
        const final = Math.max(0, price - discount);
        originalPriceDisplay.textContent = formatBRL(price);
        finalPriceDisplay.textContent = formatBRL(final);
        discountDisplay.textContent = formatBRL(discount) + ' (' + (price > 0 ? ((discount / price) * 100).toFixed(2) : '0.00') + '%)';
        discountPercentDisplay.textContent = price > 0 ? ((discount / price) * 100).toFixed(2) : '0.00';
    }

    function syncFromPriceAndDiscount() {
        const price = toCurrencyNumber(coursePriceInput.value);
        const discount = toCurrencyNumber(discountInput.value);
        const percent = price > 0 ? (discount / price) * 100 : 0;
        discountPercentInput.value = percent.toFixed(2);
        updateDisplays(price, discount);
    }

    function syncFromPercent() {
        const price = toCurrencyNumber(coursePriceInput.value);
        const percent = toPercentNumber(discountPercentInput.value);
        const discount = Math.max(0, (percent / 100) * price);
        if (window.currencyFields) {
            window.currencyFields.setValue(discountInput, discount);
        } else {
            discountInput.value = discount.toFixed(2);
        }
        updateDisplays(price, discount);
    }

    // Handle course select change (use data-price)
    courseSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const priceString = selectedOption.getAttribute('data-price');
        const price = priceString ? toCurrencyNumber(priceString) : 0;
        if (window.currencyFields) {
            window.currencyFields.setValue(coursePriceInput, price);
        } else {
            coursePriceInput.value = price.toFixed(2);
        }
        syncFromPriceAndDiscount();
    });

    // Quick discount buttons
    document.querySelectorAll('[data-percent]').forEach(btn => {
        btn.addEventListener('click', function() {
            const pct = toPercentNumber(this.getAttribute('data-percent'));
            const price = toCurrencyNumber(coursePriceInput.value);
            const discount = Math.max(0, (pct / 100) * price);
            if (window.currencyFields) {
                window.currencyFields.setValue(discountInput, discount);
            } else {
                discountInput.value = discount.toFixed(2);
            }
            discountPercentInput.value = pct.toFixed(2);
            updateDisplays(price, discount);
        });
    });

    // Inputs
    coursePriceInput.addEventListener('input', syncFromPriceAndDiscount);
    discountInput.addEventListener('input', function() {
        syncFromPriceAndDiscount();
    });
    discountPercentInput.addEventListener('input', function() {
        syncFromPercent();
    });

    // Inicializa displays
    (function init() {
        const price = toCurrencyNumber(coursePriceInput.value);
        const discount = toCurrencyNumber(discountInput.value);
        updateDisplays(price, discount);
    })();
</script>
