<%
    const toNumber = (value) => {
        const numericValue = Number(value);
        return Number.isFinite(numericValue) ? numericValue : 0;
    };

    const currentCoursePrice = toNumber(enrollment.coursePrice);
    const currentDiscount = toNumber(enrollment.discount);
    const currentFinalPrice = toNumber(enrollment.finalPrice);
    const currentDiscountPercent = currentCoursePrice > 0 ? ((currentDiscount / currentCoursePrice) * 100).toFixed(2) : '0.00';
%>
<div class="bg-white shadow-xl rounded-2xl overflow-hidden max-w-4xl mx-auto">
    <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
        <h2 class="text-xl font-bold text-gray-800">Editar Inscrição #<%= enrollment.id %></h2>
        <a href="/admin/inscricoes" class="text-gray-500 hover:text-gray-700 text-sm font-medium">Voltar para a lista</a>
    </div>

    <form action="/admin/inscricoes/<%= enrollment.id %>/edit" method="POST" class="p-6 space-y-6">
        <!-- Dados do Aluno -->
        <div class="border-b pb-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-4">Dados do Aluno</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nome Completo</label>
                    <input type="text" name="studentName" value="<%= enrollment.studentName %>" required class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">E-mail</label>
                    <input type="email" name="studentEmail" value="<%= enrollment.studentEmail %>" required class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Telefone</label>
                    <input type="text" name="studentPhone" value="<%= enrollment.studentPhone %>" required class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">CPF ou CNPJ</label>
                    <input type="text" name="cpfCnpj" value="<%= enrollment.cpfCnpj || '' %>" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="000.000.000-00 ou 00.000.000/0000-00">
                </div>
            </div>
        </div>

        <!-- Dados Corporativos -->
        <div class="border-b pb-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-4">Dados Corporativos</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Empresa</label>
                    <input type="text" name="company" value="<%= enrollment.company || '' %>" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Organização</label>
                    <select name="entePublico" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="">Selecione uma opção</option>
                        <option value="0" <%= enrollment.entePublico === false ? 'selected' : '' %>>Setor Privado</option>
                        <option value="1" <%= enrollment.entePublico === true ? 'selected' : '' %>>Ente Público</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Dados de Endereço -->
        <div class="border-b pb-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-4">Endereço</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">País</label>
                    <input type="text" name="pais" value="<%= enrollment.pais || '' %>" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Brasil">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">CEP</label>
                    <input type="text" name="cep" value="<%= enrollment.cep || '' %>" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="00000-000">
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Endereço Completo</label>
                    <input type="text" name="endereco" value="<%= enrollment.endereco || '' %>" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Rua, número, complemento">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Cidade</label>
                    <input type="text" name="cidade" value="<%= enrollment.cidade || '' %>" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="São Paulo">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Estado / UF</label>
                    <select name="estado" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="">Selecione um estado</option>
                        <option value="SP" <%= enrollment.estado === 'SP' ? 'selected' : '' %>>São Paulo</option>
                        <option value="RJ" <%= enrollment.estado === 'RJ' ? 'selected' : '' %>>Rio de Janeiro</option>
                        <option value="MG" <%= enrollment.estado === 'MG' ? 'selected' : '' %>>Minas Gerais</option>
                        <option value="BA" <%= enrollment.estado === 'BA' ? 'selected' : '' %>>Bahia</option>
                        <option value="RS" <%= enrollment.estado === 'RS' ? 'selected' : '' %>>Rio Grande do Sul</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Curso e Valores (melhor organizado) -->
        <div class="border-b pb-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-4">Curso e Valores</h3>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Coluna 1: seleção e status -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Curso</label>
                        <select name="courseId" id="courseSelect" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                            <% courses.forEach(course => { %>
                                <option value="<%= course.id %>" data-price="<%= course.priceValue %>" <%= enrollment.courseId === course.id ? 'selected' : '' %>><%= course.title %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select name="status" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                            <option value="pendente" <%= enrollment.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                            <option value="confirmado" <%= enrollment.status === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
                            <option value="completo" <%= enrollment.status === 'completo' ? 'selected' : '' %>>Completo</option>
                            <option value="cancelado" <%= enrollment.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
                        </select>
                    </div>
                </div>

                <!-- Coluna 2: valores editáveis -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Valor do Curso (R$)</label>
                            <input type="text" name="coursePrice" id="coursePrice" value="<%= currentCoursePrice.toFixed(2) %>" data-currency-input data-currency-prefix="R$ " data-currency-storage="decimal" inputmode="numeric" autocomplete="off" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>

                    <div class="grid grid-cols-2 gap-3 items-end">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Desconto (R$)</label>
                            <input type="text" name="discount" id="discount" value="<%= currentDiscount.toFixed(2) %>" data-currency-input data-currency-prefix="R$ " data-currency-storage="decimal" inputmode="numeric" autocomplete="off" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Desconto (%)</label>
                            <input type="number" step="0.01" name="discountPercent" id="discountPercent" value="<%= currentDiscountPercent %>" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-sm text-gray-600 mr-2">Aplicar desconto rápido:</span>
                        <button type="button" class="px-3 py-1 bg-gray-100 rounded-md text-sm hover:bg-gray-200" data-percent="5">5%</button>
                        <button type="button" class="px-3 py-1 bg-gray-100 rounded-md text-sm hover:bg-gray-200" data-percent="10">10%</button>
                        <button type="button" class="px-3 py-1 bg-gray-100 rounded-md text-sm hover:bg-gray-200" data-percent="15">15%</button>
                        <button type="button" class="px-3 py-1 bg-gray-100 rounded-md text-sm hover:bg-gray-200" data-percent="20">20%</button>
                    </div>
                </div>

                <!-- Coluna 3: resumo e valor final -->
                <div>
                    <div class="bg-gray-50 p-4 rounded-lg flex flex-col h-full justify-between">
                        <div>
                            <p class="text-sm text-gray-500">Valor Original</p>
                            <p class="text-lg font-semibold text-slate-800" id="originalPriceDisplay">R$ <%= currentCoursePrice.toFixed(2) %></p>

                            <p class="mt-3 text-sm text-gray-500">Desconto</p>
                            <p class="text-lg font-medium text-red-600" id="discountDisplay">R$ <%= currentDiscount.toFixed(2) %> (<span id="discountPercentDisplay"><%= currentDiscountPercent %></span>%)</p>
                        </div>

                        <div class="mt-4 pt-4 border-t">
                            <p class="text-sm text-gray-500">Valor Final</p>
                            <p class="text-2xl font-bold text-green-600" id="finalPriceDisplay">R$ <%= currentFinalPrice.toFixed(2) %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Observações -->
        <div class="border-b pb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">Observações</label>
            <textarea name="observations" rows="3" class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none"><%= enrollment.observations || '' %></textarea>
        </div>

        <!-- Botões de Ação -->
        <div class="pt-4 flex justify-end gap-3">
            <a href="/admin/inscricoes" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-600 font-bold hover:bg-gray-50 transition-all">Cancelar</a>
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-lg font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200">
                Salvar Alterações
            </button>
        </div>
    </form>
</div>

<script>
    const courseSelect = document.getElementById('courseSelect');
    const coursePriceInput = document.getElementById('coursePrice');
    const discountInput = document.getElementById('discount');
    const discountPercentInput = document.getElementById('discountPercent');
    const finalPriceDisplay = document.getElementById('finalPriceDisplay');
    const originalPriceDisplay = document.getElementById('originalPriceDisplay');
    const discountDisplay = document.getElementById('discountDisplay');
    const discountPercentDisplay = document.getElementById('discountPercentDisplay');

    function toCurrencyNumber(v) {
        if (window.currencyFields) {
            return window.currencyFields.parse(v);
        }
        return parseFloat(v) || 0;
    }

    function toPercentNumber(v) {
        return parseFloat(v) || 0;
    }

    function formatBRL(v) {
        if (window.currencyFields) {
            return window.currencyFields.format(v, 'R$ ');
        }
        return 'R$ ' + Number(v).toFixed(2);
    }

    function updateDisplays(price, discount) {
        const final = Math.max(0, price - discount);
        originalPriceDisplay.textContent = formatBRL(price);
        finalPriceDisplay.textContent = formatBRL(final);
        discountDisplay.textContent = formatBRL(discount) + ' (' + (price > 0 ? ((discount / price) * 100).toFixed(2) : '0.00') + '%)';
        discountPercentDisplay.textContent = price > 0 ? ((discount / price) * 100).toFixed(2) : '0.00';
    }

    function syncFromPriceAndDiscount() {
        const price = toCurrencyNumber(coursePriceInput.value);
        const discount = toCurrencyNumber(discountInput.value);
        const percent = price > 0 ? (discount / price) * 100 : 0;
        discountPercentInput.value = percent.toFixed(2);
        updateDisplays(price, discount);
    }

    function syncFromPercent() {
        const price = toCurrencyNumber(coursePriceInput.value);
        const percent = toPercentNumber(discountPercentInput.value);
        const discount = Math.max(0, (percent / 100) * price);
        if (window.currencyFields) {
            window.currencyFields.setValue(discountInput, discount);
        } else {
            discountInput.value = discount.toFixed(2);
        }
        updateDisplays(price, discount);
    }

    // Handle course select change (use data-price)
    courseSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const priceString = selectedOption.getAttribute('data-price');
        const price = priceString ? toCurrencyNumber(priceString) : 0;
        if (window.currencyFields) {
            window.currencyFields.setValue(coursePriceInput, price);
        } else {
            coursePriceInput.value = price.toFixed(2);
        }
        syncFromPriceAndDiscount();
    });

    // Quick discount buttons
    document.querySelectorAll('[data-percent]').forEach(btn => {
        btn.addEventListener('click', function() {
            const pct = toPercentNumber(this.getAttribute('data-percent'));
            const price = toCurrencyNumber(coursePriceInput.value);
            const discount = Math.max(0, (pct / 100) * price);
            if (window.currencyFields) {
                window.currencyFields.setValue(discountInput, discount);
            } else {
                discountInput.value = discount.toFixed(2);
            }
            discountPercentInput.value = pct.toFixed(2);
            updateDisplays(price, discount);
        });
    });

    // Inputs
    coursePriceInput.addEventListener('input', syncFromPriceAndDiscount);
    discountInput.addEventListener('input', function() {
        syncFromPriceAndDiscount();
    });
    discountPercentInput.addEventListener('input', function() {
        syncFromPercent();
    });

    // Inicializa displays
    (function init() {
        const price = toCurrencyNumber(coursePriceInput.value);
        const discount = toCurrencyNumber(discountInput.value);
        updateDisplays(price, discount);
    })();
</script>
