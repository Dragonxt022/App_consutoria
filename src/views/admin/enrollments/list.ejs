<div class="bg-white shadow-xl rounded-2xl overflow-hidden">
    <div class="border-b border-gray-100 bg-gray-50/50 p-6">
        <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
            <div>
                <h2 class="text-xl font-bold text-gray-800">Inscricoes Recebidas</h2>
                <p class="mt-1 text-sm text-slate-500">Pesquise por inscrito, email ou nome do curso e exporte a mesma lista em CSV.</p>
            </div>

            <form action="/admin/inscricoes" method="GET" class="w-full xl:max-w-4xl">
                <div class="flex flex-col gap-3 rounded-xl border border-gray-100 bg-white p-4 shadow-sm lg:flex-row lg:items-end">
                    <div class="min-w-0 flex-1">
                        <label for="search" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Pesquisar</label>
                        <input id="search" type="text" name="search" placeholder="Buscar inscrito ou curso..." value="<%= filters.search || '' %>" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div class="flex flex-col gap-2 sm:flex-row">
                        <button type="submit" class="w-full rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white transition-colors hover:bg-indigo-700 sm:w-auto">Buscar</button>
                        <a href="/admin/inscricoes/exportar<%= filters.search ? '?search=' + encodeURIComponent(filters.search) : '' %>" class="w-full rounded-lg border border-emerald-200 bg-emerald-50 px-6 py-2.5 text-center text-sm font-bold text-emerald-700 transition-colors hover:bg-emerald-100 sm:w-auto">Exportar CSV</a>
                        <% if (filters.search) { %>
                            <a href="/admin/inscricoes" class="w-full rounded-lg border border-slate-200 px-6 py-2.5 text-center text-sm font-semibold text-slate-500 transition-colors hover:bg-slate-50 sm:w-auto">Limpar</a>
                        <% } %>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="overflow-x-auto">
        <style>
        @media (max-width: 1024px) {
            .responsive-table thead { display: none; }
            .responsive-table, .responsive-table tbody, .responsive-table tr, .responsive-table td { display: block; width: 100%; }
            .responsive-table tr { margin-bottom: 1rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem; }
            .responsive-table td { padding: 0.5rem 0; }
            .responsive-table td[data-label] { display: block; }
            .responsive-table td[data-label]::before { content: attr(data-label); display: block; margin-bottom: 0.35rem; font-weight: 700; color: #475569; }
            .responsive-table .actions { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 0.5rem; margin-top: 0.5rem; }
            .responsive-table .actions form { width: 100%; }
            .responsive-table .actions select { width: 100%; }
        }
        </style>

        <table class="responsive-table w-full text-left">
            <thead class="bg-gray-50 text-xs font-bold uppercase text-gray-400">
                <tr>
                    <th class="px-4 py-3 md:px-6 md:py-4">Estudante</th>
                    <th class="hidden px-4 py-3 md:px-6 md:py-4 xl:table-cell">Curso Inscrito</th>
                    <th class="hidden px-4 py-3 md:px-6 md:py-4 xl:table-cell">Data Inscrição</th>
                    <th class="px-4 py-3 md:px-6 md:py-4">Status</th>
                    <th class="px-4 py-3 text-right md:px-6 md:py-4">Mudar Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% enrollments.forEach(enroll => { %>
                    <tr class="transition-colors hover:bg-gray-50/50">
                        <td class="px-4 py-3 md:px-6 md:py-4" data-label="Estudante">
                            <div class="flex flex-col">
                                <span class="text-sm font-bold text-gray-900"><%= enroll.studentName %></span>
                                <span class="text-xs text-gray-500"><%= enroll.studentEmail %></span>
                                <span class="text-xs text-gray-500"><%= enroll.studentPhone %></span>
                                <% if (enroll.company) { %>
                                    <span class="mt-1 w-fit rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600"><%= enroll.company %></span>
                                <% } %>
                            </div>
                        </td>
                        <td class="hidden px-4 py-3 md:px-6 md:py-4 xl:table-cell" data-label="Curso Inscrito">
                            <div class="text-sm font-medium text-gray-700"><%= enroll.Course ? enroll.Course.title : 'Curso Removido' %></div>
                            <div class="text-xs text-gray-400"><%= enroll.Course ? enroll.Course.location : 'N/A' %></div>
                        </td>
                        <td class="hidden px-4 py-3 text-sm text-gray-500 md:px-6 md:py-4 xl:table-cell" data-label="Data Inscrição">
                            <%= new Date(enroll.createdAt).toLocaleDateString('pt-BR') %>
                        </td>
                        <td class="px-4 py-3 md:px-6 md:py-4" data-label="Status">
                            <%
                                let statusClass = '';
                                switch (enroll.status) {
                                    case 'pendente': statusClass = 'bg-amber-100 text-amber-800'; break;
                                    case 'confirmado': statusClass = 'bg-blue-100 text-blue-800'; break;
                                    case 'completo': statusClass = 'bg-green-100 text-green-800'; break;
                                    case 'cancelado': statusClass = 'bg-red-100 text-red-800'; break;
                                    default: statusClass = 'bg-gray-100 text-gray-800';
                                }
                            %>
                            <span class="rounded-full px-2.5 py-0.5 text-xs font-medium uppercase tracking-wide <%= statusClass %>">
                                <%= enroll.status %>
                            </span>

                            <% if (enroll.status === 'completo' && enroll.certificateCode) { %>
                                <a href="/certificado/<%= enroll.certificateCode %>" target="_blank" class="mt-2 flex items-center gap-1 text-xs font-semibold text-indigo-600 transition-colors hover:text-indigo-800">
                                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    Ver Certificado
                                </a>
                            <% } %>
                        </td>
                        <td class="px-4 py-3 text-right md:px-6 md:py-4" data-label="Ações">
                            <div class="actions flex items-center justify-end gap-3">
                                <button
                                    type="button"
                                    class="js-enroll-details rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50"
                                    data-student="<%= enroll.studentName %>"
                                    data-email="<%= enroll.studentEmail || 'Não informado' %>"
                                    data-phone="<%= enroll.studentPhone || 'Não informado' %>"
                                    data-company="<%= enroll.company || 'Não informado' %>"
                                    data-course="<%= enroll.Course ? enroll.Course.title : 'Curso Removido' %>"
                                    data-location="<%= enroll.Course ? enroll.Course.location : 'N/A' %>"
                                    data-date="<%= new Date(enroll.createdAt).toLocaleDateString('pt-BR') %>"
                                    data-status="<%= enroll.status %>"
                                    data-certificate="<%= (enroll.status === 'completo' && enroll.certificateCode) ? '/certificado/' + enroll.certificateCode : '' %>"
                                >
                                    Detalhes
                                </button>
                                <a href="/admin/inscricoes/<%= enroll.id %>/comprovante" title="Baixar Comprovante de Inscrição" target="_blank" class="text-green-600 transition-colors hover:text-green-800">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                </a>
                                <% if (enroll.status === 'completo') { %>
                                    <a href="/admin/inscricoes/<%= enroll.id %>/json" title="Baixar JSON do Certificado" class="text-indigo-600 transition-colors hover:text-indigo-800">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                    </a>
                                <% } %>
                                <form action="/admin/inscricoes/<%= enroll.id %>/status" method="POST" class="flex items-center justify-end gap-2">
                                    <select name="status" onchange="this.form.submit()" class="rounded-lg border border-gray-200 bg-white p-1 text-xs outline-none">
                                        <option value="pendente" <%= enroll.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                                        <option value="confirmado" <%= enroll.status === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
                                        <option value="completo" <%= enroll.status === 'completo' ? 'selected' : '' %>>Completo</option>
                                        <option value="cancelado" <%= enroll.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
                                    </select>
                                </form>
                                <a href="/admin/inscricoes/<%= enroll.id %>/editar" title="Editar Inscrição" class="text-blue-600 transition-colors hover:text-blue-800">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                </a>
                                <form action="/admin/inscricoes/<%= enroll.id %>/deletar" method="POST" class="inline" onsubmit="return confirm('Tem certeza que deseja excluir esta inscrição? Esta ação não pode ser desfeita.')">
                                    <button type="submit" title="Excluir Inscrição" class="text-red-600 transition-colors hover:text-red-800">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
                <% if (enrollments.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center italic text-gray-500">Nenhuma inscrição encontrada para a pesquisa informada.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between border-t border-gray-50 bg-gray-50 p-6">
            <span class="text-sm text-gray-500">Mostrando pagina <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
            <div class="flex space-x-2">
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <a href="?page=<%= i %>&search=<%= encodeURIComponent(filters.search || '') %>" class="rounded border border-gray-200 px-3 py-1 text-sm font-bold <%= pagination.currentPage === i ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100' %>">
                        <%= i %>
                    </a>
                <% } %>
            </div>
        </div>
    <% } %>
</div>

<div id="enrollment-details-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4">
    <div class="w-full max-w-xl rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
            <h3 class="text-base font-bold text-slate-800">Detalhes da Inscrição</h3>
            <button type="button" class="js-close-enroll-modal text-slate-400 hover:text-slate-700" aria-label="Fechar modal">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="grid grid-cols-1 gap-3 p-5 text-sm">
            <div><span class="font-semibold text-slate-700">Aluno:</span> <span id="enroll-modal-student" class="text-slate-600"></span></div>
            <div><span class="font-semibold text-slate-700">Email:</span> <span id="enroll-modal-email" class="text-slate-600"></span></div>
            <div><span class="font-semibold text-slate-700">Telefone:</span> <span id="enroll-modal-phone" class="text-slate-600"></span></div>
            <div><span class="font-semibold text-slate-700">Empresa:</span> <span id="enroll-modal-company" class="text-slate-600"></span></div>
            <div><span class="font-semibold text-slate-700">Curso:</span> <span id="enroll-modal-course" class="text-slate-600"></span></div>
            <div><span class="font-semibold text-slate-700">Local:</span> <span id="enroll-modal-location" class="text-slate-600"></span></div>
            <div><span class="font-semibold text-slate-700">Data:</span> <span id="enroll-modal-date" class="text-slate-600"></span></div>
            <div><span class="font-semibold text-slate-700">Status:</span> <span id="enroll-modal-status" class="text-slate-600"></span></div>
            <a id="enroll-modal-certificate" href="#" target="_blank" class="mt-2 hidden w-fit rounded-lg bg-indigo-50 px-3 py-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-100">Ver Certificado</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('enrollment-details-modal');
        const certLink = document.getElementById('enroll-modal-certificate');

        const closeModal = () => {
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };

        document.querySelectorAll('.js-enroll-details').forEach((btn) => {
            btn.addEventListener('click', function () {
                if (!modal) return;
                document.getElementById('enroll-modal-student').textContent = this.dataset.student || '-';
                document.getElementById('enroll-modal-email').textContent = this.dataset.email || '-';
                document.getElementById('enroll-modal-phone').textContent = this.dataset.phone || '-';
                document.getElementById('enroll-modal-company').textContent = this.dataset.company || '-';
                document.getElementById('enroll-modal-course').textContent = this.dataset.course || '-';
                document.getElementById('enroll-modal-location').textContent = this.dataset.location || '-';
                document.getElementById('enroll-modal-date').textContent = this.dataset.date || '-';
                document.getElementById('enroll-modal-status').textContent = this.dataset.status || '-';

                if (this.dataset.certificate) {
                    certLink.href = this.dataset.certificate;
                    certLink.classList.remove('hidden');
                } else {
                    certLink.href = '#';
                    certLink.classList.add('hidden');
                }

                modal.classList.remove('hidden');
                modal.classList.add('flex');
            });
        });

        document.querySelectorAll('.js-close-enroll-modal').forEach((el) => {
            el.addEventListener('click', closeModal);
        });

        modal && modal.addEventListener('click', function (event) {
            if (event.target === modal) closeModal();
        });
    });
</script>
