<section class="w-full max-w-6xl mr-auto space-y-6">
    <div class="rounded-3xl border border-slate-200 bg-white px-6 py-6 shadow-sm sm:px-7">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div class="max-w-2xl">
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Gestão documental</p>
                <h2 class="mt-3 text-2xl font-bold text-slate-900">Arquivo e validade da certidão</h2>
                <p class="mt-2 text-sm leading-6 text-slate-500">Atualize o nome exibido, substitua o PDF quando necessário e mantenha o vencimento sob controle sem repetir informações do topo da página.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-slate-600">Documento corporativo</span>
                <% if (certificate.hasExpiration) { %>
                    <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-amber-700">Com validade</span>
                <% } else { %>
                    <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-emerald-700">Vitalícia</span>
                <% } %>
            </div>
        </div>
    </div>

    <form action="/admin/certidoes/<%= certificate.id %>/editar" method="POST" enctype="multipart/form-data" class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
        <div class="space-y-6">
            <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 px-6 py-5">
                    <p class="text-lg font-bold text-slate-900">Dados do documento</p>
                    <p class="mt-1 text-sm text-slate-500">Mantenha o nome interno claro para facilitar localização e auditoria.</p>
                </div>

                <div class="space-y-6 px-6 py-6">
                    <div>
                        <label for="name" class="mb-2 block text-sm font-semibold text-slate-700">Nome do arquivo</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            value="<%= certificate.name %>"
                            required
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
                        >
                    </div>

                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <p class="text-sm font-semibold text-slate-800">Arquivo atual</p>
                                <p class="text-sm text-slate-500">O link abaixo aponta para o PDF já cadastrado.</p>
                            </div>
                            <a href="<%= certificate.fileUrl %>" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-white">
                                Ver PDF atual
                            </a>
                        </div>

                        <div class="mt-5">
                            <label for="certificateFile" class="mb-2 block text-sm font-semibold text-slate-700">Substituir arquivo PDF</label>
                            <input
                                type="file"
                                id="certificateFile"
                                name="certificateFile"
                                accept="application/pdf"
                                class="block w-full rounded-xl border border-dashed border-slate-300 bg-white px-4 py-3 text-sm text-slate-600 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-600 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-indigo-700"
                            >
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <a href="/admin/certidoes" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700">
                    Atualizar certid&atilde;o
                </button>
            </div>
        </div>

        <aside class="space-y-6">
            <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 px-6 py-5">
                    <p class="text-lg font-bold text-slate-900">Validade e controle</p>
                    <p class="mt-1 text-sm text-slate-500">Defina se a certidão expira e mantenha o vencimento atualizado.</p>
                </div>

                <div class="space-y-5 px-6 py-6">
                    <label class="flex items-start gap-3">
                        <input
                            type="checkbox"
                            id="hasExpiration"
                            name="hasExpiration"
                            value="1"
                            <%= certificate.hasExpiration ? 'checked' : '' %>
                            class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                        >
                        <span>
                            <span class="block text-sm font-semibold text-slate-800">A certid&atilde;o possui validade</span>
                            <span class="mt-1 block text-sm leading-6 text-slate-500">Desmarque para tratar a certid&atilde;o como vital&iacute;cia e remover a necessidade de vencimento.</span>
                        </span>
                    </label>

                    <div id="expirationDateWrapper" class="<%= certificate.hasExpiration ? '' : 'hidden' %>">
                        <label for="expirationDate" class="mb-2 block text-sm font-semibold text-slate-700">Data de expira&ccedil;&atilde;o</label>
                        <input
                            type="date"
                            id="expirationDate"
                            name="expirationDate"
                            value="<%= certificate.expirationDate || '' %>"
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
                        >
                    </div>
                </div>
            </div>
        </aside>
    </form>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const checkbox = document.getElementById('hasExpiration');
        const wrapper = document.getElementById('expirationDateWrapper');
        const input = document.getElementById('expirationDate');

        function syncExpirationField() {
            if (checkbox.checked) {
                wrapper.classList.remove('hidden');
                input.required = true;
            } else {
                wrapper.classList.add('hidden');
                input.required = false;
                input.value = '';
            }
        }

        checkbox.addEventListener('change', syncExpirationField);
        syncExpirationField();
    });
</script>
