<div class="space-y-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-slate-500">Total: <%= pagination ? pagination.totalItems : certificates.length %> certidão(ões).</p>
        <a href="/admin/certidoes/criar" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700">
            Nova certid&atilde;o
        </a>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">

    <% if (!certificates.length) { %>
        <div class="px-6 py-14 text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586A2 2 0 0114 3.586L18.414 8A2 2 0 0119 9.414V19a2 2 0 01-2 2z"></path>
                </svg>
            </div>
            <h3 class="mt-5 text-lg font-semibold text-slate-900">Nenhuma certid&atilde;o cadastrada</h3>
            <p class="mt-2 text-sm text-slate-500">Cadastre a primeira certid&atilde;o para disponibilizar o arquivo no site.</p>
        </div>
    <% } else { %>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100 text-left">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Nome</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Validade</th>
                        <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                        <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">A&ccedil;&otilde;es</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% certificates.forEach((certificate) => { %>
                        <tr class="hover:bg-slate-50/80">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-11 w-11 items-center justify-center rounded-xl <%= certificate.isExpired ? 'bg-rose-100 text-rose-600' : 'bg-indigo-100 text-indigo-600' %>">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7V3m10 4V3m-11 8h12m-2 10H8a2 2 0 01-2-2V7a2 2 0 012-2h1m8 0h1a2 2 0 012 2v12a2 2 0 01-2 2z"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900"><%= certificate.name %></p>
                                        <p class="text-xs text-slate-500">PDF cadastrado</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600"><%= certificate.expirationLabel %></td>
                            <td class="px-6 py-4">
                                <% if (certificate.isExpired) { %>
                                    <span class="inline-flex rounded-full border border-rose-200 bg-rose-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-rose-700">Vencida</span>
                                <% } else if (certificate.hasExpiration) { %>
                                    <span class="inline-flex rounded-full border border-amber-200 bg-amber-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-700">Com validade</span>
                                <% } else { %>
                                    <span class="inline-flex rounded-full border border-emerald-200 bg-emerald-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-700">Vitalicia</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/admin/certidoes/<%= certificate.id %>/editar" class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-slate-400 transition hover:bg-indigo-50 hover:text-indigo-600" title="Editar certidao">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </a>
                                    <form action="/admin/certidoes/<%= certificate.id %>/deletar" method="POST" onsubmit="return confirm('Deseja excluir esta certidao?')">
                                        <button type="submit" class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-slate-400 transition hover:bg-rose-50 hover:text-rose-600" title="Excluir certidao">
                                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <% if (pagination && pagination.totalPages > 1) { %>
            <div class="flex flex-col gap-3 border-t border-slate-100 px-6 py-4 md:flex-row md:items-center md:justify-between">
                <span class="text-sm text-slate-500">Mostrando pagina <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
                <div class="flex flex-wrap items-center gap-2">
                    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                        <a href="?page=<%= i %>" class="rounded border border-slate-200 px-3 py-1 text-sm font-bold <%= pagination.currentPage === i ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 hover:bg-slate-100' %>">
                            <%= i %>
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>
    <% } %>
    </div>
</div>
