<div class="space-y-6" x-data="{ showCreateUser: false, showFilters: <%= (filters.search || filters.status || filters.role) ? 'true' : 'false' %> }">
    <% if (success) { %>
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-medium text-emerald-800">
            <%= success %>
        </div>
    <% } %>

    <% if (error) { %>
        <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-medium text-red-800">
            <%= error %>
        </div>
    <% } %>

    <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
        <div class="border-b border-gray-100 bg-gray-50/50 p-6">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Cadastro rápido</p>
                        <p class="mt-2 text-sm text-slate-500">Cadastre um novo aluno ou administrador sem sair desta tela.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <button type="button" @click="showFilters = !showFilters" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900" :title="showFilters ? 'Ocultar filtros' : 'Mostrar filtros'">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 01.8 1.6L15 12v5a1 1 0 01-.553.894l-4 2A1 1 0 019 19v-7L3.2 4.6A1 1 0 013 4z"/>
                            </svg>
                        </button>
                        <button type="button" @click="showCreateUser = !showCreateUser" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-indigo-700">
                            <span x-text="showCreateUser ? 'Fechar cadastro' : 'Cadastrar usuário'"></span>
                        </button>
                    </div>
                </div>

                <form action="/admin/usuarios" method="GET" class="w-full xl:max-w-5xl" x-show="showFilters" x-cloak x-transition>
                    <div class="grid gap-3 rounded-xl border border-gray-100 bg-white p-4 shadow-sm md:grid-cols-4 md:items-end">
                        <div class="min-w-0 md:col-span-2">
                            <label for="search" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Pesquisar</label>
                            <input id="search" type="text" name="search" placeholder="Buscar por nome, email ou empresa..." value="<%= filters.search || '' %>" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label for="status" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Status</label>
                            <select id="status" name="status" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                                <option value="">Todos</option>
                                <option value="ativo" <%= filters.status === 'ativo' ? 'selected' : '' %>>Ativos</option>
                                <option value="inativo" <%= filters.status === 'inativo' ? 'selected' : '' %>>Inativos</option>
                            </select>
                        </div>
                        <div>
                            <label for="role" class="mb-1 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Perfil</label>
                            <select id="role" name="role" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                                <option value="">Todos</option>
                                <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                <option value="aluno" <%= filters.role === 'aluno' ? 'selected' : '' %>>Aluno</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-2 md:col-span-4 md:flex-row">
                            <button type="submit" class="w-full rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white transition-colors hover:bg-indigo-700 md:w-auto">Buscar</button>
                            <% if (filters.search || filters.status || filters.role) { %>
                                <a href="/admin/usuarios" class="w-full rounded-lg border border-slate-200 px-6 py-2.5 text-center text-sm font-semibold text-slate-500 transition-colors hover:bg-slate-50 md:w-auto">Limpar</a>
                            <% } %>
                        </div>
                    </div>
                </form>
            </div>

            <div x-show="showCreateUser" x-cloak x-transition class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <form action="/admin/usuarios/criar" method="POST" class="space-y-5">
                    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Nome</label>
                            <input type="text" name="name" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500" placeholder="Nome completo">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Email</label>
                            <input type="email" name="email" required class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500" placeholder="email@empresa.com">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Senha</label>
                            <input type="password" name="password" required minlength="6" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500" placeholder="Minimo 6 caracteres">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Perfil</label>
                            <select name="role" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500">
                                <option value="aluno">Aluno</option>
                                <option value="admin">Admin</option>
                            </select>
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Telefone</label>
                            <input type="text" name="phone" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500" placeholder="Opcional">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-bold uppercase tracking-[0.24em] text-slate-400">Empresa</label>
                            <input type="text" name="company" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500" placeholder="Opcional">
                        </div>
                    </div>

                    <label class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700">
                        <input type="checkbox" name="active" checked class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                        Criar conta ja ativa para login
                    </label>

                    <div class="flex justify-end">
                        <button type="submit" class="rounded-xl bg-slate-900 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-slate-800">
                            Salvar usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="overflow-x-auto">
            <style>
            @media (max-width: 1024px) {
                .responsive-table-users thead { display: none; }
                .responsive-table-users, .responsive-table-users tbody, .responsive-table-users tr, .responsive-table-users td { display: block; width: 100%; }
                .responsive-table-users tr { margin-bottom: 1rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem; }
                .responsive-table-users td { padding: 0.5rem 0; }
                .responsive-table-users td[data-label]::before { content: attr(data-label); display: block; margin-bottom: 0.35rem; font-weight: 700; color: #475569; }
                .responsive-table-users .actions { justify-content: flex-start; flex-wrap: wrap; }
            }
            </style>

            <table class="responsive-table-users w-full text-left">
                <thead class="bg-gray-50 text-xs font-bold uppercase text-gray-400">
                    <tr>
                        <th class="px-4 py-3 md:px-6 md:py-4">Usuário</th>
                        <th class="hidden px-4 py-3 md:px-6 md:py-4 lg:table-cell">Perfil</th>
                        <th class="px-4 py-3 md:px-6 md:py-4">Status</th>
                        <th class="hidden px-4 py-3 md:px-6 md:py-4 xl:table-cell">Cadastro</th>
                        <th class="px-4 py-3 text-right md:px-6 md:py-4">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <% users.forEach((managedUser) => { %>
                        <tr class="transition-colors hover:bg-gray-50/50">
                            <td class="px-4 py-3 md:px-6 md:py-4" data-label="Usuário">
                                <div class="flex items-center gap-3">
                                    <img class="h-11 w-11 rounded-full border border-slate-200 object-cover" src="<%= managedUser.avatar ? managedUser.avatar : ('https://ui-avatars.com/api/?name=' + encodeURIComponent(managedUser.name) + '&background=0f172a&color=fff') %>" alt="Avatar do usuario">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-bold text-gray-900"><%= managedUser.name %></span>
                                        <span class="text-xs text-gray-500"><%= managedUser.email %></span>
                                        <% if (managedUser.company) { %>
                                            <span class="mt-1 w-fit rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600"><%= managedUser.company %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td class="hidden px-4 py-3 md:px-6 md:py-4 lg:table-cell" data-label="Perfil">
                                <span class="rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide <%= managedUser.role === 'admin' ? 'bg-slate-900 text-white' : 'bg-indigo-50 text-indigo-700' %>">
                                    <%= managedUser.role %>
                                </span>
                            </td>
                            <td class="px-4 py-3 md:px-6 md:py-4" data-label="Status">
                                <span class="rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide <%= managedUser.active ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                                    <%= managedUser.active ? 'Ativo' : 'Pendente' %>
                                </span>
                                <% if (!managedUser.active && managedUser.confirmationExpires) { %>
                                    <p class="mt-2 text-xs text-slate-500">Link atual expira em <%= new Date(managedUser.confirmationExpires).toLocaleString('pt-BR') %></p>
                                <% } %>
                            </td>
                            <td class="hidden px-4 py-3 text-sm text-gray-500 md:px-6 md:py-4 xl:table-cell" data-label="Cadastro">
                                <%= new Date(managedUser.createdAt).toLocaleDateString('pt-BR') %>
                            </td>
                            <td class="px-4 py-3 text-right md:px-6 md:py-4" data-label="Ações">
                                <div class="actions flex items-center justify-end gap-3">
                                    <form action="/admin/usuarios/<%= managedUser.id %>/reenviar-acesso" method="POST" class="inline" onsubmit="return confirm('Deseja reenviar o email de acesso para este usuario?')">
                                        <button type="submit" class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700 transition-colors hover:bg-indigo-100">
                                            <%= managedUser.active ? 'Reenviar redefinicao' : 'Reenviar ativacao' %>
                                        </button>
                                    </form>
                                    <a href="/admin/usuarios/<%= managedUser.id %>/editar" title="Editar usuario" class="text-blue-600 transition-colors hover:text-blue-800">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </a>
                                    <% if (user.id !== managedUser.id) { %>
                                        <form action="/admin/usuarios/<%= managedUser.id %>/deletar" method="POST" class="inline" onsubmit="return confirm('Deseja excluir este usuario? Esta acao nao pode ser desfeita.')">
                                            <button type="submit" title="Excluir usuario" class="text-rose-600 transition-colors hover:text-rose-800">
                                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="5" class="px-6 py-10 text-center italic text-gray-500">Nenhum usuario encontrado para os filtros informados.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (pagination.totalPages > 1) { %>
            <div class="flex items-center justify-between border-t border-gray-50 bg-gray-50 p-6">
                <span class="text-sm text-gray-500">Mostrando pagina <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
                <div class="flex space-x-2">
                    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                        <a href="?page=<%= i %>&search=<%= encodeURIComponent(filters.search || '') %>&status=<%= encodeURIComponent(filters.status || '') %>&role=<%= encodeURIComponent(filters.role || '') %>" class="rounded border border-gray-200 px-3 py-1 text-sm font-bold <%= pagination.currentPage === i ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100' %>">
                            <%= i %>
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
</div>
