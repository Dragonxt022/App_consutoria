<div class="space-y-20 pb-16">
    <% if (homeBanners && homeBanners.length) { %>
        <section class="relative overflow-hidden bg-slate-100">
            <div x-data="{ activeBanner: 0, totalBanners: <%= homeBanners.length %> }" x-init="if (totalBanners > 1) { setInterval(() => { activeBanner = (activeBanner + 1) % totalBanners; }, 5000); }" class="relative">
                <div class="relative mx-auto h-[180px] w-full max-w-[1920px] overflow-hidden sm:h-[300px] md:h-[360px] lg:h-[440px] xl:h-[540px] 2xl:h-[620px]">
                    <div class="absolute inset-0 bg-slate-100"></div>
                    <% homeBanners.forEach((banner, index) => { %>
                        <% if (banner.link) { %>
                            <a
                                href="<%= banner.link %>"
                                <%= banner.newTab ? 'target="_blank" rel="noopener noreferrer"' : '' %>
                                x-show="activeBanner === <%= index %>"
                                x-transition.opacity.duration.500ms
                                class="absolute inset-0 block"
                                aria-label="<%= banner.name %>"
                            >
                                <img src="<%= banner.imageUrl %>" alt="<%= banner.name %>" class="h-[180px] w-full object-cover object-center sm:h-[300px] md:h-[360px] lg:h-[440px] xl:h-[540px] 2xl:h-[620px]">
                            </a>
                        <% } else { %>
                            <div
                                x-show="activeBanner === <%= index %>"
                                x-transition.opacity.duration.500ms
                                class="absolute inset-0"
                            >
                                <img src="<%= banner.imageUrl %>" alt="<%= banner.name %>" class="h-[180px] w-full object-cover object-center sm:h-[300px] md:h-[360px] lg:h-[440px] xl:h-[540px] 2xl:h-[620px]">
                            </div>
                        <% } %>
                    <% }) %>

                    <div class="pointer-events-none absolute inset-x-0 bottom-0 px-3 py-2 sm:px-6 sm:py-4 lg:px-10">
                        <div class="mx-auto flex max-w-7xl justify-center sm:justify-end">
                            <% if (homeBanners.length > 1) { %>
                                <div class="pointer-events-auto flex items-center gap-1.5 sm:gap-2 rounded-full bg-transparent px-0 py-0 sm:bg-slate-950/45 sm:px-2.5 sm:py-2 sm:backdrop-blur-sm sm:shadow-lg">
                                    <% homeBanners.forEach((banner, index) => { %>
                                        <button type="button" @click="activeBanner = <%= index %>" class="rounded-full transition-all" :class="activeBanner === <%= index %> ? 'h-3 w-3 bg-white ring-2 ring-white/70 sm:h-2.5 sm:w-7 sm:ring-0' : 'h-2.5 w-2.5 bg-white/65 hover:bg-white/85 sm:h-2.5 sm:w-2.5'" aria-label="Ir para banner <%= index + 1 %>"></button>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    <% } else { %>
        <section class="relative overflow-hidden bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.18),_transparent_32%),radial-gradient(circle_at_bottom_right,_rgba(249,115,22,0.20),_transparent_30%),linear-gradient(135deg,_#f8fafc_0%,_#eef2ff_45%,_#fff7ed_100%)]">
            <div class="absolute inset-0 opacity-40">
                <div class="absolute left-10 top-12 h-28 w-28 rounded-full border border-indigo-200"></div>
                <div class="absolute right-20 top-24 h-40 w-40 rounded-full border border-amber-200"></div>
                <div class="absolute bottom-10 left-1/3 h-20 w-20 rounded-full bg-indigo-100 blur-2xl"></div>
            </div>

            <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
                <div class="max-w-4xl">
                    <span class="inline-flex w-fit items-center rounded-full border border-indigo-200 bg-white/80 px-4 py-2 text-xs font-black uppercase tracking-[0.25em] text-indigo-700 shadow-sm">
                        Treinamentos Presenciais de Alto Impacto
                    </span>
                    <h1 class="mt-6 text-4xl font-black leading-[0.95] text-slate-950 sm:text-5xl lg:text-7xl">
                        Formacao executiva com foco em
                        <span class="bg-gradient-to-r from-indigo-600 via-indigo-500 to-amber-500 bg-clip-text text-transparent">resultado real</span>
                    </h1>
                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
                        Desenvolvemos pessoas, equipes e lideranças com cursos presenciais intensivos, linguagem prática e aplicação imediata no setor público e corporativo.
                    </p>
                </div>
            </div>
        </section>
    <% } %>

    <section id="cursos" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <span class="text-xs font-black uppercase tracking-[0.25em] text-indigo-600">Agenda de Cursos</span>
                <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Próximos cursos presenciais</h2>
                <p class="mt-3 max-w-2xl text-lg text-slate-500">Programas criados para quem precisa de conteúdo técnico, clareza executiva e aplicação prática no dia seguinte.</p>
            </div>
            <a href="/cursos" class="inline-flex items-center rounded-2xl border border-slate-300 px-5 py-3 text-sm font-black uppercase tracking-wider text-slate-700 transition hover:border-indigo-300 hover:text-indigo-700">
                Ver todos
            </a>
        </div>

        <div class="mt-10 grid items-stretch gap-8 md:grid-cols-2 xl:grid-cols-3">
            <% courses.forEach(course => { %>
                <article class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
                    <div class="relative h-60 overflow-hidden border-b border-slate-100 bg-slate-50">
                        <div class="flex h-full w-full items-center justify-center p-4">
                            <%- imgTag(course.image, course.title, 'h-full w-full object-contain object-center transition-transform duration-500 group-hover:scale-[1.02]', 'course') %>
                        </div>
                        <% if (course.statusCode === 'confirmado') { %>
                            <div class="absolute left-4 top-4">
                                <span class="inline-flex items-center rounded-full border border-cyan-300 bg-gradient-to-r from-cyan-500 via-sky-500 to-blue-600 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.22em] text-white shadow-lg shadow-cyan-200 ring-4 ring-white/70 backdrop-blur-sm">
                                    <svg class="mr-1.5 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"/></svg>
                                    Confirmado
                                </span>
                            </div>
                        <% } else if (course.statusCode === 'encerrado') { %>
                            <div class="absolute left-4 top-4">
                                <span class="inline-flex items-center rounded-full border border-rose-200 bg-white/95 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] text-rose-700 shadow-md ring-2 ring-white/70 backdrop-blur-sm">Encerrado</span>
                            </div>
                        <% } %>
                    </div>

                    <div class="flex flex-1 flex-col p-6">
                        <div class="space-y-5 flex-1">
                            <div class="mb-4 flex flex-wrap items-center gap-2">
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600">Presencial</span>
                                <span class="rounded-full bg-amber-50 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-amber-700"><%= course.priceDisplay %></span>
                            </div>
                            <h3 class="text-2xl font-black leading-tight text-slate-900"><%= course.title %></h3>
                            <p class="mt-3 line-clamp-3 text-base leading-7 text-slate-500"><%= course.descriptionPlain %></p>
                            <div class="mt-auto space-y-5">
                                <div class="grid grid-cols-2 gap-3 rounded-2xl bg-slate-50 p-4">
                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Local</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-700"><%= course.location %></p>
                                    </div>
                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Carga horária</p>
                                        <p class="mt-2 text-sm font-semibold text-slate-700"><%= course.workload || 'Consulte' %></p>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between border-t border-slate-100 pt-4">
                                    <% if (course.isExpired) { %>
                                        <span class="rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-black uppercase tracking-wider text-rose-700">Inscrições encerradas</span>
                                    <% } else { %>
                                        <a href="/curso/<%= course.id %>" class="inline-flex items-center rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-black uppercase tracking-wider text-white transition hover:bg-indigo-700">
                                            Saber Mais
                                        </a>
                                    <% } %>
                                    <span class="text-sm font-semibold text-slate-400"><%= course.priceDisplay %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>

    <% if (featuredProducts && featuredProducts.length) { %>
        <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="overflow-hidden rounded-[2rem] bg-slate-950 px-6 py-10 text-white sm:px-8 lg:px-10">
                <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
                    <div>
                        <span class="text-xs font-black uppercase tracking-[0.25em] text-amber-300">Loja Afiliada</span>
                        <h2 class="mt-3 text-3xl font-black sm:text-4xl">Materiais e ofertas em destaque</h2>
                        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-300">Seleção de produtos complementares para acelerar implantação, estudo e execução do conhecimento.</p>
                    </div>
                    <a href="/loja" class="inline-flex items-center rounded-2xl bg-white px-5 py-3 text-sm font-black uppercase tracking-wider text-slate-900 transition hover:bg-amber-100">
                        Ir para loja
                    </a>
                </div>

                <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                    <% featuredProducts.forEach(product => { %>
                        <article class="overflow-hidden rounded-[1.5rem] border border-white/10 bg-white/5 backdrop-blur transition hover:-translate-y-1 hover:bg-white/10">
                            <div class="relative flex h-56 items-center justify-center border-b border-white/10 bg-slate-900/70 p-4">
                                <% if (product.primaryImage) { %>
                                    <img src="<%= product.primaryImage %>" alt="<%= product.name %>" class="h-full w-full object-contain object-center">
                                <% } else { %>
                                    <div class="flex h-full w-full items-center justify-center text-slate-500">
                                        <svg class="h-16 w-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-4m-8 0H4m8 0v4"></path></svg>
                                    </div>
                                <% } %>
                                <span class="absolute left-4 top-4 rounded-full bg-amber-400 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-slate-950"><%= product.category || 'Geral' %></span>
                            </div>

                            <div class="space-y-4 p-5">
                                <div>
                                    <h3 class="text-xl font-black text-white"><%= product.name %></h3>
                                    <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-300"><%= product.shortDescription %></p>
                                </div>

                                <div class="flex items-center justify-between">
                                    <span class="text-lg font-black text-white"><%= product.price || 'Consulte' %></span>
                                    <a href="/loja/<%= product.slug %>" class="inline-flex items-center rounded-2xl bg-indigo-500 px-4 py-2 text-sm font-black uppercase tracking-wider text-white transition hover:bg-indigo-400">
                                        Ver Produto
                                    </a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </div>
        </section>
    <% } %>

    <% if (latestBlogPosts && latestBlogPosts.length) { %>
        <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
                <div>
                    <span class="text-xs font-black uppercase tracking-[0.25em] text-indigo-600">Blog</span>
                    <h2 class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Últimas notícias e publicações</h2>
                    <p class="mt-3 max-w-2xl text-lg text-slate-500">Conteúdos recentes para acompanhar novidades, eventos e análises práticas da nossa atuação.</p>
                </div>
            </div>

            <div class="mt-10 grid gap-8 md:grid-cols-2 xl:grid-cols-4">
                <% latestBlogPosts.forEach((post) => { %>
                    <article class="border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                        <% if (post.coverImage) { %>
                            <div class="h-56 bg-slate-100">
                                <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="h-full w-full object-cover">
                            </div>
                        <% } %>
                        <div class="space-y-4 p-6">
                            <div class="flex flex-wrap items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                                <span><%= post.category ? post.category.name : 'Outros' %></span>
                                <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                                <span><%= new Date(post.publishedAt || post.createdAt).toLocaleDateString('pt-BR') %></span>
                            </div>
                            <h3 class="line-clamp-3 text-2xl font-black leading-tight text-slate-900"><%= post.title %></h3>
                            <p class="line-clamp-3 text-sm leading-7 text-slate-500"><%= post.excerpt || 'Clique para ler a publicação completa.' %></p>
                            <a href="/blog/<%= post.slug %>" class="inline-flex items-center text-sm font-black uppercase tracking-wider text-indigo-600 transition hover:text-indigo-700">
                                Ler matéria
                            </a>
                        </div>
                    </article>
                <% }) %>
            </div>

            <div class="mt-8 flex justify-center">
                <a href="/blog" class="inline-flex items-center rounded-2xl bg-slate-900 px-6 py-3 text-sm font-black uppercase tracking-wider text-white transition hover:bg-indigo-600">
                    Ir para o blog
                </a>
            </div>
        </section>
    <% } %>

    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-3">
            <div class="rounded-[1.75rem] border border-slate-200 bg-white p-8 shadow-sm">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-white">
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <h3 class="mt-6 text-2xl font-black text-slate-900">Método direto</h3>
                <p class="mt-3 text-base leading-7 text-slate-500">Conteúdo objetivo, exemplos concretos e foco total em aplicação rápida no ambiente profissional.</p>
            </div>

            <div class="rounded-[1.75rem] border border-slate-200 bg-white p-8 shadow-sm">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-500 text-white">
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </div>
                <h3 class="mt-6 text-2xl font-black text-slate-900">Especialistas de campo</h3>
                <p class="mt-3 text-base leading-7 text-slate-500">Instrução conduzida por profissionais com experiência de execução, gestão e consultoria.</p>
            </div>

            <div class="rounded-[1.75rem] border border-slate-200 bg-white p-8 shadow-sm">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-500 text-white">
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h3 class="mt-6 text-2xl font-black text-slate-900">Certificação de valor</h3>
                <p class="mt-3 text-base leading-7 text-slate-500">Certificados e trilhas de conteúdo que fortalecem reputação técnica e posicionamento profissional.</p>
            </div>
        </div>
    </section>
</div>
