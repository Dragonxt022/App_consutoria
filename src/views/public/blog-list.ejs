<section class="bg-slate-950 py-20 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-black uppercase tracking-[0.3em] text-amber-300">Blog</p>
        <h1 class="mt-4 text-4xl font-black sm:text-5xl"><%= currentCategory ? currentCategory.name : 'Conteúdos, análises e novidades' %></h1>
        <p class="mt-4 max-w-2xl text-lg text-slate-300">
            <%= currentCategory ? `Publicações da categoria ${currentCategory.name}.` : 'Artigos publicados pela equipe para aprofundar temas de gestão, controle interno e atuação prática.' %>
        </p>
    </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        <% if (!posts.length) { %>
            <div class="md:col-span-2 xl:col-span-3 rounded-3xl border border-slate-200 bg-white p-10 text-center text-slate-500 shadow-sm">Nenhum artigo publicado no momento.</div>
        <% } %>
        <% posts.forEach((post) => { %>
            <a href="/blog/<%= post.slug %>" class="group block">
                <article class="border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                    <div class="h-56 bg-slate-100">
                        <% if (post.coverImage) { %>
                            <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="h-full w-full object-cover">
                        <% } %>
                    </div>
                    <div class="space-y-4 p-6">
                        <div class="flex flex-wrap gap-2">
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-slate-600"><%= post.category ? post.category.name : 'Outros' %></span>
                            <span class="rounded-full bg-indigo-50 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-indigo-700"><%= new Date(post.publishedAt || post.createdAt).toLocaleDateString('pt-BR') %></span>
                        </div>
                        <h2 class="text-2xl font-black text-slate-900 transition-colors group-hover:text-indigo-600"><%= post.title %></h2>
                        <p class="line-clamp-3 text-sm leading-7 text-slate-500"><%= post.excerpt || 'Sem resumo disponível.' %></p>
                        <div class="flex items-center justify-between border-t border-slate-100 pt-4">
                            <span class="text-sm text-slate-400">Por <%= post.author ? post.author.name : 'Equipe' %></span>
                            <span class="text-sm font-black uppercase tracking-wider text-indigo-600 transition group-hover:text-indigo-700">Ler matéria</span>
                        </div>
                    </div>
                </article>
            </a>
        <% }) %>
    </div>
</section>
