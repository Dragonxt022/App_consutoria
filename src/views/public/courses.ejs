<div class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-16">
            <h1 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">Catálogo de Treinamentos</h1>
            <p class="mt-4 text-xl text-slate-500 max-w-3xl mx-auto">
                Explore nossa lista completa de cursos presenciais e workshops de alta performance. Encontre a especialização ideal para o seu momento profissional.
            </p>
            <div class="mt-6 h-1 w-24 bg-indigo-600 mx-auto rounded-full"></div>
        </div>

        <!-- Courses Grid -->
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            <% if (courses.length === 0) { %>
                <div class="col-span-full py-20 text-center">
                    <div class="bg-white p-12 rounded-2xl shadow-sm inline-block">
                        <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                        <h3 class="text-xl font-bold text-slate-800">Nenhum curso disponível momento</h3>
                        <p class="text-slate-500 mt-2">Estamos preparando novos conteúdos incríveis para você. Volte em breve!</p>
                        <a href="/" class="mt-6 inline-block text-indigo-600 font-bold hover:underline">Voltar para Início</a>
                    </div>
                </div>
            <% } else { %>
                <% courses.forEach(course => { %>
                    <a href="/curso/<%= course.id %>" class="group block">
                        <article class="flex h-full flex-col rounded-2xl border border-slate-100 bg-white shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
                            <div class="relative aspect-video border-b border-slate-100 bg-slate-50">
                                <%- imgTag(course.image, course.title, 'w-full h-full object-contain object-center p-3 transition-transform duration-500 group-hover:scale-[1.02]', 'course') %>
                                <% if (course.statusCode === 'confirmado') { %>
                                    <div class="absolute left-4 top-4">
                                        <span class="inline-flex items-center rounded-full border border-blue-700 bg-blue-600 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.22em] text-white shadow-md shadow-blue-200 ring-2 ring-white/80">
                                            <svg class="mr-1.5 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"/></svg>
                                            Confirmado
                                        </span>
                                    </div>
                                <% } else if (course.statusCode === 'encerrado') { %>
                                    <div class="absolute left-4 top-4">
                                        <span class="inline-flex items-center rounded-full border border-amber-200 bg-white/95 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] text-amber-700 shadow-md ring-2 ring-white/70 backdrop-blur-sm">Encerrado</span>
                                    </div>
                                <% } else if (course.statusCode === 'desativado') { %>
                                    <div class="absolute left-4 top-4">
                                        <span class="inline-flex items-center rounded-full border border-red-200 bg-white/95 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.18em] text-red-700 shadow-md ring-2 ring-white/70 backdrop-blur-sm">Desativado</span>
                                    </div>
                                <% } %>
                                <div class="absolute top-4 right-4">
                                    <span class="rounded-full border border-indigo-50 bg-white/90 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-indigo-600 shadow-sm backdrop-blur">
                                        Presencial
                                    </span>
                                </div>
                            </div>

                            <div class="flex flex-1 flex-col p-6">
                                <div class="flex-1">
                                    <div class="mb-2 flex flex-wrap items-center gap-2">
                                        <div class="flex items-center text-xs font-bold uppercase tracking-widest text-indigo-600">
                                            <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                            <%= new Date(course.startDate).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %>
                                        </div>
                                    </div>
                                    <h3 class="text-xl font-bold text-slate-900 transition-colors group-hover:text-indigo-600">
                                        <%= course.title %>
                                    </h3>
                                    <div class="mt-3 flex items-center text-sm text-slate-500">
                                        <svg class="mr-1 h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        </svg>
                                        <%= course.location %>
                                    </div>
                                    <p class="mt-4 line-clamp-2 text-sm leading-relaxed text-slate-600">
                                        <%= course.descriptionPlain %>
                                    </p>
                                </div>

                                <div class="mt-8 flex items-center justify-between border-t border-slate-50 pt-6">
                                    <div>
                                        <p class="text-[10px] font-bold uppercase tracking-tighter text-slate-400">Investimento</p>
                                        <p class="text-lg font-black text-indigo-600"><%= course.priceDisplay %></p>
                                    </div>
                                    <% if (course.isExpired) { %>
                                        <span class="rounded-xl bg-slate-100 px-4 py-2 text-xs font-black uppercase tracking-widest text-slate-400">Encerrado</span>
                                    <% } else { %>
                                        <span class="inline-flex items-center rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-black uppercase tracking-widest text-white transition-all group-hover:bg-slate-900">
                                            Garantir Vaga
                                            <svg class="ml-2 h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </article>
                    </a>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>
