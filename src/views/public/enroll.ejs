<div class="max-w-4xl mx-auto mt-12 bg-white rounded-2xl shadow-xl overflow-hidden">
    <div class="bg-indigo-600 p-8 text-white text-center">
        <h1 class="text-3xl font-bold">Ficha de Inscrição</h1>
        <p class="mt-2 text-indigo-100">Curso: <%= course.title %></p>
    </div>

    <% if (lastEnrollment) { %>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-6 text-amber-800">
            <div class="flex items-start">
                <svg class="w-6 h-6 mr-3 flex-shrink-0 text-amber-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <div>
                    <h3 class="font-bold text-lg mb-2">Dados da Última Inscrição Detectados</h3>
                    <p class="text-sm mb-3">Detectamos que você já possui uma inscrição anterior. Os campos abaixo foram pré-preenchidos com seus dados da última inscrição. <strong>Por favor, revise e atualize os dados antes de confirmar sua nova inscrição.</strong></p>
                    <div class="text-xs font-semibold">
                        Inscrição anterior em: <%= new Date(lastEnrollment.createdAt).toLocaleDateString('pt-BR') %>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <form action="/inscrever" method="POST" class="p-8 space-y-6">
        <input type="hidden" name="courseId" value="<%= course.id %>">
        
        <!-- Dados Pessoais -->
        <div class="border-b pb-6">
            <h2 class="text-lg font-bold text-gray-800 mb-4">Dados Pessoais</h2>
            
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nome Completo</label>
                    <input type="text" id="name" name="name" required value="<%= lastEnrollment ? lastEnrollment.studentName : (user ? user.name : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Seu nome completo">
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">E-mail Corporativo</label>
                    <input type="email" id="email" name="email" required value="<%= lastEnrollment ? lastEnrollment.studentEmail : (user ? user.email : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="exemplo@empresa.com.br">
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mt-6">
                <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">WhatsApp / Telefone</label>
                    <input type="tel" id="phone" name="phone" required value="<%= lastEnrollment ? lastEnrollment.studentPhone : (user && user.phone ? user.phone : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="(00) 00000-0000" data-mask="(00) 00000-0000">
                </div>
                <div>
                    <label for="cpfCnpj" class="block text-sm font-medium text-gray-700 mb-1">CPF ou CNPJ</label>
                    <input type="text" id="cpfCnpj" name="cpfCnpj" value="<%= lastEnrollment ? lastEnrollment.cpfCnpj : (user && user.cpfCnpj ? user.cpfCnpj : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="000.000.000-00 ou 00.000.000/0000-00" data-mask-cpf-cnpj>
                </div>
            </div>
        </div>

        <!-- Dados Corporativos -->
        <div class="border-b pb-6">
            <h2 class="text-lg font-bold text-gray-800 mb-4">Dados Corporativos</h2>
            
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label for="company" class="block text-sm font-medium text-gray-700 mb-1">Empresa / Organização</label>
                    <input type="text" id="company" name="company" value="<%= lastEnrollment ? lastEnrollment.company : (user && user.company ? user.company : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Nome da sua empresa">
                </div>
                <div>
                    <label for="entePublico" class="block text-sm font-medium text-gray-700 mb-1">Tipo de Organização</label>
                    <select id="entePublico" name="entePublico" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                        <option value="">Selecione uma opção</option>
                        <option value="0" <% if (lastEnrollment && lastEnrollment.entePublico === 0 || (user && user.entePublico === false)) { %>selected<% } %>>Setor Privado</option>
                        <option value="1" <% if (lastEnrollment && lastEnrollment.entePublico === 1 || (user && user.entePublico === true)) { %>selected<% } %>>Ente Público</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Dados de Endereço -->
        <div class="border-b pb-6">
            <h2 class="text-lg font-bold text-gray-800 mb-4">Endereço</h2>
            
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label for="pais" class="block text-sm font-medium text-gray-700 mb-1">País</label>
                    <input type="text" id="pais" name="pais" value="<%= lastEnrollment ? lastEnrollment.pais : (user && user.pais ? user.pais : 'Brasil') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Brasil">
                </div>
                <div>
                    <label for="cep" class="block text-sm font-medium text-gray-700 mb-1">CEP</label>
                    <input type="text" id="cep" name="cep" value="<%= lastEnrollment ? lastEnrollment.cep : (user && user.cep ? user.cep : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="00000-000" data-mask="00000-000">
                </div>
            </div>

            <div class="mt-6">
                <label for="endereco" class="block text-sm font-medium text-gray-700 mb-1">Endereço Completo</label>
                <input type="text" id="endereco" name="endereco" value="<%= lastEnrollment ? lastEnrollment.endereco : (user && user.endereco ? user.endereco : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Rua, número, complemento">
            </div>

            <div class="grid md:grid-cols-2 gap-6 mt-6">
                <div>
                    <label for="cidade" class="block text-sm font-medium text-gray-700 mb-1">Cidade</label>
                    <input type="text" id="cidade" name="cidade" value="<%= lastEnrollment ? lastEnrollment.cidade : (user && user.cidade ? user.cidade : '') %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="São Paulo">
                </div>
                <div>
                    <label for="estado" class="block text-sm font-medium text-gray-700 mb-1">Estado / UF</label>
                    <select id="estado" name="estado" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                        <option value="">Selecione um estado</option>
                        <option value="AC" <% if (lastEnrollment && lastEnrollment.estado === 'AC' || (user && user.estado === 'AC')) { %>selected<% } %>>Acre</option>
                        <option value="AL" <% if (lastEnrollment && lastEnrollment.estado === 'AL' || (user && user.estado === 'AL')) { %>selected<% } %>>Alagoas</option>
                        <option value="AP" <% if (lastEnrollment && lastEnrollment.estado === 'AP' || (user && user.estado === 'AP')) { %>selected<% } %>>Amapá</option>
                        <option value="AM" <% if (lastEnrollment && lastEnrollment.estado === 'AM' || (user && user.estado === 'AM')) { %>selected<% } %>>Amazonas</option>
                        <option value="BA" <% if (lastEnrollment && lastEnrollment.estado === 'BA' || (user && user.estado === 'BA')) { %>selected<% } %>>Bahia</option>
                        <option value="CE" <% if (lastEnrollment && lastEnrollment.estado === 'CE' || (user && user.estado === 'CE')) { %>selected<% } %>>Ceará</option>
                        <option value="DF" <% if (lastEnrollment && lastEnrollment.estado === 'DF' || (user && user.estado === 'DF')) { %>selected<% } %>>Distrito Federal</option>
                        <option value="ES" <% if (lastEnrollment && lastEnrollment.estado === 'ES' || (user && user.estado === 'ES')) { %>selected<% } %>>Espírito Santo</option>
                        <option value="GO" <% if (lastEnrollment && lastEnrollment.estado === 'GO' || (user && user.estado === 'GO')) { %>selected<% } %>>Goiás</option>
                        <option value="MA" <% if (lastEnrollment && lastEnrollment.estado === 'MA' || (user && user.estado === 'MA')) { %>selected<% } %>>Maranhão</option>
                        <option value="MT" <% if (lastEnrollment && lastEnrollment.estado === 'MT' || (user && user.estado === 'MT')) { %>selected<% } %>>Mato Grosso</option>
                        <option value="MS" <% if (lastEnrollment && lastEnrollment.estado === 'MS' || (user && user.estado === 'MS')) { %>selected<% } %>>Mato Grosso do Sul</option>
                        <option value="MG" <% if (lastEnrollment && lastEnrollment.estado === 'MG' || (user && user.estado === 'MG')) { %>selected<% } %>>Minas Gerais</option>
                        <option value="PA" <% if (lastEnrollment && lastEnrollment.estado === 'PA' || (user && user.estado === 'PA')) { %>selected<% } %>>Pará</option>
                        <option value="PB" <% if (lastEnrollment && lastEnrollment.estado === 'PB' || (user && user.estado === 'PB')) { %>selected<% } %>>Paraíba</option>
                        <option value="PR" <% if (lastEnrollment && lastEnrollment.estado === 'PR' || (user && user.estado === 'PR')) { %>selected<% } %>>Paraná</option>
                        <option value="PE" <% if (lastEnrollment && lastEnrollment.estado === 'PE' || (user && user.estado === 'PE')) { %>selected<% } %>>Pernambuco</option>
                        <option value="PI" <% if (lastEnrollment && lastEnrollment.estado === 'PI' || (user && user.estado === 'PI')) { %>selected<% } %>>Piauí</option>
                        <option value="RJ" <% if (lastEnrollment && lastEnrollment.estado === 'RJ' || (user && user.estado === 'RJ')) { %>selected<% } %>>Rio de Janeiro</option>
                        <option value="RN" <% if (lastEnrollment && lastEnrollment.estado === 'RN' || (user && user.estado === 'RN')) { %>selected<% } %>>Rio Grande do Norte</option>
                        <option value="RS" <% if (lastEnrollment && lastEnrollment.estado === 'RS' || (user && user.estado === 'RS')) { %>selected<% } %>>Rio Grande do Sul</option>
                        <option value="RO" <% if (lastEnrollment && lastEnrollment.estado === 'RO' || (user && user.estado === 'RO')) { %>selected<% } %>>Rondônia</option>
                        <option value="RR" <% if (lastEnrollment && lastEnrollment.estado === 'RR' || (user && user.estado === 'RR')) { %>selected<% } %>>Roraima</option>
                        <option value="SC" <% if (lastEnrollment && lastEnrollment.estado === 'SC' || (user && user.estado === 'SC')) { %>selected<% } %>>Santa Catarina</option>
                        <option value="SP" <% if (lastEnrollment && lastEnrollment.estado === 'SP' || (user && user.estado === 'SP')) { %>selected<% } %>>São Paulo</option>
                        <option value="SE" <% if (lastEnrollment && lastEnrollment.estado === 'SE' || (user && user.estado === 'SE')) { %>selected<% } %>>Sergipe</option>
                        <option value="TO" <% if (lastEnrollment && lastEnrollment.estado === 'TO' || (user && user.estado === 'TO')) { %>selected<% } %>>Tocantins</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Observações -->
        <div>
            <label for="observations" class="block text-sm font-medium text-gray-700 mb-1">Observações ou Restrições Alimentares</label>
            <textarea id="observations" name="observations" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Alguma informação adicional para o coffee break ou dinâmica?"><%= lastEnrollment ? lastEnrollment.observations : '' %></textarea>
        </div>

        <% if (!user) { %>
            <div class="bg-indigo-50 p-6 rounded-xl border border-indigo-100 flex items-start">
                <div class="flex items-center h-5">
                    <input id="create_account" name="create_account" type="checkbox" required class="focus:ring-indigo-500 h-5 w-5 text-indigo-600 border-gray-300 rounded">
                </div>
                <div class="ml-4 text-sm">
                    <label for="create_account" class="font-bold text-indigo-900">Não identificamos uma conta com seu e-mail.</label>
                    <p class="text-indigo-700">Deseja criar uma conta agora para gerenciar sua inscrição e acessar seus certificados? <br>
                    <span class="text-xs font-bold uppercase tracking-tighter">(Obrigatório para prosseguir com a inscrição)</span></p>
                </div>
            </div>
        <% } %>

        <div class="flex items-start">
            <div class="flex items-center h-5">
                <input id="privacy" name="privacy" type="checkbox" required class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
            </div>
            <div class="ml-3 text-sm">
                <label for="privacy" class="font-medium text-gray-700">Concordo com os termos e política de privacidade</label>
                <p class="text-gray-500">Ao se inscrever, você autoriza o contato de nossos consultores para finalização da matrícula.</p>
            </div>
        </div>

        <div class="pt-4">
            <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-4 px-6 rounded-lg hover:bg-indigo-700 shadow-lg transform active:scale-95 transition-all text-lg">
                Finalizar Minha Inscrição
            </button>
        </div>
        
        <div class="text-center">
            <a href="/curso/<%= course.id %>" class="text-indigo-600 hover:text-indigo-500 text-sm font-medium">← Voltar para detalhes do curso</a>
        </div>
    </form>
</div>

<!-- Scripts para máscaras -->
<script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/inputmask.min.js"></script>
<script>
    // Máscara para telefone
    Inputmask("(99) 99999-9999").mask(document.getElementById("phone"));
    
    // Máscara para CEP
    Inputmask("99999-999").mask(document.getElementById("cep"));
    
    // Máscara dinâmica para CPF ou CNPJ
    const cpfCnpjInput = document.getElementById("cpfCnpj");
    let isCPF = true;
    
    cpfCnpjInput.addEventListener("input", function(e) {
        let value = e.target.value.replace(/\D/g, "");
        
        if (value.length <= 11) {
            // Formata como CPF: 000.000.000-00
            isCPF = true;
            value = value.replace(/(\d{3})(\d)/, "$1.$2");
            value = value.replace(/(\d{3})\.(\d{3})(\d)/, "$1.$2.$3");
            value = value.replace(/(\d{3})\.(\d{3})\.(\d{3})(\d)/, "$1.$2.$3-$4");
        } else {
            // Formata como CNPJ: 00.000.000/0000-00
            isCPF = false;
            value = value.replace(/(\d{2})(\d)/, "$1.$2");
            value = value.replace(/(\d{2})\.(\d{3})(\d)/, "$1.$2.$3");
            value = value.replace(/(\d{2})\.(\d{3})\.(\d{3})(\d)/, "$1.$2.$3/$4");
            value = value.replace(/(\d{2})\.(\d{3})\.(\d{3})\/(\d{4})(\d)/, "$1.$2.$3/$4-$5");
        }
        
        e.target.value = value;
    });
</script>
