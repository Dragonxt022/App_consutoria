<div class="max-w-7xl mx-auto mt-6 px-4 md:px-6 lg:px-8">
    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden">
        <div class="border-b border-slate-100 bg-slate-50/60 px-8 py-6">
            <nav class="mb-6" aria-label="Breadcrumb">
                <ol class="flex flex-wrap items-center gap-2 text-sm">
                    <li><a href="/" class="rounded-full bg-slate-100 px-3 py-1.5 font-medium text-slate-500 transition hover:bg-slate-200 hover:text-slate-700">Início</a></li>
                    <li class="text-slate-300">/</li>
                    <li><a href="/loja" class="rounded-full bg-indigo-50 px-3 py-1.5 font-semibold text-indigo-700">Loja</a></li>
                    <li class="text-slate-300">/</li>
                    <li class="max-w-full truncate rounded-full bg-slate-900 px-3 py-1.5 font-semibold text-white"><%= product.name %></li>
                </ol>
            </nav>
            <p class="mb-2 text-xs font-black uppercase tracking-[0.3em] text-indigo-500"><%= product.category || 'Geral' %></p>
            <h1 class="text-3xl md:text-5xl font-bold text-slate-900"><%= product.name %></h1>
        </div>

    <div class="p-8 md:p-12 grid md:grid-cols-3 gap-8">
        <div class="md:col-span-2 space-y-6">
            <section class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="grid gap-4 md:grid-cols-[88px_minmax(0,1fr)]">
                    <div class="order-2 flex gap-3 overflow-x-auto md:order-1 md:flex-col">
                        <% if (product.galleryImages && product.galleryImages.length) { %>
                            <% product.galleryImages.forEach((image, index) => { %>
                                <button
                                    type="button"
                                    class="js-gallery-thumb flex h-20 w-20 flex-shrink-0 items-center justify-center overflow-hidden border <%= index === 0 ? 'border-indigo-500 ring-2 ring-indigo-200' : 'border-slate-200' %> bg-white"
                                    data-image="<%= image %>"
                                >
                                    <img src="<%= image %>" alt="<%= product.name %> <%= index + 1 %>" class="h-full w-full object-contain object-center p-1">
                                </button>
                            <% }) %>
                        <% } %>
                    </div>

                    <div class="order-1 overflow-hidden border border-slate-200 bg-white md:order-2">
                        <% if (product.primaryImage) { %>
                            <img id="product-gallery-main" src="<%= product.primaryImage %>" alt="<%= product.name %>" class="h-[320px] w-full object-contain object-center bg-white p-4 md:h-[520px]">
                        <% } else { %>
                            <div class="flex h-[320px] w-full items-center justify-center text-slate-300 md:h-[520px]">
                                <svg class="h-24 w-24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-4m-8 0H4m8 0v4"></path></svg>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>

            <section>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Sobre o Produto</h2>
                <div class="text-lg text-gray-600 leading-relaxed whitespace-pre-line"><%= product.description %></div>
            </section>
        </div>

        <div class="space-y-6">
            <div class="bg-gray-50 p-6 rounded-xl shadow-inner border border-gray-200">
                <div class="text-center mb-6">
                    <span class="text-sm text-gray-500 block uppercase tracking-wider">Investimento</span>
                    <span class="text-3xl font-bold text-gray-900"><%= product.price || 'Consulte' %></span>
                </div>

                <div class="space-y-4">
                    <a href="/loja/<%= product.slug %>/comprar" class="w-full flex items-center justify-center px-4 py-3 bg-indigo-600 text-white font-bold rounded-lg hover:bg-indigo-700 shadow-lg transform active:scale-95 transition-all">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m1.6 8L5.4 5M7 13l-1.293 6.293A1 1 0 006.683 21h10.634a1 1 0 00.976-1.293L17 13M9 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"></path></svg>
                        Comprar Agora
                    </a>
                    <a href="<%= product.affiliateUrl %>" target="_blank" rel="noreferrer" class="w-full flex items-center justify-center px-4 py-3 border-2 border-indigo-600 text-indigo-600 font-bold rounded-lg hover:bg-indigo-50 transition-colors">
                        Abrir Link da Oferta
                    </a>
                </div>
            </div>

            <section class="bg-indigo-50 p-6 rounded-xl border border-indigo-100">
                <h3 class="text-lg font-bold text-indigo-900 mb-4">Informações</h3>
                <ul class="space-y-3">
                    <li class="flex items-center text-indigo-700">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 1v8m0 0v1m0-1h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <strong>Plataforma:</strong> <span class="ml-2"><%= product.platform %></span>
                    </li>
                    <li class="flex items-center text-indigo-700">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <strong>Oferta:</strong> <span class="ml-2">Link de compra afiliado</span>
                    </li>
                </ul>
            </section>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const mainImage = document.getElementById('product-gallery-main');
    const thumbs = document.querySelectorAll('.js-gallery-thumb');

    thumbs.forEach((thumb) => {
        thumb.addEventListener('click', function () {
            if (!mainImage) return;
            mainImage.src = this.dataset.image || '';

            thumbs.forEach((item) => {
                item.classList.remove('border-indigo-500', 'ring-2', 'ring-indigo-200');
                item.classList.add('border-slate-200');
            });

            this.classList.remove('border-slate-200');
            this.classList.add('border-indigo-500', 'ring-2', 'ring-indigo-200');
        });
    });
});
</script>
