<div class="max-w-7xl mx-auto mt-6 px-4 md:px-6 lg:px-8">
    <div class="rounded-2xl bg-white shadow-2xl overflow-hidden">
        <div class="border-b border-slate-100 px-8 pt-8 pb-6 md:px-12">
            <nav class="mb-6" aria-label="Breadcrumb">
                <ol class="flex flex-wrap items-center gap-2 text-sm">
                    <li><a href="/" class="rounded-full bg-slate-100 px-3 py-1.5 font-medium text-slate-500 transition hover:bg-slate-200 hover:text-slate-700">Início</a></li>
                    <li class="text-slate-300">/</li>
                    <li><a href="/cursos" class="rounded-full bg-indigo-50 px-3 py-1.5 font-semibold text-indigo-700">Cursos</a></li>
                    <li class="text-slate-300">/</li>
                    <li class="max-w-full truncate rounded-full bg-slate-900 px-3 py-1.5 font-semibold text-white"><%= course.title %></li>
                </ol>
            </nav>

            <% if (course.isExpired) { %>
                <div class="mb-4 inline-flex items-center rounded-full bg-red-100 px-4 py-2 text-sm font-bold text-red-700">
                    <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Inscrições encerradas
                </div>
            <% } %>

            <div class="grid gap-10 lg:grid-cols-[1.6fr_0.9fr]">
                <div class="space-y-8">
                    <section>
                        <h1 class="text-3xl font-black leading-tight text-slate-900 md:text-5xl"><%= course.title %></h1>
                    </section>

                    <section>
                        <h2 class="mb-4 text-2xl font-bold text-slate-900">Sobre o Curso</h2>
                        <div class="text-lg leading-relaxed text-slate-600 whitespace-pre-line">
                            <%= course.description %>
                        </div>
                    </section>
                </div>

                <aside class="space-y-6">
                    <div class="overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
                        <div class="flex h-72 items-center justify-center bg-white md:h-80">
                            <%- imgTag(course.image, course.title, 'h-full w-full object-contain object-center p-4 bg-white', 'course') %>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-inner">
                        <div class="mb-6 text-center">
                            <span class="block text-sm uppercase tracking-wider text-slate-500">Investimento</span>
                            <span class="text-3xl font-bold text-slate-900"><%= course.priceDisplay %></span>
                        </div>

                        <div class="space-y-4">
                            <% if (course.proposalDoc) { %>
                                <a href="<%= course.proposalDoc %>" download class="flex w-full items-center justify-center rounded-xl border-2 border-indigo-600 px-4 py-3 font-bold text-indigo-600 transition-colors hover:bg-indigo-50">
                                    <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path></svg>
                                    Baixar Proposta (PDF)
                                </a>
                            <% } %>

                            <% if (course.isExpired) { %>
                                <button disabled class="flex w-full items-center justify-center rounded-xl bg-slate-400 px-4 py-3 text-sm font-bold uppercase text-white cursor-not-allowed">
                                    Inscrições Encerradas
                                </button>
                            <% } else { %>
                                <a href="/inscrever/<%= course.id %>" class="flex w-full items-center justify-center rounded-xl bg-indigo-600 px-4 py-3 font-bold text-white shadow-lg transition-all hover:bg-indigo-700 active:scale-95">
                                    <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    Quero me Inscrever
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 bg-white p-6">
                        <h3 class="mb-3 text-sm font-black uppercase tracking-wider text-slate-700">Incluso</h3>
                        <ul class="space-y-2 text-sm text-slate-600">
                            <% 
                                const includes = (course.itemsIncluded && Array.isArray(course.itemsIncluded) && course.itemsIncluded.length)
                                    ? course.itemsIncluded
                                    : [ 'COPO E CANETA.', 'COFFEE-BREAK.', 'CERTIFICADO DE PARTICIPAÇÃO.' ];
                                includes.forEach(function(item) { %>
                                <li class="flex items-start"><svg class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg><span><%= item %></span></li>
                            <% }) %>
                        </ul>
                    </div>

                    <section class="rounded-2xl border border-indigo-100 bg-indigo-50 p-6">
                        <h3 class="mb-4 text-lg font-bold text-indigo-900">Informações Importantes</h3>
                        <ul class="space-y-3">
                            <li class="flex items-center text-indigo-700">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <strong>Data de Início:</strong> <span class="ml-2"><%= new Date(course.startDate).toLocaleDateString('pt-BR') %></span>
                            </li>
                            <li class="flex items-center text-indigo-700">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                <strong>Local:</strong> <span class="ml-2"><%= course.location %></span>
                            </li>
                            <li class="flex items-center text-indigo-700">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <strong>Carga Horaria:</strong> <span class="ml-2"><%= course.workload %></span>
                            </li>
                            <li class="flex items-center text-indigo-700">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-1a3 3 0 00-5.196-2.079M17 20H7m10 0v-1c0-.653-.126-1.277-.355-1.848M7 20H2v-1a3 3 0 015.196-2.079M7 20v-1c0-.653.126-1.277.355-1.848m0 0a5.002 5.002 0 019.29 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                <strong>Vagas Totais:</strong> <span class="ml-2"><%= course.spots %></span>
                            </li>
                        </ul>
                    </section>
                </aside>
            </div>
        </div>
    </div>
</div>

<% if (showCourseStoreOffers && courseStoreOffers && courseStoreOffers.length) { %>
    <section class="max-w-7xl mx-auto mt-8 px-4 md:px-6 lg:px-8">
        <div class="rounded-2xl bg-white p-8 shadow-xl">
            <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                <div>
                    <h2 class="text-2xl font-black text-slate-900">Ofertas da Loja</h2>
                    <p class="text-sm text-slate-500">Produtos recomendados para complementar este curso.</p>
                </div>
                <a href="/loja" class="text-sm font-bold text-indigo-600 hover:text-indigo-700">Ver loja completa</a>
            </div>

            <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
                <% courseStoreOffers.forEach((product) => { %>
                    <article class="rounded-2xl border border-slate-200 bg-white transition-all hover:-translate-y-1 hover:shadow-lg">
                        <a href="/loja/<%= product.slug %>" class="block">
                            <div class="flex h-44 items-center justify-center border-b border-slate-100 bg-slate-50">
                                <% if (product.primaryImage) { %>
                                    <img src="<%= product.primaryImage %>" alt="<%= product.name %>" class="h-full w-full object-contain object-center p-3">
                                <% } else { %>
                                    <div class="flex h-full w-full items-center justify-center text-slate-300">
                                        <svg class="h-14 w-14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-4m-8 0H4m8 0v4"></path></svg>
                                    </div>
                                <% } %>
                            </div>
                        </a>

                        <div class="space-y-3 p-4">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-indigo-600"><%= product.category || 'Geral' %></p>
                                <h3 class="mt-1 line-clamp-2 text-base font-bold text-slate-900"><%= product.name %></h3>
                                <p class="mt-2 line-clamp-3 text-sm text-slate-500"><%= product.shortDescription %></p>
                            </div>

                            <div class="flex items-center justify-between gap-3">
                                <span class="text-base font-black text-slate-900"><%= product.price || 'Consulte' %></span>
                                <a href="/loja/<%= product.slug %>" class="inline-flex items-center rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-indigo-700">
                                    Ver Produto
                                </a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        </div>
    </section>
<% } %>
