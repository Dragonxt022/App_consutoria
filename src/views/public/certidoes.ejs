<section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(99,102,241,0.35),_transparent_38%),radial-gradient(circle_at_bottom_right,_rgba(14,165,233,0.22),_transparent_30%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-slate-200">
            Documentos da empresa
        </span>
        <h1 class="mt-6 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl">Certid&otilde;es</h1>
        <p class="mt-4 max-w-2xl text-base text-slate-300 sm:text-lg">
            Consulte as certid&otilde;es dispon&iacute;veis da empresa, acompanhe a validade e fa&ccedil;a o download apenas dos arquivos vigentes.
        </p>
    </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <% if (!certificates.length) { %>
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center shadow-sm">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586A2 2 0 0114 3.586L18.414 8A2 2 0 0119 9.414V19a2 2 0 01-2 2z"></path>
                </svg>
            </div>
            <h2 class="mt-5 text-2xl font-bold text-slate-900">Nenhuma certid&atilde;o dispon&iacute;vel</h2>
            <p class="mt-2 text-sm text-slate-500">Assim que novos arquivos forem cadastrados, eles aparecer&atilde;o aqui.</p>
        </div>
    <% } else { %>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            <% certificates.forEach((certificate) => { %>
                <article class="group relative overflow-hidden rounded-3xl border <%= certificate.isExpired ? 'border-rose-200 bg-rose-50/70' : 'border-slate-200 bg-white' %> p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                    <div class="absolute right-0 top-0 h-24 w-24 -translate-y-8 translate-x-8 rounded-full <%= certificate.isExpired ? 'bg-rose-200/40' : 'bg-indigo-100/70' %> blur-2xl"></div>

                    <div class="relative flex items-start justify-between gap-4">
                        <div class="flex h-14 w-14 items-center justify-center rounded-2xl <%= certificate.isExpired ? 'bg-rose-100 text-rose-600' : 'bg-indigo-100 text-indigo-600' %>">
                            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7V3m10 4V3m-9 8h8m-9 4h10m2 4H7a2 2 0 01-2-2V7a2 2 0 012-2h1m8 0h1a2 2 0 012 2v12a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <% if (certificate.isExpired) { %>
                            <span class="inline-flex rounded-full border border-rose-200 bg-rose-100 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-rose-700">Vencida</span>
                        <% } else if (certificate.hasExpiration) { %>
                            <span class="inline-flex rounded-full border border-amber-200 bg-amber-100 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-amber-700">Validade ativa</span>
                        <% } else { %>
                            <span class="inline-flex rounded-full border border-emerald-200 bg-emerald-100 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-700">Vitalicia</span>
                        <% } %>
                    </div>

                    <div class="relative mt-6">
                        <h2 class="text-xl font-black tracking-tight text-slate-900"><%= certificate.name %></h2>
                        <div class="mt-4 rounded-2xl <%= certificate.isExpired ? 'bg-white/80' : 'bg-slate-50' %> p-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Data de expira&ccedil;&atilde;o</p>
                            <p class="mt-2 text-lg font-bold <%= certificate.isExpired ? 'text-rose-700' : 'text-slate-900' %>"><%= certificate.expirationLabel %></p>
                        </div>
                    </div>

                    <div class="relative mt-6">
                        <% if (certificate.isExpired) { %>
                            <span class="inline-flex w-full cursor-not-allowed items-center justify-center gap-3 rounded-2xl bg-rose-600 px-5 py-3 text-sm font-semibold text-white opacity-70">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 .552-.448 1-1 1s-1-.448-1-1 .448-1 1-1 1 .448 1 1zm0 0V7m0 13h.01M4.93 4.93l14.14 14.14"></path>
                                </svg>
                                Download indispon&iacute;vel
                            </span>
                        <% } else { %>
                            <a href="<%= certificate.fileUrl %>" download class="inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-600">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v10m0 0l-4-4m4 4l4-4m4 8H4"></path>
                                </svg>
                                Baixar certid&atilde;o
                            </a>
                        <% } %>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>
