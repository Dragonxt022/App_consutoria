<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificado - <%= enrollment.studentName %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --a4-width: 297mm;
            --a4-height: 210mm;
        }

        body {
            background: #cbd5e1;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 16px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .certificate-front-page {
            width: var(--a4-width);
            height: var(--a4-height);
            margin: 0 auto;
            border: 1px solid rgba(148, 163, 184, 0.45);
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.18);
            background: white;
            overflow: hidden;
        }

        .certificate-front-surface {
            position: relative;
            width: 100%;
            height: 100%;
            background-color: white;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .certificate-element {
            position: absolute;
        }

        .certificate-text {
            white-space: pre-wrap;
            line-height: 1.55;
        }

        .certificate-image {
            object-fit: contain;
            height: auto;
        }

        .certificate-signature-block {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        .certificate-signature-image {
            display: block;
            width: 100%;
            max-height: 72px;
            object-fit: contain;
        }

        .certificate-signature-line {
            width: 100%;
            border-top: 2px solid currentColor;
        }

        .certificate-signature-name {
            width: 100%;
            line-height: 1.35;
        }

        .print-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #111827;
            color: white;
            border: none;
            padding: 15px 24px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.25);
            z-index: 1000;
        }

        @page {
            size: A4 landscape;
            margin: 0;
        }

        @media print {
            html, body {
                width: var(--a4-width) !important;
                height: var(--a4-height) !important;
                background: white !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .certificate-front-page {
                width: var(--a4-width) !important;
                height: var(--a4-height) !important;
                margin: 0 !important;
                border: none !important;
                box-shadow: none !important;
            }

            .print-btn {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <button class="print-btn" onclick="window.print()">Imprimir / Salvar PDF</button>
    <a class="print-btn" href="/certificado/<%= code %>/verso" style="right: 220px; background:#0f766e;">Ver Verso</a>
    <a class="print-btn" href="/certificado/<%= code %>/duplex" style="right: 390px; background:#334155;">Frente + Verso</a>

    <%- include('_front-certificate', { builderConfig, renderElements }) %>
</body>
</html>
